#!/usr/bin/env zsh
# oc-continue: scheduling and event-driven continuation for headless opencode
# runs that hit provider quota windows. The old zshrc delay_opencode function
# was folded into this CLI. Pure shell, no models.
# State: ~/.local/share/opencode/oc-continue/.
#
# Usage:
#   oc-continue run [-n N] [--follow] [ocflags] [prompt...]
#                                        N = productive-cycle cap; without
#                                        it the ride is unbounded. Cycle 1
#                                        sends the prompt (the caller's
#                                        words, or a truthful default),
#                                        later cycles a short resumption
#                                        note, and every prompt asks the
#                                        session to end its final message
#                                        with the terminal line
#                                        OC-CONTINUE: COMPLETE once nothing
#                                        remains. The ride stops on that
#                                        marker, a clean exit, a non-quota
#                                        failure, or (with -n) the Nth
#                                        productive cycle; three consecutive
#                                        no-progress attempts always quit
#                                        with a limit-never-reset report.
#                                        Detaches immediately: parks and
#                                        sessions happen in the background.
#                                        --follow: stay in the foreground and
#                                        tail the live output after
#                                        detaching; Ctrl-C stops the
#                                        follower, the engine keeps running.
#   oc-continue at HH:MM [ocflags] [prompt...]     Run once at a wall-clock
#                                        time (rolls to tomorrow if past).
#                                        Detaches immediately: the countdown
#                                        and run happen in the background.
#   oc-continue in DURATION [ocflags] [prompt...]  Run once after DURATION
#                                        (e.g. 90, 5m, 2h, 1d). One-shot: a
#                                        rate-limit hit just fails; `run`
#                                        rides windows. Detaches immediately.
#   oc-continue stop                     Kill a running engine and its child.
#   oc-continue status                   Running pid, productive cycles spent,
#                                        tail, and which per-session outputs
#                                        are retained.
#   oc-continue clean                    Remove state (log, live and retained
#                                        output, stale pid); refuses while
#                                        running.
#   oc-continue follow                   tail -F the live run output; survives
#                                        quota parks, and shows the last
#                                        session's output once idle.
#
# Every launching command returns at once; watch with `oc-continue follow`,
# check with `status`, cancel with `stop`. For a foreground run right now,
# call `opencode run --continue --auto` directly.
#
# Retention: each invocation's complete output is kept at
# $STATE_DIR/last.N.out (N = the invocation's number across the run;
# every opencode run invocation gets its own file, no-progress retries
# included); last.out stays the live current-session file that `follow`
# tails, truncated at each session boundary, never merged across sessions.
#
# Flag contract: oc-continue declares its own flags in the OC_RUN_* tables
# (-n, --follow); they are parsed and consumed anywhere in the leading flag
# zone and never forwarded to opencode. The declared table governs `run`
# only: `at` and `in` declare none, so --follow there forwards verbatim
# today. Every other dash-prefixed arg before the prompt passes through to
# `opencode run` verbatim, so `oc-continue run --session ID --dir PATH -m
# provider/model fix it` works. Known value-taking flags consume their
# value token; others can use --flag=value. A bare `--` forces everything
# after it to be prompt. No prompt given: the resume-the-interrupted-turn
# default is used. Naming discipline: never adopt a declared name from
# `opencode run`'s documented flag set; on overlap oc-continue wins and
# the flag never reaches opencode.
#
# Examples:
#   oc-continue run                          continue this directory's last
#                                            session in the background, ride
#                                            until it reports completion
#   oc-continue run -n 4                     background, capped at 4
#                                            productive cycles
#   oc-continue run -n 3 --follow "ship it"  background, tailing live output
#                                            in this terminal until Ctrl-C
#   oc-continue run -m zhipu/glm-5.3 fix tui continue, model override passed
#                                            through to opencode
#   oc-continue at 22:30                     one-shot tonight at 22:30
#   oc-continue in 45m "run the test suite"  one-shot after a 45m pause
#   oc-continue follow                       tail live output from anywhere
#   oc-continue status | stop | clean        inspect, cancel, wipe state
#
# Environment overrides:
#   OC_BIN            opencode binary (default: opencode; tests use a fake)
#   OC_WAIT_UNTIL     HH:MM known window-reset time; overrides the default
#                     observed-hit + 4h52m park
#   OC_WAIT_SECONDS   fixed park length (testing; bypasses window math)
#   OC_MIN_PROGRESS_SECONDS  progress wall-time floor in seconds
#                     (default 20; testing): a quota fail whose output
#                     holds nothing beyond the error still counts as
#                     productive once it outlasts this many seconds
#   OC_STATE_DIR      state directory override (testing)

set -u
# The per-session tee (last.out plus last.N.out) rides multios; an
# inherited NO_MULTIOS would truncate last.out and never write it.
setopt multios

STATE_DIR="${OC_STATE_DIR:-$HOME/.local/share/opencode/oc-continue}"
LOG_FILE="$STATE_DIR/engine.log"
PID_FILE="$STATE_DIR/run.pid"
OUT_FILE="$STATE_DIR/last.out"
# Top level on purpose: inside a zsh function $0 is the function's name,
# not this script's path.
SCRIPT_PATH="$0"
OC_BIN="${OC_BIN:-opencode}"
SECONDS_PER_DAY=86400
PARK_SECONDS=17520   # 4h52m: observed-hit plus safety, under the 5h window
TAIL_LINES=40
READY_POLLS=20       # x READY_POLL_INTERVAL: how long launch waits for the
READY_POLL_INTERVAL=0.1   # engine's pid file before reporting failure
# Progress-fallback floor: governs only quota-hit sessions whose entire
# output matched the exclusions, so no content line survived; such a
# session still counts as productive once it outlasted this many seconds.
MIN_PROGRESS_SECONDS="${OC_MIN_PROGRESS_SECONDS:-20}"
# Consecutive no-progress quota fails tolerated before the engine
# concludes the limit never reset and quits; a productive session or a
# clean completion resets the count.
NO_PROGRESS_LIMIT=3
# Anchored the way the A/B driver pins it: a bare 429 inside a number or a
# timestamp must not read as a quota event.
QUOTA_REGEX='(^|[^0-9])429([^0-9]|$)|quota|rate.?limit|usage.?limit|credits? (exhausted|exceeded)|exceeded your'
# The run banner shape, excluded from progress classification: opens with
# "> " and carries the · separator. Both markers required, so an
# assistant-quoted blockquote without the separator survives as content.
BANNER_REGEX='^> .*·'
ANSI_ESC=$'\e'
# The terminal line a ride session must end its final message with once
# nothing remains; the engine stops the ride when this is the last
# non-empty line of a session's output.
COMPLETE_MARKER='OC-CONTINUE: COMPLETE'
# The one-line completion instruction appended to a caller prompt (cycle 1
# only, skipped when the prompt already carries the marker) and built into
# the default and resumption prompts.
MARKER_INSTRUCTION='When nothing remains, do a terse final verification (no new work) and end your final message with the single terminal line: OC-CONTINUE: COMPLETE'
# The no-prompt default, sent verbatim as the cycle-1 ride default and by
# the one-shot at/in commands: truthful about the interruption, no
# re-orientation from scratch, no redoing of finished steps.
DEFAULT_PROMPT='Your last turn was cut off by a provider rate limit, not by finished work. Resume the interrupted turn: check the todo list and the current state of the files on disk, then finish the remaining work without redoing completed steps. Do not claim the quota is fresh beyond that.'
# Cycles 2 and up never re-send the original prompt, only this note (plus
# the marker instruction).
RESUME_NOTE='The quota window reset mid-work; resume from where your last turn stopped, do not re-orient from scratch, and do not repeat finished steps.'
RESUME_PROMPT="$RESUME_NOTE $MARKER_INSTRUCTION"
# opencode run flags that consume a separate value token, for passthrough;
# bare flags and --flag=value forms need no entry here.
OC_VALUE_FLAGS=(--log-level --command --title --format --attach --password --username --dir --port --variant --model --agent --session --file -s -m -f -p -u)
# oc-continue's declared flag table: names split_run_args parses and
# consumes itself, never forwarding them to opencode. On a name overlap
# with opencode run's documented flags oc-continue wins, so never adopt a
# declared name from that set; tests/oc-continue/test-oc-continue.sh pins
# both tables against live `opencode run --help`.
OC_RUN_VALUE_FLAGS=(-n)
OC_RUN_BOOL_FLAGS=(--follow)
oc_declared=false
run_follow=false

log_line() {
    mkdir -p "$STATE_DIR"
    printf '%s %s\n' "$(date -Iseconds)" "$*" >> "$LOG_FILE"
}

running_pid() {
    [[ -f "$PID_FILE" ]] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    print -r -- "$pid"
}

epoch_of() { date -d "$1" +%s 2>/dev/null || return 1 }

park_seconds() {
    if [[ -n "${OC_WAIT_SECONDS:-}" ]]; then
        print -r -- "$OC_WAIT_SECONDS"
        return 0
    fi
    if [[ -n "${OC_WAIT_UNTIL:-}" ]]; then
        local target now
        target=$(epoch_of "$OC_WAIT_UNTIL") || return 1
        now=$(date +%s)
        if (( target > now )); then
            print -r -- $(( target - now ))
        else
            print -r -- 60
        fi
        return 0
    fi
    print -r -- "$PARK_SECONDS"
}

looks_like_quota() {
    tail -n "$TAIL_LINES" "$1" 2>/dev/null | command grep -qiE "$QUOTA_REGEX"
}

# Classify a quota-hit session as productive or no-progress, from its
# retained last.N.out ($1) and its elapsed seconds ($2). ANSI escape
# sequences are stripped before every exclusion: they carry no content,
# so an escape-only line must not read as progress. Primary signal: one
# surviving line with non-whitespace content after the quota-filter and
# banner exclusions. Fallback: elapsed wall time at or over
# MIN_PROGRESS_SECONDS, reached only when the entire output matched the
# exclusions.
made_progress() {
    local session_out="$1" elapsed="$2"
    if sed "s/${ANSI_ESC}\[[0-9;:?]*[A-Za-z]//g" "$session_out" 2>/dev/null \
        | command grep -ivE "${QUOTA_REGEX}|${BANNER_REGEX}" \
        | command grep -qE '[^[:space:]]'; then
        return 0
    fi
    (( elapsed >= MIN_PROGRESS_SECONDS ))
}

# The cycle-1 prompt of a ride: the caller's words verbatim when given,
# plus the marker instruction unless the prompt already carries the
# marker; otherwise the truthful default. It is re-sent after every
# no-progress attempt, which spends no cycle, and cycles 2 and up never
# re-send any of this, only the resumption prompt.
cycle_one_prompt() {
    local caller="${1:-}"
    if [[ -z "$caller" ]]; then
        print -r -- "$DEFAULT_PROMPT
$MARKER_INSTRUCTION"
    elif [[ "$caller" == *"$COMPLETE_MARKER"* ]]; then
        print -r -- "$caller"
    else
        print -r -- "$caller
$MARKER_INSTRUCTION"
    fi
}

# True when the session's output ends with the exact completion marker:
# the last non-empty line, ANSI-stripped and edge-whitespace-trimmed,
# equals COMPLETE_MARKER. A marker mention mid-output does not match.
session_completed() {
    local session_out="$1" last
    last="$(sed "s/${ANSI_ESC}\[[0-9;:?]*[A-Za-z]//g" "$session_out" 2>/dev/null \
        | command grep -E '[^[:space:]]' | tail -n 1)"
    last="${last#"${last%%[^[:space:]]*}"}"
    last="${last%"${last##*[^[:space:]]}"}"
    [[ "$last" == "$COMPLETE_MARKER" ]]
}

# Split a launching command's args into opencode flags (with their value
# tokens) and the prompt words that follow. Declared flags (OC_RUN_*_FLAGS,
# gated by oc_declared so only `run` consumes them) are stripped into
# oc_declared_args with their value pairings and never forwarded. A bare
# `--` forces everything after it to be prompt, so dash-leading prompts
# stay passable.
split_run_args() {
    oc_flags=()
    prompt_words=()
    oc_declared_args=()
    while (( $# )); do
        case "$1" in
            --)
                shift
                prompt_words+=("$@")
                return 0
                ;;
            -*)
                if [[ "$oc_declared" == true ]] && (( ${OC_RUN_VALUE_FLAGS[(Ie)$1]} )); then
                    if [[ -n "${2:-}" && "${2:-}" != -* ]]; then
                        oc_declared_args+=("$1" "$2")
                        shift 2
                    else
                        printf 'oc-continue: %s needs a value\n' "$1" >&2
                        return 2
                    fi
                elif [[ "$oc_declared" == true ]] && (( ${OC_RUN_BOOL_FLAGS[(Ie)$1]} )); then
                    oc_declared_args+=("$1")
                    shift
                elif (( $# == 1 )) && (( ${OC_VALUE_FLAGS[(Ie)$1]} )); then
                    printf 'oc-continue: %s needs a value\n' "$1" >&2
                    return 2
                else
                    oc_flags+=("$1")
                    if [[ -n "${2:-}" && "${2:-}" != -* ]] && \
                       (( ${OC_VALUE_FLAGS[(Ie)$1]} )); then
                        shift
                        oc_flags+=("$1")
                    fi
                    shift
                fi
                ;;
            *)
                prompt_words+=("$@")
                return 0
                ;;
        esac
    done
}

# Give the declared flags split_run_args consumed their meaning: -n caps
# productive cycles (left unset the ride is unbounded, until the
# completion marker or another stop condition), --follow requests
# launch-plus-tail. The single place a declared name gains semantics; a
# new declared flag needs its OC_RUN_* table entry and its case here.
interpret_run_flags() {
    run_sessions=""
    run_follow=false
    local i
    for (( i=1; i <= ${#oc_declared_args}; i++ )); do
        case "${oc_declared_args[i]}" in
            -n)
                [[ "${oc_declared_args[i+1]}" =~ ^[0-9]+$ ]] || \
                    { printf 'oc-continue: -n needs a number\n' >&2; return 2; }
                run_sessions="${oc_declared_args[i+1]}"
                (( i += 1 ))
                ;;
            --follow)
                run_follow=true
                ;;
        esac
    done
    return 0
}

start_engine() {
    local existing
    if existing=$(running_pid); then
        printf 'oc-continue: already running (pid %s); oc-continue stop first\n' "$existing" >&2
        return 1
    fi
    mkdir -p "$STATE_DIR"
    # Drop the previous run's retained sessions so status never presents a
    # longer old run's tail as current; `clean` stays the explicit wipe.
    rm -f "$STATE_DIR"/last.<->.out(N)
    print -r -- $$ > "$PID_FILE"
}

cmd_run() {
    oc_declared=true
    split_run_args "$@" || return 2
    interpret_run_flags || return 2
    # Empty means unbounded: the ride runs until the completion marker, a
    # clean exit, a non-quota failure, or the never-reset bound.
    local sessions="$run_sessions"
    local caller_prompt="${prompt_words[*]:-}"

    start_engine || return 1

    # cycles counts productive quota hits against the cap when one is set;
    # no_progress counts consecutive no-progress quota fails against
    # NO_PROGRESS_LIMIT and resets on any productive session.
    local session=1 cycles=0 no_progress=0
    if [[ -n "$sessions" ]]; then
        log_line "run start (pid $$): budget $sessions productive cycle(s), oc=${OC_BIN} ${oc_flags[*]}"
        printf 'oc-continue: starting; budget %s productive cycle(s)\n' "$sessions"
    else
        log_line "run start (pid $$): unbounded, until $COMPLETE_MARKER, oc=${OC_BIN} ${oc_flags[*]}"
        printf 'oc-continue: starting; unbounded, until %s\n' "$COMPLETE_MARKER"
    fi

    local rc is_quota wait_s session_out start_s elapsed prompt
    while :; do
        session_out="$STATE_DIR/last.$session.out"
        # Cycles count productive hits: until the first one lands, each
        # invocation re-sends the cycle-1 prompt, because a no-progress
        # attempt means the model may never have consumed those words.
        if (( cycles == 0 )); then
            prompt=$(cycle_one_prompt "$caller_prompt")
        else
            prompt="$RESUME_PROMPT"
        fi
        : > "$OUT_FILE" || { log_line 'truncate failed'; return 1; }
        printf 'oc-continue: %s run --continue --auto %s %s\n' "$OC_BIN" "${oc_flags[*]}" "$prompt"
        start_s=$SECONDS
        "$OC_BIN" run --continue --auto ${oc_flags[@]+"${oc_flags[@]}"} "$prompt" > "$OUT_FILE" > "$session_out" 2>&1
        rc=$?
        elapsed=$(( SECONDS - start_s ))
        is_quota=false
        (( rc == 0 )) || if looks_like_quota "$OUT_FILE"; then is_quota=true; fi

        if session_completed "$session_out"; then
            log_line "session $session: work complete ($COMPLETE_MARKER, rc=$rc)"
            printf 'oc-continue: work complete (%s)\n' "$COMPLETE_MARKER"
            return 0
        fi

        if (( rc == 0 )); then
            log_line "session $session: run completed cleanly"
            printf 'oc-continue: completed cleanly (session %s)\n' "$session"
            return 0
        fi

        if [[ "$is_quota" != true ]]; then
            log_line "session $session: non-quota failure rc=$rc; not retrying"
            printf 'oc-continue: non-quota failure (rc %s); output: %s, events: %s\n' "$rc" "$OUT_FILE" "$LOG_FILE"
            return "$rc"
        fi

        if ! made_progress "$session_out" "$elapsed"; then
            no_progress=$(( no_progress + 1 ))
            if (( no_progress >= NO_PROGRESS_LIMIT )); then
                log_line "session $session: no-progress quota hit $no_progress consecutive; limit never reset, quitting"
                printf 'oc-continue: limit never reset (%s consecutive no-progress attempts); quitting; output: %s, events: %s\n' \
                    "$no_progress" "$OUT_FILE" "$LOG_FILE"
                return 0
            fi
            wait_s=$(park_seconds) || { printf 'oc-continue: bad OC_WAIT_UNTIL\n' >&2; return 2; }
            session=$(( session + 1 ))
            log_line "session $(( session - 1 )): no-progress quota hit $no_progress of $NO_PROGRESS_LIMIT consecutive; no budget consumed; re-parking ${wait_s}s until session $session"
            printf 'oc-continue: quota window still up (no-progress attempt %s of %s); re-parked %ss, then session %s (oc-continue stop to cancel)\n' \
                "$no_progress" "$NO_PROGRESS_LIMIT" "$wait_s" "$session"
            sleep "$wait_s" || { log_line 'park interrupted'; return 1; }
            continue
        fi

        no_progress=0
        cycles=$(( cycles + 1 ))
        if [[ -n "$sessions" ]] && (( cycles >= sessions )); then
            log_line "session $session: productive quota hit $cycles of budget $sessions; budget spent, quitting"
            printf 'oc-continue: budget spent (%s productive cycle(s)); quitting after hit %s\n' "$sessions" "$cycles"
            return 0
        fi

        wait_s=$(park_seconds) || { printf 'oc-continue: bad OC_WAIT_UNTIL\n' >&2; return 2; }
        session=$(( session + 1 ))
        if [[ -n "$sessions" ]]; then
            log_line "session $(( session - 1 )): productive quota hit $cycles of budget $sessions; parking ${wait_s}s until session $session"
            printf 'oc-continue: rate limit hit after progress (cycle %s of %s); parked %ss, then session %s (oc-continue stop to cancel)\n' \
                "$cycles" "$sessions" "$wait_s" "$session"
        else
            log_line "session $(( session - 1 )): productive quota hit $cycles; unbounded ride continues; parking ${wait_s}s until session $session"
            printf 'oc-continue: rate limit hit after progress (cycle %s); parked %ss, then session %s (oc-continue stop to cancel)\n' \
                "$cycles" "$wait_s" "$session"
        fi
        sleep "$wait_s" || { log_line 'park interrupted'; return 1; }
    done
}

cmd_once() {
    local sleep_for="$1"; shift
    oc_declared=false
    split_run_args "$@" || return 2
    local prompt="${prompt_words[*]:-$DEFAULT_PROMPT}"

    start_engine || return 1

    log_line "one-shot start (pid $$): oc=${OC_BIN} ${oc_flags[*]} after ${sleep_for}"
    printf 'oc-continue: runs in %s (oc-continue stop to cancel)\n' "$sleep_for"
    sleep "$sleep_for" || { log_line 'wait interrupted'; return 1; }

    : > "$OUT_FILE" || { log_line 'truncate failed'; return 1; }
    printf 'oc-continue: %s run --continue --auto %s %s\n' "$OC_BIN" "${oc_flags[*]}" "$prompt"
    "$OC_BIN" run --continue --auto ${oc_flags[@]+"${oc_flags[@]}"} "$prompt" > "$OUT_FILE" > "$STATE_DIR/last.1.out" 2>&1
    local rc=$?
    if (( rc == 0 )); then
        log_line 'one-shot: run completed cleanly'
        printf 'oc-continue: completed cleanly\n'
        return 0
    fi
    if looks_like_quota "$OUT_FILE"; then
        log_line "one-shot: quota hit (rc $rc); not retrying"
        printf 'oc-continue: rate limit hit; one-shot, not retrying (run rides windows); output: %s\n' "$OUT_FILE"
    else
        log_line "one-shot: non-quota failure rc=$rc"
        printf 'oc-continue: non-quota failure (rc %s); output: %s, events: %s\n' "$rc" "$OUT_FILE" "$LOG_FILE"
    fi
    return "$rc"
}

cmd_at() {
    [[ -n "${1:-}" ]] || { printf 'oc-continue: at needs HH:MM\n' >&2; return 2; }
    local schedule="$1"; shift
    local target now
    target=$(epoch_of "$schedule") || { printf 'oc-continue: bad time %s\n' "$schedule" >&2; return 2; }
    now=$(date +%s)
    (( target > now )) || target=$(( target + SECONDS_PER_DAY ))
    cmd_once "$(( target - now ))" "$@"
}

cmd_in() {
    [[ "${1:-}" =~ ^[0-9]+([smhd])?$ ]] || { printf 'oc-continue: in needs DURATION (e.g. 90, 5m, 2h, 1d)\n' >&2; return 2; }
    local duration="$1"; shift
    cmd_once "$duration" "$@"
}

cmd_stop() {
    local pid
    if ! pid=$(running_pid); then
        printf 'oc-continue: not running\n'
        rm -f "$PID_FILE" 2>/dev/null
        return 0
    fi
    command pkill -P "$pid" 2>/dev/null
    kill "$pid" 2>/dev/null
    rm -f "$PID_FILE"
    log_line "stopped by user (pid $pid)"
    printf 'oc-continue: stopped (pid %s)\n' "$pid"
    return 0
}

cmd_status() {
    local pid retained name names
    retained=("$STATE_DIR"/last.<->.out(N))
    if ! pid=$(running_pid); then
        printf 'oc-continue: not running\n'
        [[ -f "$LOG_FILE" ]] && tail -n 3 "$LOG_FILE"
    else
        printf 'oc-continue: running (pid %s)\n' "$pid"
        [[ -f "$LOG_FILE" ]] && tail -n 5 "$LOG_FILE"
    fi
    if (( ${#retained} )); then
        names=''
        for name in "${retained[@]}"; do
            names="${names:+$names }${name:t}"
        done
        printf 'oc-continue: retained session output: %s\n' "$names"
    fi
    return 0
}

cmd_follow() {
    mkdir -p "$STATE_DIR"
    [[ -f "$OUT_FILE" ]] || : > "$OUT_FILE"
    exec tail -n "$TAIL_LINES" -F "$OUT_FILE"
}

cmd_clean() {
    local pid
    if pid=$(running_pid); then
        printf 'oc-continue: running (pid %s); oc-continue stop first\n' "$pid" >&2
        return 1
    fi
    rm -rf "$STATE_DIR"
    printf 'oc-continue: cleaned %s\n' "$STATE_DIR"
    return 0
}

# Preflight the user-facing errors in the caller's terminal: the detached
# child's stderr goes to /dev/null, so anything the caller got wrong must be
# reported here, before forking. For `run` this also computes run_follow so
# the launcher knows whether to tail after spawning.
validate_launch() {
    local sub="$1"; shift
    case "$sub" in
        run)
            oc_declared=true
            ;;
        at)
            oc_declared=false
            [[ -n "${1:-}" ]] || { printf 'oc-continue: at needs HH:MM\n' >&2; return 2; }
            epoch_of "$1" >/dev/null || { printf 'oc-continue: bad time %s\n' "$1" >&2; return 2; }
            shift
            ;;
        in)
            oc_declared=false
            [[ "${1:-}" =~ ^[0-9]+([smhd])?$ ]] || { printf 'oc-continue: in needs DURATION (e.g. 90, 5m, 2h, 1d)\n' >&2; return 2; }
            shift
            ;;
    esac
    split_run_args "$@" || return 2
    [[ "$sub" != run ]] || interpret_run_flags || return 2
}

launch() {
    validate_launch "$@" || return 2
    local sub="$1"; shift
    local existing
    if existing=$(running_pid); then
        printf 'oc-continue: already running (pid %s); oc-continue stop first\n' "$existing" >&2
        return 1
    fi
    if command -v setsid >/dev/null 2>&1; then
        OC_DETACHED=1 setsid nohup "$SCRIPT_PATH" "$sub" "$@" </dev/null >/dev/null 2>&1 &
    else
        OC_DETACHED=1 nohup "$SCRIPT_PATH" "$sub" "$@" </dev/null >/dev/null 2>&1 &
    fi
    # Report readiness, not just spawn: setsid may fork, so $! is not
    # reliably the engine pid. Wait for the engine to arm its pid file and
    # print that; a child that dies before arming surfaces as a failure.
    local polls=0
    while (( polls < READY_POLLS )); do
        [[ -f "$PID_FILE" ]] && break
        sleep "$READY_POLL_INTERVAL"
        polls=$(( polls + 1 ))
    done
    if [[ -f "$PID_FILE" ]]; then
        if [[ "$run_follow" == true ]]; then
            printf 'oc-continue: %s detached (pid %s); following live output, Ctrl-C stops following only (oc-continue stop cancels)\n' \
                "$sub" "$(cat "$PID_FILE" 2>/dev/null)"
            cmd_follow
        fi
        printf 'oc-continue: %s detached (pid %s; oc-continue follow to watch, oc-continue stop to cancel)\n' \
            "$sub" "$(cat "$PID_FILE" 2>/dev/null)"
    else
        printf 'oc-continue: %s failed to start (engine never armed; waited %.1fs)\n' \
            "$sub" $(( READY_POLLS * READY_POLL_INTERVAL )) >&2
        return 1
    fi
    exit 0
}

# Armed only in the engine child, at true top level: zsh runs function-set
# EXIT traps at function return and restores trap resets on function return,
# either of which would delete the pid file while the engine lives. The
# parent launcher arms no traps at all, so it can never disturb the engine's.
if [[ -n "${OC_DETACHED:-}" ]]; then
    trap 'rm -f "$PID_FILE"' EXIT INT TERM
fi

case "${1:-}" in
    run|at|in)
            sub="$1"; shift
            if [[ -n "${OC_DETACHED:-}" ]]; then
                case "$sub" in
                    run) cmd_run "$@" ;;
                    at)  cmd_at "$@" ;;
                    in)  cmd_in "$@" ;;
                esac
            else
                launch "$sub" "$@"
            fi ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    clean)  cmd_clean ;;
    follow) cmd_follow ;;
    *) printf 'Usage: oc-continue run [-n N] [--follow] [prompt...] | at HH:MM [prompt...] | in DURATION [prompt...]\n       oc-continue stop | status | clean | follow\n' >&2; exit 2 ;;
esac
