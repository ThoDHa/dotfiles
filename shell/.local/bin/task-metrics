#!/usr/bin/env python3
"""task-metrics: extract coding-agent runtime telemetry into the metrics ledger.

Combined extractor tool (ORCH-4-3-2 pi, ORCH-4-3-3 oc; integration in
ORCH-4-3-4), deliberately outside the tasks CLI single file (the DC2
concentration lesson). Modes:

  task-metrics oc [options]
      Extract opencode.db assistant messages into invocation ledger
      records against schema 1.0 (tests/task-metrics/ledger-schema.md);
      invocations already present in the --out target are skipped, so
      re-running an overlapping scope never appends a duplicate record.
  task-metrics pi [options]
      Extract invocation records from a pi session store (session JSONL,
      subagent toolResult details, pi-continue engine.log) into the same
      ledger contract.
  task-metrics rollup [options]
      Aggregate invocation ledger records into unit_rollup and
      batch_rollup records (schema 1.0): per-unit and per-batch sums,
      stop-reason histograms, soft-budget flags routed as
      over-budget(<dimension>) (investigate or escalate, never
      terminate), optional verification-yield tally embedding,
      incremental-extraction cursor files, and self-reported runtime.
  task-metrics ac12 [options]
      Emit an ac12_snapshot record (schema 1.0) from an AC-12 probe
      results file carrying the five metric families.

Extraction is read-only against the live store: records append to
--output/--out (default stdout) as JSONL in extraction order. Malformed
store rows warn on stderr and are skipped, never silently dropped; the
stderr summary names the counts. Exit ladder per mode: 0 records
written, 1 extraction or aggregation produced nothing (an empty ledger
is contract-invalid), 2 usage or IO error.

oc mode derivation contract:

- One invocation record per assistant message of an in-scope parent
  session, in (time_created, id) order. Child-session messages never
  emit their own records; they aggregate per child session into the
  parent session's first invocation record's nested.children (one child
  entry per child session, whose agent field carries the child session's
  id), so rollup sums count each child leg exactly once. Session context
  loads from both durable tables, legacy `session` and `session_v2`
  (session_v2 wins on an id collision), because live messages reference
  ids in either; a session whose parent_id names a session that does not
  exist is extracted as a standalone parent instead of being dropped,
  and a message whose session row exists in neither table extracts the
  same way. Chains deeper than one level flatten the same way: a session
  whose parent itself folds into a parent record emits its own records,
  so nothing in scope is ever silently left out and no tokens double
  count.
- timestamp is message.time_created (epoch ms) rendered RFC3339 UTC;
  duration_ms is time_updated minus time_created, null when the delta
  is negative rather than a fabricated value.
- stop_reason is the last step-finish part's reason by part time; a
  message with no step-finish part, or a last part with no usable
  reason, carries "unknown", the harness's own spelling for an unknown
  end. A message without a usable modelID or providerID cannot produce
  a contract-valid record and is skipped with a warning rather than
  emitted invalid. --since/--until scope messages only: a message's
  step-finish parts ride with their message, so a part timestamped past
  a boundary still supplies its message's stop reason.
- tokens come from message.data.tokens: camelCase cache.read and
  cache.write map to cache_read and cache_write, absent counts become 0,
  absent or non-integer reasoning becomes null.
- cost carries the harness's value verbatim with source marking: a
  nonzero nonnegative numeric cost is source reported; a zero is the
  adapter's reported zero carried verbatim under source none
  (opencode's zai-coding-plan adapter reports 0 on every message); an
  absent or unusable cost is null under source none. Nothing is ever
  fabricated into a price.
- retry marks one invocation-repeat on a message whose stop_reason is
  "unknown" and that a later assistant message in the same session
  follows; an unknown stop with no later invocation is an end, not a
  retry, and stays count 0. Retries are derived signals, never invented
  from silence.
- restart joins oc-continue engine.log park cycles by time window: each
  "parking ... until session" line opens a window at its timestamp that
  closes at the next "invoking opencode run" line, or at the next park
  line, whichever comes first; only invoke-closed windows mark. The
  first invocation inside a window carries restart with engine_log set
  to the verbatim park line and of_session_id set to the session of the
  last in-scope invocation at or before the park, null when none exists
  (either field may stand alone per the contract).
- attribution: with --cwd and --unit, a matching message cwd is method
  cwd-match, confidence exact, unit_id set; every other record is method
  none, confidence unattributed, unit_id null. batch_id rides on every
  record when --batch is given, unattributed records included (the
  populated-batch reading sanctioned at the ORCH-4-3-1 gate).
  task-file-reference and dispatch-window attribution belong to later
  slices.

pi mode sources:

  - session root: --session-dir, else $PI_CODING_AGENT_SESSION_DIR,
    else ~/.pi/agent/sessions; *.jsonl files are read recursively in
    filename order (pi names them <UTC-timestamp>_<session-id>.jsonl).
  - per assistant message entry: tokens and cost from usage (error and
    aborted rows persist the all-zero usage block with no reasoning
    field, extracted as zeroed tokens, null reasoning, cost source
    none), stop_reason verbatim, duration_ms from the row's native
    durationMs, retries from the error stop reason and from a repeat
    invocation directly following an error row, nested subagent legs
    from the subagent toolResult joined by its toolCallId to the
    assistant toolCall block that spawned it (pi chains a parallel
    fan-out's toolResults positionally, so parentId is only a fallback
    for toolResults whose toolCallId is absent or unresolved); a
    result group resolving under neither key warns and is counted in
    the summary, never silently dropped.
  - restarts from pi-continue engine.log park/restart cycles: the first
    record at or after the restart invocation carries the prior
    session's id and the park line verbatim; an interrupted park (park
    interrupted, wait interrupted, stopped by user) and a fresh run
    start clear the pending park so a stale park never completes
    against a later run's invocation.
  - attribution: cwd-match when the session cwd sits in a unit
    worktree (.worktrees/<slug>, slug normalized to the task id),
    else task-file-reference from the first task-id token in the
    session's prose up to and including the record, else unattributed.
    --batch-id stamps every record's batch_id, populated even on
    unattributed records (the canonical populated-batch form).

Message role and part type are filtered while parsing each row's data
JSON in Python rather than with SQLite JSON1 functions, so sqlite builds
without JSON1 serve the tool; SQL filters stay on plain columns.

Standard library only, python3 rather than jq because the bootstrap
container installs python3 but not jq; sqlite is read through the
stdlib module for the same reason, matching validate-ledger.py.

rollup mode aggregation contract:

- Input is a ledger of invocation records (extractor output). Records
  of any other type, and malformed lines, warn and are skipped with the
  count named on stderr, so a mixed ledger cannot double count.
- Records with an attribution.unit_id form unit rollups keyed by
  (unit_id, batch_id); records with an attribution.batch_id form one
  batch rollup per batch. --unit ID declares the pass's territory: any
  record whose attribution carries no unit counts toward the declared
  unit's rollup instead of vanishing (the per-unit extraction-pass
  form the rollups fixture pins). Without it, unattributed records
  appear only in their batch's totals, and a record carrying neither
  unit nor batch is named on stderr, never silently dropped.
- Sums: tokens over the five contract fields (null reasoning
  contributes 0), nested_tokens over each nested child's four token
  fields, retry_count over retry.count, duration_ms_total over non-null
  durations, restart_count counting records carrying restart evidence
  (either field, per the contract's stand-alone rule), and
  cost.amount_sum over reported amounts only, null when nothing was
  reported. Stop reasons stay verbatim per record; cross-harness
  grouping by semantic class is the consumer's duty (ORCH-4-7).
- Budgets: --budget dimension=value declares a batch's soft budgets;
  a dimension is flagged in budget.over_budget, and emitted as
  over-budget(<dimension>) in the digest, only when its declared value
  is non-null and its actual exceeds it. Actuals are pinned by the
  contract: tokens compares tokens.input + tokens.output (cache traffic
  excluded), cost compares cost.amount_sum (a null sum never flags),
  wall_clock compares duration_ms_total, requests compares
  invocation_count. Flags route to manager investigation or user
  escalation; no code path terminates processes or edits task state.
- --yield-tally FILE embeds the batch's verification-yield tally
  (artifact 20 DC1) in every emitted batch rollup; the file must carry
  every contract field including at least one source link.
- --update-cursor FILE writes the per-harness high-water invocation
  timestamps (pi, opencode) of the rolled ledger, merged monotonically
  over any existing file, so the next oc extraction can pass its stored
  value as --since; --print-cursor FILE prints the stored cursor JSON,
  or the bare epoch-milliseconds value for --harness NAME.
- Every emitted record carries the additive runtime_ms field naming the
  aggregation pass's own wall time, and generated_at stamps the pass.

ac12 mode contract:

- --results FILE carries {"families": {...}} with exactly the five
  contract families (read_latency, context_token_cost,
  command_failures, retrieval_completeness, permission_denials), each
  {method, source, values, notes} where values maps metric names to
  numbers or null. The mode validates the shape, stamps generated_at,
  phase, and harness, and emits the ac12_snapshot record; the probe
  measurement protocol itself lives in tests/task-metrics/ac12-probe-spec.md.
"""

import argparse
import json
import math
import os
import re
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path

SCHEMA_VERSION = "1.0"

DEFAULT_DB = "~/.local/share/opencode/opencode.db"
DEFAULT_ENGINE_LOG = "~/.local/share/opencode/oc-continue/engine.log"

OC_STOP_UNKNOWN = "unknown"
PARK_LINE_PATTERN = re.compile(r"parking \d+s until session")
INVOKE_MARKER = "invoking opencode run"

ZEROED_STOP_REASONS = ("error", "aborted")
RETRY_STOP_REASON = "error"
SUBAGENT_TOOL_NAME = "subagent"
WORKTREE_MARKER = "/.worktrees/"
WORKTREE_SLUG_RE = re.compile(r"([a-z]+)(\d+(?:-\d+)*)\Z")
TASK_ID_RE = re.compile(r"\b([A-Z][A-Z0-9]*-\d+(?:-\d+)+)\b")
PI_SESSION_ROOT = "~/.pi/agent/sessions"
PI_CONTINUE_STATE_DIR = "~/.local/share/pi/pi-continue"

MODES = ("oc", "pi", "rollup", "ac12")

BUDGET_DIMENSIONS = ("tokens", "cost", "wall_clock", "requests")
BUDGET_DECLARED_KEYS = {"tokens": "tokens", "cost": "cost",
	"wall_clock": "wall_clock_ms", "requests": "requests"}
BUDGET_FLAG_NAMES = ("tokens", "cost", "wall_clock_ms", "requests")
TOKEN_SUM_FIELDS = ("input", "output", "cache_read", "cache_write", "reasoning")
NESTED_TOKEN_SUM_FIELDS = ("input", "output", "cache_read", "cache_write")
CONFIDENCE_CLASSES = ("exact", "window", "unattributed")
CURSOR_HARNESSES = ("pi", "opencode")
AC12_FAMILIES = ("read_latency", "context_token_cost", "command_failures",
	"retrieval_completeness", "permission_denials")
AC12_PHASES = ("before", "after")
YIELD_TALLY_COUNT_FIELDS = ("verifier_caught_defects", "reviewer_blocker",
	"reviewer_major", "reviewer_minor", "escaped_defects", "false_positives")
YIELD_TALLY_BASIS_FIELDS = ("verifier_findings_by_severity",) + YIELD_TALLY_COUNT_FIELDS

USAGE_TEXT = """usage: task-metrics <mode> [options]

Modes:
  oc       Extract opencode.db into invocation ledger records (schema 1.0)
  pi       Extract a pi session store into invocation ledger records (schema 1.0)
  rollup   Aggregate invocation records into unit/batch rollups with
           soft-budget flags and digests (schema 1.0)
  ac12     Emit an ac12_snapshot record from AC-12 probe results

Run `task-metrics <mode> --help` for a mode's options and the
contract the mode follows.
"""


def warn(message):
	print(f"task-metrics: warning: {message}", file=sys.stderr)


def die(message):
	print(f"task-metrics: error: {message}", file=sys.stderr)
	return 2


def is_count(value):
	return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def is_amount(value):
	return isinstance(value, (int, float)) and not isinstance(value, bool) \
		and math.isfinite(value)


def entry_epoch(timestamp):
	"""Parse an entry timestamp (RFC3339 UTC Z) to an epoch, None when unusable."""
	try:
		return datetime.fromisoformat(timestamp.replace("Z", "+00:00")).timestamp()
	except (AttributeError, ValueError, TypeError):
		return None


def text_of(content):
	"""Concatenate the text blocks of a message content list (or a bare string)."""
	if isinstance(content, str):
		return content
	if not isinstance(content, list):
		return ""
	return " ".join(block.get("text", "") for block in content
		if isinstance(block, dict) and block.get("type") == "text")


def normalize_worktree_unit(cwd):
	"""Map a session cwd inside a unit worktree to its task id, None otherwise.

	The manager names unit worktrees after their task id lowercased with
	the prefix run together (orch4-3-2); the inverse normalization
	restores ORCH-4-3-2. Unrecognized slugs stay verbatim.
	"""
	if not isinstance(cwd, str) or WORKTREE_MARKER not in cwd:
		return None
	slug = cwd.split(WORKTREE_MARKER, 1)[1].split("/", 1)[0]
	match = WORKTREE_SLUG_RE.match(slug)
	if match:
		return f"{match.group(1).upper()}-{match.group(2)}"
	return slug or None


def derive_attribution(cwd, prose, batch_id):
	"""Derive the attribution object for one record from cwd, prose, and batch."""
	unit = normalize_worktree_unit(cwd)
	if unit is not None:
		return {"method": "cwd-match", "confidence": "exact",
			"unit_id": unit, "batch_id": batch_id}
	match = TASK_ID_RE.search(prose)
	if match:
		return {"method": "task-file-reference", "confidence": "exact",
			"unit_id": match.group(1), "batch_id": batch_id}
	return {"method": "none", "confidence": "unattributed",
		"unit_id": None, "batch_id": batch_id}


def derive_retry(stop_reason, previous_stop_reason):
	"""Derive the retry object: an error stop reason is direct evidence,
	an assistant row directly following an error row is a repeat invocation."""
	if stop_reason == RETRY_STOP_REASON:
		return {"count": 1, "evidence": "stop-reason"}
	if previous_stop_reason == RETRY_STOP_REASON:
		return {"count": 1, "evidence": "invocation-repeat"}
	return {"count": 0, "evidence": None}


def map_tokens(usage, path):
	"""Map a pi usage block to the ledger token object; malformed counts
	coerce to 0 or null with a warning so the ledger stays valid."""
	fields = {}
	for name, key in (("input", "input"), ("output", "output"),
			("cache_read", "cacheRead"), ("cache_write", "cacheWrite")):
		value = usage.get(key)
		if is_count(value):
			fields[name] = value
		else:
			if value is not None:
				warn(f"{path}: usage.{key} is not a valid count ({value!r}), coerced to 0")
			fields[name] = 0
	reasoning = usage.get("reasoning")
	if is_count(reasoning):
		fields["reasoning"] = reasoning
	else:
		if reasoning is not None:
			warn(f"{path}: usage.reasoning is not a valid count ({reasoning!r}), coerced to null")
		fields["reasoning"] = None
	return fields


def map_cost(usage, zeroed_row, path):
	"""Map a pi usage block to the ledger cost object.

	Zeroed error/aborted rows carry cost source none with a null amount
	(the contract's canonical pi form for the all-zero usage block); a
	completed usage block reports its cost total verbatim, zero included.
	"""
	if zeroed_row:
		return {"amount": None, "source": "none"}
	cost = usage.get("cost")
	total = cost.get("total") if isinstance(cost, dict) else None
	if is_amount(total):
		return {"amount": total, "source": "reported"}
	if total is not None:
		warn(f"{path}: usage.cost.total is not a valid amount ({total!r}), carried as unreported")
	return {"amount": None, "source": "none"}


def child_records(results, source):
	"""Map subagent toolResult details.results[] entries to nested child
	records; entries without a usable agent name warn and are dropped."""
	children = []
	for index, result in enumerate(results):
		if not isinstance(result, dict):
			warn(f"{source} child {index} is not an object, dropped")
			continue
		agent = result.get("agent")
		if not isinstance(agent, str) or not agent:
			warn(f"{source} child {index} carries no agent name, dropped")
			continue
		usage = result.get("usage") if isinstance(result.get("usage"), dict) else {}
		cost = usage.get("cost")
		exit_code = result.get("exitCode")
		exit_code = exit_code if isinstance(exit_code, int) \
			and not isinstance(exit_code, bool) else None
		children.append({
			"agent": agent,
			"agent_role": agent,
			"model": result.get("model") if isinstance(result.get("model"), str)
				and result.get("model") else None,
			"exit_code": exit_code,
			"stop_reason": result.get("stopReason") if isinstance(result.get("stopReason"), str)
				and result.get("stopReason") else None,
			"tokens": {name: usage.get(key) if is_count(usage.get(key)) else 0
				for name, key in (("input", "input"), ("output", "output"),
					("cache_read", "cacheRead"), ("cache_write", "cacheWrite"))},
			"cost": {"amount": cost, "source": "reported"} if is_amount(cost)
				else {"amount": None, "source": "none"},
			"turns": usage.get("turns") if is_count(usage.get("turns")) else None,
			"source": "pi-subagent-details",
		})
	return children


def session_identity(path, header):
	"""The session id from the header entry, falling back to the filename
	(minus pi's <timestamp>_ prefix and .jsonl suffix)."""
	if isinstance(header, dict):
		sid = header.get("id")
		if isinstance(sid, str) and sid:
			return sid
	name = os.path.basename(path)
	stem = name[:-len(".jsonl")] if name.endswith(".jsonl") else name
	return stem.split("_", 1)[-1] if stem else name


def read_session(path):
	"""Read one session file into (header, entries, skipped_line_count).
	Malformed lines warn and are skipped; a wholly unreadable file warns
	and returns no entries."""
	try:
		with open(path, encoding="utf-8") as handle:
			lines = handle.read().splitlines()
	except (OSError, UnicodeDecodeError) as exc:
		warn(f"{path} is unreadable ({exc}), skipped")
		return None, [], 0
	header = None
	entries = []
	skipped = 0
	for number, raw in enumerate(lines, start=1):
		if not raw.strip():
			continue
		try:
			rec = json.loads(raw)
		except json.JSONDecodeError as exc:
			warn(f"{path} line {number} is not valid JSON ({exc.msg}), skipped")
			skipped += 1
			continue
		if not isinstance(rec, dict):
			warn(f"{path} line {number} is not a JSON object, skipped")
			skipped += 1
			continue
		if rec.get("type") == "session" and header is None:
			header = rec
			continue
		if rec.get("type") == "message":
			entries.append(rec)
	return header, entries, skipped


def extract_session(path, batch_id):
	"""Extract one session file into invocation records. Returns
	(records, session_span, skipped_line_count, unattached_group_count)
	where session_span is (session_id, first_record_epoch,
	last_record_epoch) or None and unattached_group_count is the number
	of subagent result groups no record claims."""
	header, entries, skipped = read_session(path)
	if not entries:
		return [], None, skipped, 0
	session_id = session_identity(path, header)
	cwd = header.get("cwd") if isinstance(header, dict) else None
	toolcall_owner = {}
	children_by_key = {}
	children_sources = {}
	for entry in entries:
		message = entry.get("message")
		if not isinstance(message, dict):
			continue
		role = message.get("role")
		if role == "assistant":
			content = message.get("content")
			if isinstance(content, list):
				for block in content:
					if isinstance(block, dict) and block.get("type") == "toolCall" \
							and isinstance(block.get("id"), str) and block["id"]:
						toolcall_owner[block["id"]] = entry.get("id")
			continue
		if role != "toolResult":
			continue
		details = message.get("details")
		results = details.get("results") if isinstance(details, dict) else None
		if not isinstance(results, list):
			continue
		source = f"{path} entry {entry.get('id')}"
		call_id = message.get("toolCallId")
		owner = toolcall_owner.get(call_id) \
			if isinstance(call_id, str) and call_id else None
		key = owner or entry.get("parentId")
		children_by_key.setdefault(key, []).extend(child_records(results, source))
		children_sources.setdefault(key, []).append(source)
	records = []
	prose = ""
	previous_stop = None
	first_epoch = last_epoch = None
	for entry in entries:
		message = entry.get("message")
		if not isinstance(message, dict):
			continue
		role = message.get("role")
		if role in ("user", "assistant"):
			prose = f"{prose} {text_of(message.get('content'))}"
		if role != "assistant":
			continue
		entry_id = entry.get("id")
		stop_reason = message.get("stopReason")
		if not isinstance(entry_id, str) or not entry_id \
				or not isinstance(stop_reason, str) or not stop_reason:
			warn(f"{path} entry {entry_id!r} lacks an id or stopReason, skipped")
			continue
		if not isinstance(message.get("model"), str) or not message["model"] \
				or not isinstance(message.get("provider"), str) or not message["provider"]:
			warn(f"{path} entry {entry_id} lacks model or provider, skipped")
			continue
		epoch = entry_epoch(entry.get("timestamp"))
		if epoch is None:
			warn(f"{path} entry {entry_id} carries no usable timestamp, skipped")
			continue
		zeroed = stop_reason in ZEROED_STOP_REASONS
		usage = message.get("usage") if isinstance(message.get("usage"), dict) else {}
		record = {
			"schema_version": SCHEMA_VERSION,
			"record_type": "invocation",
			"timestamp": entry["timestamp"],
			"harness": "pi",
			"session_id": session_id,
			"message_id": entry_id,
			"agent_role": None,
			"model": message["model"],
			"provider": message["provider"],
			"tokens": map_tokens({} if zeroed else usage, f"{path} entry {entry_id}"),
			"cost": map_cost(usage, zeroed, f"{path} entry {entry_id}"),
			"duration_ms": message.get("durationMs") if is_count(message.get("durationMs")) else None,
			"stop_reason": stop_reason,
			"retry": derive_retry(stop_reason, previous_stop),
			"restart": {"of_session_id": None, "engine_log": None},
			"nested": {"child_count": 0, "children": children_by_key.get(entry_id, [])},
			"attribution": derive_attribution(cwd, prose, batch_id),
		}
		record["nested"]["child_count"] = len(record["nested"]["children"])
		records.append(record)
		previous_stop = stop_reason
		if first_epoch is None:
			first_epoch = epoch
		last_epoch = epoch
	emitted = {record["message_id"] for record in records}
	unattached = 0
	for key, sources in children_sources.items():
		if key in emitted:
			continue
		unattached += len(sources)
		for source in sources:
			warn(f"{source} subagent result group resolves under neither "
				f"its toolCallId nor its parentId, dropped")
	if first_epoch is None:
		return [], None, skipped, unattached
	return records, (session_id, first_epoch, last_epoch), skipped, unattached


def engine_restart_events(path):
	"""Parse pi-continue engine.log into park/restart cycles: a line
	naming a park followed by the next line invoking pi. Line timestamps
	carry local offsets; entries are compared in absolute time. An
	interrupted park (park interrupted, wait interrupted, stopped by
	user) and a fresh run start clear the pending park, so an explicitly
	interrupted park never completes against a later run's invocation."""
	if not os.path.exists(path):
		return []
	try:
		with open(path, encoding="utf-8") as handle:
			lines = handle.read().splitlines()
	except (OSError, UnicodeDecodeError) as exc:
		warn(f"{path} is unreadable ({exc}), no restart joins")
		return []
	events = []
	pending = None
	for line in lines:
		stripped = line.strip()
		if not stripped:
			continue
		parts = stripped.split(None, 1)
		epoch = None
		try:
			epoch = datetime.fromisoformat(parts[0]).timestamp()
		except ValueError:
			continue
		text = parts[1] if len(parts) > 1 else ""
		if "parking" in text:
			pending = {"park_epoch": epoch, "park_line": stripped}
		elif "invoking pi" in text and pending is not None:
			pending["invoke_epoch"] = epoch
			events.append(pending)
			pending = None
		elif pending is not None and ("interrupted" in text
				or "stopped by user" in text or "run start" in text
				or "one-shot start" in text):
			pending = None
	return events


def attach_restarts(records, spans, events):
	"""Annotate the first not-yet-annotated record at or after each
	restart invocation with the prior session's id (the session newest at
	the park moment) and the park line verbatim."""
	spans_by_epoch = sorted(
		(span for span in spans if span is not None),
		key=lambda span: span[2])
	for event in events:
		if event.get("invoke_epoch") is None:
			continue
		prior = None
		for span in spans_by_epoch:
			if span[2] <= event["park_epoch"]:
				prior = span[0]
		for record in records:
			epoch = entry_epoch(record["timestamp"])
			if epoch is None or epoch < event["invoke_epoch"]:
				continue
			if record["restart"]["engine_log"] is not None:
				continue
			record["restart"] = {"of_session_id": prior,
				"engine_log": event["park_line"]}
			break


def cmd_pi(args):
	"""Run the pi extraction; returns the process exit code."""
	session_root = args.session_dir or os.environ.get("PI_CODING_AGENT_SESSION_DIR") \
		or os.path.expanduser(PI_SESSION_ROOT)
	engine_log = args.engine_log or os.path.join(
		os.path.expanduser(os.environ.get("PI_CONTINUE_STATE_DIR") or PI_CONTINUE_STATE_DIR),
		"engine.log")
	if not os.path.isdir(session_root):
		return die(f"session directory {session_root} does not exist")
	if args.engine_log and not os.path.isfile(args.engine_log):
		return die(f"engine log {args.engine_log} does not exist")
	if not args.engine_log and not os.path.isfile(engine_log):
		warn(f"default engine log {engine_log} does not exist, no restart joins")
	paths = []
	for directory, subdirs, files in os.walk(session_root):
		subdirs.sort()
		for name in sorted(files):
			if name.endswith(".jsonl"):
				paths.append(os.path.join(directory, name))
	events = engine_restart_events(engine_log)
	records = []
	spans = []
	skipped_total = 0
	unattached_total = 0
	for path in paths:
		session_records, span, skipped, unattached = extract_session(path, args.batch_id)
		records.extend(session_records)
		spans.append(span)
		skipped_total += skipped
		unattached_total += unattached
	attach_restarts(records, spans, events)
	try:
		if args.output:
			with open(args.output, "a", encoding="utf-8") as handle:
				for record in records:
					handle.write(json.dumps(record, separators=(",", ":")) + "\n")
		else:
			for record in records:
				print(json.dumps(record, separators=(",", ":")))
	except OSError as exc:
		return die(f"cannot write ledger {args.output or 'stdout'}: {exc}")
	print(f"task-metrics: pi: {len(paths)} session file(s), {len(records)} record(s), "
		f"{skipped_total} malformed line(s) skipped, {unattached_total} unattached "
		f"subagent group(s), {len(events)} restart cycle(s) joined", file=sys.stderr)
	return 0


class UsageError(Exception):
	"""A caller mistake: bad flag values, unknown mode, missing input."""


class HelpRequested(Exception):
	"""The caller asked for the usage text."""

def parse_oc_args(argv):
	options = {
		"db": DEFAULT_DB,
		"engine_log": DEFAULT_ENGINE_LOG,
		"session": None,
		"since": None,
		"until": None,
		"cwd": None,
		"unit": None,
		"batch": None,
		"out": None,
	}
	value_flags = {
		"--db": "db",
		"--engine-log": "engine_log",
		"--session": "session",
		"--since": "since",
		"--until": "until",
		"--cwd": "cwd",
		"--unit": "unit",
		"--batch": "batch",
		"--out": "out",
	}
	index = 0
	while index < len(argv):
		flag = argv[index]
		if flag in ("--help", "-h"):
			raise HelpRequested()
		if flag in value_flags:
			if index + 1 >= len(argv):
				raise UsageError(f"{flag} requires a value")
			options[value_flags[flag]] = argv[index + 1]
			index += 1
		else:
			raise UsageError(f"unknown option {flag!r}")
		index += 1
	if (options["cwd"] is None) != (options["unit"] is None):
		raise UsageError("--cwd and --unit are a pair: give both or neither")
	if options["since"] is not None:
		options["since_ms"] = parse_moment(options["since"], "--since")
	if options["until"] is not None:
		options["until_ms"] = parse_moment(options["until"], "--until")
	return options


def parse_moment(text, flag):
	"""Parse a --since/--until value into epoch milliseconds.

	MOMENT is integer epoch milliseconds, or RFC3339 with a Z suffix or a
	numeric offset; a naive timestamp is read as UTC.
	"""
	if re.fullmatch(r"\d+", text):
		return int(text)
	normalized = text[:-1] + "+00:00" if text.endswith("Z") else text
	try:
		parsed = datetime.fromisoformat(normalized)
	except ValueError:
		raise UsageError(f"{flag} expects epoch milliseconds or RFC3339, got {text!r}")
	if parsed.tzinfo is None:
		parsed = parsed.replace(tzinfo=timezone.utc)
	return int(parsed.timestamp() * 1000)


def parse_log_moment(text):
	"""Parse an RFC3339 timestamp to epoch milliseconds, None when unusable."""
	normalized = text[:-1] + "+00:00" if text.endswith("Z") else text
	try:
		parsed = datetime.fromisoformat(normalized)
	except ValueError:
		return None
	if parsed.tzinfo is None:
		parsed = parsed.replace(tzinfo=timezone.utc)
	return int(parsed.timestamp() * 1000)


def rfc3339_utc(epoch_ms):
	seconds, milliseconds = divmod(epoch_ms, 1000)
	moment = datetime.fromtimestamp(seconds, tz=timezone.utc)
	base = moment.strftime("%Y-%m-%dT%H:%M:%S")
	return f"{base}.{milliseconds:03d}Z" if milliseconds else f"{base}Z"


def open_readonly(db_path):
	uri = Path(db_path).expanduser().resolve().as_uri() + "?mode=ro"
	return sqlite3.connect(uri, uri=True)


def load_sessions(connection, session_filter):
	"""Load session context from both durable session tables.

	Messages reference session ids that live in either the legacy `session`
	table or `session_v2` (the live store carries both), so both are read
	and session_v2 wins on an id collision; a store without one of the
	tables still extracts. The contract's nesting trace (session_v2
	parent_id chains, recon oc 2's "and session") covers both surfaces.
	"""
	sessions = {}
	for table in ("session", "session_v2"):
		try:
			rows = connection.execute(
				f"SELECT id, parent_id, agent FROM {table}").fetchall()
		except sqlite3.OperationalError:
			continue
		for row in rows:
			sessions[row[0]] = {"parent_id": row[1], "agent": row[2]}
	if session_filter is not None and session_filter not in sessions:
		raise UsageError(f"unknown session {session_filter!r}: no session row")
	return sessions


def partition_scope(sessions, session_filter):
	"""Split the session table into parents (records) and children (folded into nested.children).

	With a --session filter only the requested session's subtree is in
	scope: the session itself and its deeper standalone descendants are
	parents, its direct children fold, and nothing outside the subtree is
	read. Without a filter, every top-level session is a parent, and so is
	a child session whose parent row does not exist (dropping it would
	hide its invocations). Chains deeper than one level flatten: a session
	whose parent itself folds into a parent record becomes a standalone
	parent, because the contract's nested shape is one level deep and
	silently dropping a grandchild's invocations would hide them; the
	flatten rule keeps every in-scope invocation emitted exactly once.
	"""
	if session_filter is not None:
		return subtree_scope(sessions, session_filter)
	parents = {session_id for session_id, row in sessions.items()
		if row["parent_id"] is None or row["parent_id"] not in sessions}
	children = set()
	pending = set(sessions) - parents
	while True:
		progress = False
		for session_id in sorted(pending):
			parent_id = sessions[session_id]["parent_id"]
			if parent_id in parents:
				children.add(session_id)
				pending.discard(session_id)
				progress = True
			elif parent_id not in children:
				parents.add(session_id)
				pending.discard(session_id)
				progress = True
		if not progress:
			break
	parents |= pending
	return parents, children


def subtree_scope(sessions, session_filter):
	"""Walk a --session subtree by alternating levels: children fold, their children stand alone as parents whose own children fold again."""
	parents = {session_filter}
	children = set()
	folding = {session_filter}
	while folding:
		new_children = {session_id for session_id, row in sessions.items()
			if row["parent_id"] in folding
				and session_id not in parents | children}
		children |= new_children
		folding = {session_id for session_id, row in sessions.items()
			if row["parent_id"] in new_children
				and session_id not in parents | children}
		parents |= folding
	return parents, children


def filter_clause(session_ids, options, qualifier=""):
	clauses, parameters = [], []
	if session_ids is not None:
		marks = ",".join("?" for _ in session_ids)
		clauses.append(f"{qualifier}session_id IN ({marks})")
		parameters.extend(session_ids)
	if "since_ms" in options:
		clauses.append(f"{qualifier}time_created >= ?")
		parameters.append(options["since_ms"])
	if "until_ms" in options:
		clauses.append(f"{qualifier}time_created < ?")
		parameters.append(options["until_ms"])
	return clauses, parameters


def load_message_rows(connection, session_ids, options):
	clauses, parameters = filter_clause(session_ids, options)
	query = ("SELECT session_id, id, time_created, time_updated, data FROM message WHERE "
		+ " AND ".join(["1=1"] + clauses)
		+ " ORDER BY time_created, id")
	return connection.execute(query, parameters).fetchall()


def load_part_rows(connection, session_ids, options):
	"""Load the parts of the in-scope messages, regardless of part time.

	--since/--until and the session filter apply to the owning message's
	time_created, never the part's own: a step-finish part timestamped
	past a window boundary (or ahead of its message under --since) still
	reaches the record that owns it instead of truncating the message's
	stop reason to unknown and fabricating a retry from the gap.
	"""
	clauses, parameters = filter_clause(session_ids, options, "m.")
	query = ("SELECT p.message_id, p.session_id, p.id, p.time_created, p.data "
		"FROM part p JOIN message m ON p.message_id = m.id WHERE "
		+ " AND ".join(["1=1"] + clauses)
		+ " ORDER BY p.time_created, p.id")
	return connection.execute(query, parameters).fetchall()


def nonnegative_int(value):
	if isinstance(value, bool) or not isinstance(value, int) or value < 0:
		return 0
	return value


def token_object(source_tokens):
	cache = source_tokens.get("cache") if isinstance(source_tokens, dict) else None
	cache = cache if isinstance(cache, dict) else {}
	reasoning = source_tokens.get("reasoning")
	reasoning_ok = (not isinstance(reasoning, bool) and isinstance(reasoning, int)
		and reasoning >= 0)
	return {
		"input": nonnegative_int(source_tokens.get("input")),
		"output": nonnegative_int(source_tokens.get("output")),
		"cache_read": nonnegative_int(cache.get("read")),
		"cache_write": nonnegative_int(cache.get("write")),
		"reasoning": reasoning if reasoning_ok else None,
	}


def cost_object(raw_cost, label):
	"""Mark a persisted cost verbatim: nonzero nonnegative numbers are reported, zeros ride under source none.

	The ledger contract's invariant is two-directional: source reported
	requires a numeric amount, and source none requires null or the
	harness's reported zero, so a negative or non-numeric persisted value
	cannot be carried as reported without emitting a contract-invalid
	record; those degrade to null under source none with a warning.
	"""
	numeric = (not isinstance(raw_cost, bool) and isinstance(raw_cost, (int, float)))
	if numeric and raw_cost > 0:
		return {"amount": raw_cost, "source": "reported"}
	if numeric and raw_cost == 0:
		return {"amount": 0, "source": "none"}
	if raw_cost is not None:
		warn(f"{label}: unusable cost value {raw_cost!r}, carried as null under source none")
	return {"amount": None, "source": "none"}


def normalized_stop_reason(reason):
	if isinstance(reason, str) and reason:
		return reason
	return OC_STOP_UNKNOWN


def attribution_object(data, options):
	path = data.get("path")
	cwd = path.get("cwd") if isinstance(path, dict) else None
	if options["cwd"] is not None and cwd == options["cwd"]:
		return {
			"method": "cwd-match",
			"confidence": "exact",
			"unit_id": options["unit"],
			"batch_id": options["batch"],
		}
	return {
		"method": "none",
		"confidence": "unattributed",
		"unit_id": None,
		"batch_id": options["batch"],
	}


def build_invocation_record(row, data, stop_reason, children, later_in_session,
		restart, options):
	session_id, message_id, time_created, time_updated = row
	source_tokens = data.get("tokens") if isinstance(data.get("tokens"), dict) else {}
	duration = time_updated - time_created
	if duration < 0:
		warn(f"message {message_id}: negative duration {duration}, carried as null")
		duration = None
	if stop_reason == OC_STOP_UNKNOWN and later_in_session:
		retry = {"count": 1, "evidence": "invocation-repeat"}
	else:
		retry = {"count": 0, "evidence": None}
	return {
		"schema_version": SCHEMA_VERSION,
		"record_type": "invocation",
		"timestamp": rfc3339_utc(time_created),
		"harness": "opencode",
		"session_id": session_id,
		"message_id": message_id,
		"agent_role": data.get("agent") if isinstance(data.get("agent"), str) else None,
		"model": data["modelID"],
		"provider": data["providerID"],
		"tokens": token_object(source_tokens),
		"cost": cost_object(data.get("cost"), f"message {message_id}"),
		"duration_ms": duration,
		"stop_reason": stop_reason,
		"retry": retry,
		"restart": restart,
		"nested": {
			"child_count": len(children),
			"children": children,
		},
		"attribution": attribution_object(data, options),
	}


def build_child_entry(child_id, sessions, child_messages, child_parts):
	"""Aggregate one child session into a nested.children entry.

	tokens and cost sum across the child's assistant messages; model and
	stop_reason come from the child's last assistant message and last
	step-finish part; exit_code and turns have no durable opencode surface
	and stay null.
	"""
	message_rows = child_messages.get(child_id, [])
	token_sums = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0}
	amount_sum = 0.0
	amount_seen = False
	nonzero_seen = False
	model = None
	for row in message_rows:
		data = row["data"]
		tokens = token_object(data.get("tokens") if isinstance(data.get("tokens"), dict) else {})
		for field in token_sums:
			token_sums[field] += tokens[field]
		raw_cost = data.get("cost")
		if not isinstance(raw_cost, bool) and isinstance(raw_cost, (int, float)):
			amount_seen = True
			if raw_cost > 0:
				amount_sum += raw_cost
				nonzero_seen = True
			elif raw_cost < 0:
				warn(f"child session {child_id} message {row['id']}: "
					f"unusable cost value {raw_cost!r}, excluded from the child sum")
		elif raw_cost is not None:
			warn(f"child session {child_id} message {row['id']}: "
				f"unusable cost value {raw_cost!r}, excluded from the child sum")
		if isinstance(data.get("modelID"), str):
			model = data["modelID"]
	if nonzero_seen:
		cost = {"amount": amount_sum, "source": "reported"}
	elif amount_seen:
		cost = {"amount": 0, "source": "none"}
	else:
		cost = {"amount": None, "source": "none"}
	part_entries = child_parts.get(child_id, [])
	stop_reason = normalized_stop_reason(part_entries[-1]["reason"]) if part_entries else None
	session_row = sessions[child_id]
	agent_role = session_row["agent"] if isinstance(session_row["agent"], str) else None
	if agent_role is None:
		for row in message_rows:
			if isinstance(row["data"].get("agent"), str):
				agent_role = row["data"]["agent"]
				break
	return {
		"agent": child_id,
		"agent_role": agent_role,
		"model": model,
		"exit_code": None,
		"stop_reason": stop_reason,
		"tokens": token_sums,
		"cost": cost,
		"turns": None,
		"source": "oc-parent-id",
	}


def parse_engine_log(path):
	"""Read park/restart windows from an oc-continue engine.log.

	Returns a list of (open_ms, close_ms, verbatim_park_line) windows. Each
	park line opens a window at its timestamp; the window closes at the
	next invoking line, or at the next park line, whichever comes first,
	and only invoke-closed windows are returned (a park the ride never
	followed, for example one interrupted at park time, marks nothing).
	"""
	try:
		raw = Path(path).expanduser().read_text(encoding="utf-8", errors="replace")
	except OSError as exc:
		warn(f"engine log unreadable, restart fields stay null: {exc}")
		return []
	events = []
	for line in raw.splitlines():
		if not line.strip():
			continue
		head = line.split(maxsplit=1)
		if len(head) != 2:
			continue
		moment_ms = parse_log_moment(head[0])
		if moment_ms is None:
			continue
		text = head[1]
		if PARK_LINE_PATTERN.search(text):
			events.append((moment_ms, "park", line))
		elif INVOKE_MARKER in text:
			events.append((moment_ms, "invoke", line))
	windows = []
	for index, (moment_ms, kind, line) in enumerate(events):
		if kind != "park":
			continue
		for later_ms, later_kind, _ in events[index + 1:]:
			if later_ms <= moment_ms:
				continue
			if later_kind == "invoke":
				windows.append((moment_ms, later_ms, line))
			break
	return windows


def assign_restarts(records, windows):
	"""Mark the first invocation inside each window; of_session_id names the session of the last earlier record."""
	restarts = [None] * len(records)
	for open_ms, close_ms, park_line in windows:
		first = None
		for index, record in enumerate(records):
			if open_ms < record["time_created"] <= close_ms:
				first = index
				break
		if first is None:
			continue
		of_session_id = records[first - 1]["session_id"] if first > 0 else None
		restarts[first] = {"of_session_id": of_session_id, "engine_log": park_line}
	return restarts


def ledger_invocations(path):
	"""Collect the (session_id, message_id) pairs already in an append target.

	The ledger contract is append-only and the validator rejects
	duplicate (harness, session_id, message_id) invocations, so a re-run
	over an overlapping scope must skip what the file already holds
	instead of appending it a second time. Lines that do not parse warn
	and contribute no pairs; a file that cannot be read at all returns
	None so the append fails later at write time under the existing
	handling.
	"""
	pairs = set()
	try:
		with open(path, encoding="utf-8") as ledger:
			for lineno, line in enumerate(ledger, 1):
				if not line.strip():
					continue
				try:
					record = json.loads(line)
				except json.JSONDecodeError:
					warn(f"{path}: line {lineno} is not valid JSON, "
						"its invocations cannot be checked for duplicates")
					continue
				if (isinstance(record, dict)
						and record.get("record_type") == "invocation"
						and isinstance(record.get("session_id"), str)
						and isinstance(record.get("message_id"), str)):
					pairs.add((record["session_id"], record["message_id"]))
	except OSError:
		return None
	return pairs


def extract_oc(options):
	db_path = Path(options["db"]).expanduser()
	if not db_path.is_file():
		raise UsageError(f"database not found: {options['db']}")
	connection = open_readonly(db_path)
	try:
		sessions = load_sessions(connection, options["session"])
		parents, children = partition_scope(sessions, options["session"])
		scope = parents | children
		scope_ids = None if len(scope) == len(sessions) else sorted(scope)
		message_rows = load_message_rows(connection, scope_ids, options)
		part_rows = load_part_rows(connection, scope_ids, options)
	finally:
		connection.close()

	anomalies = 0
	stop_reasons = {}
	session_keys = {}
	part_by_message = {}
	part_by_session = {}
	for row in part_rows:
		message_id, session_id, part_id, time_created, raw = row
		try:
			data = json.loads(raw)
		except json.JSONDecodeError:
			anomalies += 1
			warn(f"part {part_id}: data is not valid JSON, skipped")
			continue
		if not isinstance(data, dict) or data.get("type") != "step-finish":
			continue
		reason = data.get("reason") if isinstance(data.get("reason"), str) else None
		entry = {"time_created": time_created, "id": part_id, "reason": reason}
		part_by_message[message_id] = entry
		part_by_session.setdefault(session_id, []).append(entry)

	messages = []
	for row in message_rows:
		session_id, message_id, time_created, time_updated, raw = row
		try:
			data = json.loads(raw)
		except json.JSONDecodeError:
			anomalies += 1
			warn(f"message {message_id}: data is not valid JSON, skipped")
			continue
		if not isinstance(data, dict) or data.get("role") != "assistant":
			continue
		if not isinstance(data.get("modelID"), str) or not data["modelID"]:
			anomalies += 1
			warn(f"message {message_id}: no usable modelID, record cannot be "
				"emitted contract-valid, skipped")
			continue
		if not isinstance(data.get("providerID"), str) or not data["providerID"]:
			anomalies += 1
			warn(f"message {message_id}: no usable providerID, record cannot be "
				"emitted contract-valid, skipped")
			continue
		messages.append({"session_id": session_id, "id": message_id,
			"time_created": time_created, "time_updated": time_updated, "data": data})
		stop_part = part_by_message.get(message_id)
		stop_reasons[message_id] = (
			normalized_stop_reason(stop_part["reason"]) if stop_part else OC_STOP_UNKNOWN)
		session_keys.setdefault(session_id, []).append((time_created, message_id))

	child_messages = {child_id: [] for child_id in children}
	parent_messages = {parent_id: [] for parent_id in parents}
	for entry in messages:
		if entry["session_id"] in parents:
			parent_messages[entry["session_id"]].append(entry)
		elif entry["session_id"] in child_messages:
			child_messages[entry["session_id"]].append(entry)
		else:
			# A message whose session row exists in neither table still
			# extracts, as a standalone parent with no derivable children;
			# dropping it would hide an invocation the store persisted.
			parent_messages.setdefault(entry["session_id"], []).append(entry)

	records = []
	for session_id, entries in parent_messages.items():
		if not entries:
			if any(sessions.get(child_id, {}).get("parent_id") == session_id
					for child_id in children):
				warn(f"session {session_id}: no assistant messages in scope, "
					"its child sessions stay unfolded")
			continue
		children_entries = [
			build_child_entry(child_id, sessions, child_messages, part_by_session)
			for child_id in sorted(child_messages)
			if sessions[child_id]["parent_id"] == session_id
		]
		for position, entry in enumerate(entries):
			last_key = session_keys[session_id][-1]
			records.append({
				"session_id": entry["session_id"],
				"id": entry["id"],
				"time_created": entry["time_created"],
				"time_updated": entry["time_updated"],
				"data": entry["data"],
				"stop_reason": stop_reasons[entry["id"]],
				"children": children_entries if position == 0 else [],
				"later_in_session": (entry["time_created"], entry["id"]) < last_key,
			})

	records.sort(key=lambda record: (record["time_created"], record["id"]))
	restarts = assign_restarts(records, parse_engine_log(options["engine_log"]))

	ledger_records = []
	for index, record in enumerate(records):
		restart = restarts[index]
		ledger_records.append(build_invocation_record(
			(record["session_id"], record["id"], record["time_created"],
				record["time_updated"]),
			record["data"],
			record["stop_reason"],
			record["children"],
			record["later_in_session"],
			restart if restart is not None else {"of_session_id": None, "engine_log": None},
			options,
		))

	if not ledger_records:
		warn("no invocation records extracted for the given scope")
		return 1

	appended = ledger_records
	skipped = 0
	if options["out"] is not None:
		present = ledger_invocations(Path(options["out"]).expanduser())
		if present is not None:
			appended = [record for record in ledger_records
				if (record["session_id"], record["message_id"]) not in present]
			skipped = len(ledger_records) - len(appended)
			if skipped:
				warn(f"{skipped} invocation records already in {options['out']}, "
					"not appended again")

	if not appended:
		print(f"task-metrics oc: 0 invocation records appended, "
			f"{skipped} already in {options['out']}, {anomalies} anomalies",
			file=sys.stderr)
		return 0

	lines = "".join(json.dumps(record, separators=(",", ":")) + "\n"
		for record in appended)
	if options["out"] is None:
		sys.stdout.write(lines)
	else:
		try:
			with open(Path(options["out"]).expanduser(), "a", encoding="utf-8") as ledger:
				ledger.write(lines)
		except OSError as exc:
			warn(f"cannot write {options['out']}: {exc}")
			return 2
	child_total = sum(record["nested"]["child_count"] for record in appended)
	skipped_note = f", {skipped} already in {options['out']}" if skipped else ""
	print(f"task-metrics oc: {len(appended)} invocation records, "
		f"{child_total} nested children, {anomalies} anomalies{skipped_note}",
		file=sys.stderr)
	return 0


def run_oc(argv):
	try:
		options = parse_oc_args(argv)
	except HelpRequested:
		print(__doc__, file=sys.stdout)
		return 0
	except UsageError as exc:
		print(f"task-metrics oc: {exc}", file=sys.stderr)
		return 2
	try:
		return extract_oc(options)
	except UsageError as exc:
		print(f"task-metrics oc: {exc}", file=sys.stderr)
		return 2
	except sqlite3.Error as exc:
		print(f"task-metrics oc: database error: {exc}", file=sys.stderr)
		return 2


def new_rollup_accumulator():
	"""An empty aggregate for one unit or batch, in the contract's field order."""
	return {
		"invocation_count": 0,
		"retry_count": 0,
		"restart_count": 0,
		"stop_reason_histogram": {},
		"tokens": {name: 0 for name in TOKEN_SUM_FIELDS},
		"nested_tokens": {name: 0 for name in NESTED_TOKEN_SUM_FIELDS},
		"cost_amount_sum": None,
		"cost_reported": 0,
		"cost_unreported": 0,
		"duration_ms_total": 0,
		"attribution_confidence_histogram": {name: 0 for name in CONFIDENCE_CLASSES},
		"unit_ids": set(),
		"unit_invocation_counts": {},
	}


def sum_tokens_field(source_tokens, name):
	"""One contract token field summed safely: absent, null, or non-integer counts contribute 0."""
	if isinstance(source_tokens, dict) and is_count(source_tokens.get(name)):
		return source_tokens[name]
	return 0


def accumulate_invocation(accumulator, record, label):
	"""Fold one invocation record into an accumulator.

	Permissive on absent fields (they contribute zero) but loud on
	anything that would distort a sum: unusable cost amounts, records
	without a usable stop reason, and unclassifiable confidences all
	warn so the digest can be traced back to its inputs.
	"""
	accumulator["invocation_count"] += 1
	retry = record.get("retry")
	if isinstance(retry, dict) and is_count(retry.get("count")):
		accumulator["retry_count"] += retry["count"]
	restart = record.get("restart")
	if isinstance(restart, dict) and (restart.get("of_session_id") is not None
			or restart.get("engine_log") is not None):
		accumulator["restart_count"] += 1
	stop_reason = record.get("stop_reason")
	if isinstance(stop_reason, str) and stop_reason:
		histogram = accumulator["stop_reason_histogram"]
		histogram[stop_reason] = histogram.get(stop_reason, 0) + 1
	else:
		warn(f"{label}: invocation without a usable stop_reason, excluded from the histogram")
	tokens = record.get("tokens")
	for name in TOKEN_SUM_FIELDS:
		accumulator["tokens"][name] += sum_tokens_field(tokens, name)
	nested = record.get("nested")
	children = nested.get("children", []) if isinstance(nested, dict) else []
	if not isinstance(children, list):
		children = []
	for child in children:
		child_tokens = child.get("tokens") if isinstance(child, dict) else None
		for name in NESTED_TOKEN_SUM_FIELDS:
			accumulator["nested_tokens"][name] += sum_tokens_field(child_tokens, name)
	cost = record.get("cost")
	if isinstance(cost, dict) and cost.get("source") == "reported":
		accumulator["cost_reported"] += 1
		amount = cost.get("amount")
		if is_amount(amount):
			accumulator["cost_amount_sum"] = (accumulator["cost_amount_sum"] or 0.0) + amount
		else:
			warn(f"{label}: reported cost without a usable amount, contributing zero to the sum")
	else:
		accumulator["cost_unreported"] += 1
	duration = record.get("duration_ms")
	if is_count(duration):
		accumulator["duration_ms_total"] += duration
	attribution = record.get("attribution")
	if isinstance(attribution, dict):
		confidence = attribution.get("confidence")
		if confidence in accumulator["attribution_confidence_histogram"]:
			accumulator["attribution_confidence_histogram"][confidence] += 1
		else:
			warn(f"{label}: attribution confidence {confidence!r} outside the contract classes, unclassified")
		unit_id = attribution.get("unit_id")
		if isinstance(unit_id, str) and unit_id:
			accumulator["unit_ids"].add(unit_id)
			accumulator["unit_invocation_counts"][unit_id] = \
				accumulator["unit_invocation_counts"].get(unit_id, 0) + 1
	else:
		warn(f"{label}: invocation without an attribution object, no attribution class recorded")


def evaluate_budget_flags(declared, accumulator):
	"""The over_budget dimensions: declared non-null and actual exceeds it.

	Actuals are the contract's pinned comparisons; a null actual (no
	reported cost) never flags its dimension.
	"""
	actuals = {
		"tokens": accumulator["tokens"]["input"] + accumulator["tokens"]["output"],
		"cost": accumulator["cost_amount_sum"],
		"wall_clock": accumulator["duration_ms_total"],
		"requests": accumulator["invocation_count"],
	}
	return [dimension for dimension in BUDGET_DIMENSIONS
		if declared.get(BUDGET_DECLARED_KEYS[dimension]) is not None
		and actuals[dimension] is not None
		and actuals[dimension] > declared[BUDGET_DECLARED_KEYS[dimension]]]


def build_unit_rollup(unit_id, batch_id, accumulator, generated_at, runtime_ms):
	"""One unit_rollup record from an accumulator (schema 1.0 plus the additive runtime_ms)."""
	return {
		"schema_version": SCHEMA_VERSION,
		"record_type": "unit_rollup",
		"unit_id": unit_id,
		"batch_id": batch_id,
		"generated_at": generated_at,
		"invocation_count": accumulator["invocation_count"],
		"retry_count": accumulator["retry_count"],
		"restart_count": accumulator["restart_count"],
		"stop_reason_histogram": dict(sorted(accumulator["stop_reason_histogram"].items())),
		"tokens": dict(accumulator["tokens"]),
		"nested_tokens": dict(accumulator["nested_tokens"]),
		"cost": {
			"amount_sum": accumulator["cost_amount_sum"],
			"reported_count": accumulator["cost_reported"],
			"unreported_count": accumulator["cost_unreported"],
		},
		"duration_ms_total": accumulator["duration_ms_total"],
		"attribution_confidence_histogram": dict(accumulator["attribution_confidence_histogram"]),
		"runtime_ms": runtime_ms,
	}


def build_batch_rollup(batch_id, declared, accumulator, generated_at, runtime_ms,
		yield_tally):
	"""One batch_rollup record from an accumulator (schema 1.0 plus the additive runtime_ms)."""
	record = {
		"schema_version": SCHEMA_VERSION,
		"record_type": "batch_rollup",
		"batch_id": batch_id,
		"generated_at": generated_at,
		"unit_count": len(accumulator["unit_ids"]),
		"invocation_count": accumulator["invocation_count"],
		"stop_reason_histogram": dict(sorted(accumulator["stop_reason_histogram"].items())),
		"tokens": dict(accumulator["tokens"]),
		"nested_tokens": dict(accumulator["nested_tokens"]),
		"cost": {
			"amount_sum": accumulator["cost_amount_sum"],
			"reported_count": accumulator["cost_reported"],
			"unreported_count": accumulator["cost_unreported"],
		},
		"duration_ms_total": accumulator["duration_ms_total"],
		"budget": {
			"declared": {
				"tokens": declared.get("tokens"),
				"cost": declared.get("cost"),
				"wall_clock_ms": declared.get("wall_clock_ms"),
				"requests": declared.get("requests"),
			},
			"over_budget": evaluate_budget_flags(declared, accumulator),
		},
		"runtime_ms": runtime_ms,
	}
	if yield_tally is not None:
		record["yield_tally"] = yield_tally
	return record


def parse_budget(declared, value_text):
	"""Parse one --budget dimension=value; usage error on a malformed pair or value."""
	parts = value_text.split("=", 1)
	if len(parts) != 2 or not parts[0] or not parts[1]:
		raise UsageError(f"--budget expects dimension=value, got {value_text!r}")
	name, value_text = parts
	if name not in BUDGET_FLAG_NAMES:
		raise UsageError(f"--budget dimension {name!r} unknown "
			f"(known: {', '.join(BUDGET_FLAG_NAMES)})")
	try:
		value = float(value_text) if "." in value_text else int(value_text)
	except ValueError:
		raise UsageError(f"--budget {name} expects a number, got {value_text!r}")
	if not is_amount(value) or value < 0:
		raise UsageError(f"--budget {name} expects a nonnegative number, got {value_text!r}")
	if name in ("wall_clock_ms", "requests") and not is_count(value):
		raise UsageError(f"--budget {name} expects a nonnegative integer, got {value_text!r}")
	declared[name] = value


def load_yield_tally(path):
	"""Load and shape-check a --yield-tally file; usage error on any gap.

	The contract requires every count field, a nullable time_to_close_ms
	and batch_cost_total, at least one source link, a non-empty
	covered_units list, and a non-empty count_basis note per counted
	field; the rollup refuses to embed an incomplete tally rather than
	emit one silently.
	"""
	try:
		with open(Path(path).expanduser(), encoding="utf-8") as handle:
			tally = json.load(handle)
	except (OSError, json.JSONDecodeError) as exc:
		raise UsageError(f"--yield-tally {path} is unreadable or not valid JSON: {exc}")
	if not isinstance(tally, dict):
		raise UsageError(f"--yield-tally {path} must be a JSON object")
	severities = tally.get("verifier_findings_by_severity")
	if not isinstance(severities, dict) or not all(
			isinstance(key, str) and key and is_count(value)
			for key, value in severities.items()):
		raise UsageError(f"--yield-tally {path}: verifier_findings_by_severity must map "
			"severity names to nonnegative integer counts")
	for field in YIELD_TALLY_COUNT_FIELDS:
		if not is_count(tally.get(field)):
			raise UsageError(f"--yield-tally {path}: {field} must be a nonnegative integer")
	for field in ("time_to_close_ms", "batch_cost_total"):
		value = tally.get(field)
		if value is not None and not (is_count(value) or (field == "batch_cost_total"
				and is_amount(value) and value >= 0)):
			raise UsageError(f"--yield-tally {path}: {field} must be a nonnegative number or null")
	links = tally.get("source_links")
	if not isinstance(links, list) or not links or not all(
			isinstance(link, str) and link for link in links):
		raise UsageError(f"--yield-tally {path}: source_links must be a nonempty list "
			"of report links; every count names its source")
	covered = tally.get("covered_units")
	if not isinstance(covered, list) or not covered or not all(
			isinstance(unit, str) and unit for unit in covered):
		raise UsageError(f"--yield-tally {path}: covered_units must be a nonempty list "
			"of unit ids naming the scope the counts were compiled over")
	basis = tally.get("count_basis")
	if not isinstance(basis, dict) or not all(
			isinstance(basis.get(field), str) and basis.get(field)
			for field in YIELD_TALLY_BASIS_FIELDS):
		raise UsageError(f"--yield-tally {path}: count_basis must map every counted field "
			f"({', '.join(YIELD_TALLY_BASIS_FIELDS)}) to a non-empty note naming the "
			"board entries the count came from")
	return tally


def read_invocation_ledger(path):
	"""Read a ledger into invocation records; other record types and malformed lines warn and skip.

	Returns (records, skipped_other, skipped_malformed). A ledger with
	no invocation records yields an empty list; the caller decides the
	exit ladder (nothing is written for an aggregation with no records,
	because an empty ledger is contract-invalid).
	"""
	try:
		with open(Path(path).expanduser(), encoding="utf-8") as handle:
			lines = handle.read().splitlines()
	except (OSError, UnicodeDecodeError) as exc:
		raise UsageError(f"cannot read ledger {path}: {exc}")
	records = []
	skipped_other = 0
	skipped_malformed = 0
	for number, raw in enumerate(lines, start=1):
		if not raw.strip():
			continue
		try:
			record = json.loads(raw)
		except json.JSONDecodeError as exc:
			warn(f"ledger line {number} is not valid JSON ({exc.msg}), skipped")
			skipped_malformed += 1
			continue
		if not isinstance(record, dict):
			warn(f"ledger line {number} is not a JSON object, skipped")
			skipped_malformed += 1
			continue
		if record.get("record_type") != "invocation":
			warn(f"ledger line {number} is a {record.get('record_type')!r} record, "
				"not an invocation; rollup aggregates invocations only, skipped")
			skipped_other += 1
			continue
		records.append(record)
	return records, skipped_other, skipped_malformed


def parse_rollup_args(argv):
	options = {
		"ledger": None,
		"out": None,
		"declared": {},
		"yield_tally_path": None,
		"update_cursor": None,
		"print_cursor": None,
		"harness": None,
		"unit": None,
	}
	value_flags = {
		"--ledger": "ledger",
		"--out": "out",
		"--yield-tally": "yield_tally_path",
		"--update-cursor": "update_cursor",
		"--print-cursor": "print_cursor",
		"--harness": "harness",
		"--unit": "unit",
	}
	index = 0
	while index < len(argv):
		flag = argv[index]
		if flag in ("--help", "-h"):
			raise HelpRequested()
		if flag == "--budget":
			if index + 1 >= len(argv):
				raise UsageError("--budget requires a value")
			parse_budget(options["declared"], argv[index + 1])
			index += 1
		elif flag in value_flags:
			if index + 1 >= len(argv):
				raise UsageError(f"{flag} requires a value")
			options[value_flags[flag]] = argv[index + 1]
			index += 1
		else:
			raise UsageError(f"unknown option {flag!r}")
		index += 1
	if options["harness"] is not None and options["harness"] not in CURSOR_HARNESSES:
		raise UsageError(f"--harness must be one of {', '.join(CURSOR_HARNESSES)}")
	if options["harness"] is not None and options["print_cursor"] is None:
		raise UsageError("--harness is a --print-cursor companion: give --print-cursor FILE")
	if options["print_cursor"] is not None and options["ledger"] is not None:
		raise UsageError("--print-cursor prints stored cursors and reads no ledger: "
			"drop --ledger or run the aggregation without --print-cursor")
	if options["unit"] is not None and (not isinstance(options["unit"], str) or not options["unit"]):
		raise UsageError("--unit expects a non-empty unit id")
	return options


def read_cursor_file(path):
	"""Read a cursor file into {harness: epoch_ms}; absent starts fresh, corrupt warns.

	A present but unreadable or non-object file warns and starts fresh:
	the rollup still runs, but the lost high-water marks reset
	incrementality for every harness, and the warning keeps that state
	loss visible instead of silent. An absent file is the legitimate
	first-pass form and stays quiet.
	"""
	try:
		with open(Path(path).expanduser(), encoding="utf-8") as handle:
			cursors = json.load(handle)
	except FileNotFoundError:
		return {}
	except (OSError, json.JSONDecodeError) as exc:
		warn(f"cursor file {path} is present but unreadable ({exc}); starting fresh")
		return {}
	if not isinstance(cursors, dict):
		warn(f"cursor file {path} is not a JSON object; starting fresh")
		return {}
	return {harness: cursors[harness] for harness in CURSOR_HARNESSES
		if is_count(cursors.get(harness))}


def merge_cursors(existing, records):
	"""The monotonic per-harness high-water timestamps of the rolled records over any existing cursors."""
	cursors = dict(existing)
	for record in records:
		harness = record.get("harness")
		moment = iso_to_epoch_ms(record.get("timestamp"))
		if harness in CURSOR_HARNESSES and moment is not None \
				and moment > cursors.get(harness, 0):
			cursors[harness] = moment
	return cursors


def iso_to_epoch_ms(text):
	"""Parse an RFC3339 timestamp to epoch milliseconds, None when unusable."""
	if not isinstance(text, str):
		return None
	normalized = text[:-1] + "+00:00" if text.endswith("Z") else text
	try:
		parsed = datetime.fromisoformat(normalized)
	except ValueError:
		return None
	if parsed.tzinfo is None:
		parsed = parsed.replace(tzinfo=timezone.utc)
	return int(parsed.timestamp() * 1000)


def print_rollup_digest(batches, unbatched_units, orphan_count):
	"""The stderr digest: per batch one summary, histogram, cost line, and
	over-budget(<dimension>) flags; then any unbatched units and orphans."""
	for batch_id, accumulator, flags in batches:
		print(f"task-metrics rollup: batch {batch_id}: {len(accumulator['unit_ids'])} unit(s), "
			f"{accumulator['invocation_count']} invocation(s), retries {accumulator['retry_count']}, "
			f"restarts {accumulator['restart_count']}", file=sys.stderr)
		histogram = accumulator["stop_reason_histogram"]
		if histogram:
			rendered = " ".join(f"{reason}={count}"
				for reason, count in sorted(histogram.items()))
			print(f"task-metrics rollup: batch {batch_id} stop reasons: {rendered}", file=sys.stderr)
		units_rendered = " ".join(
			f"{unit} ({accumulator['unit_invocation_counts'].get(unit, 0)} invocations)"
			for unit in sorted(accumulator["unit_ids"]))
		print(f"task-metrics rollup: batch {batch_id} units: {units_rendered or 'none attributed'}",
			file=sys.stderr)
		amount = accumulator["cost_amount_sum"]
		cost_text = f"{amount:.6g}" if amount is not None else "none reported"
		print(f"task-metrics rollup: batch {batch_id} cost: {cost_text} "
			f"({accumulator['cost_reported']}/{accumulator['invocation_count']} reported), "
			f"duration total {accumulator['duration_ms_total']} ms", file=sys.stderr)
		if flags:
			print(f"task-metrics rollup: batch {batch_id} "
				+ " ".join(f"over-budget({dimension})" for dimension in flags), file=sys.stderr)
	for unit_id, accumulator in unbatched_units:
		print(f"task-metrics rollup: unit {unit_id}: {accumulator['invocation_count']} invocation(s), "
			"no batch declared", file=sys.stderr)
	if orphan_count:
		print(f"task-metrics rollup: {orphan_count} invocation(s) outside every rollup "
			"(no unit and no batch)", file=sys.stderr)


def run_rollup(argv):
	"""Run the rollup aggregation; returns the process exit code."""
	try:
		options = parse_rollup_args(argv)
	except HelpRequested:
		print(__doc__, file=sys.stdout)
		return 0
	except UsageError as exc:
		print(f"task-metrics rollup: {exc}", file=sys.stderr)
		return 2
	if options["print_cursor"] is not None:
		cursors = read_cursor_file(options["print_cursor"])
		if options["harness"] is not None:
			if options["harness"] not in cursors:
				print(f"task-metrics rollup: cursor file {options['print_cursor']} "
					f"carries no {options['harness']} value", file=sys.stderr)
				return 2
			print(cursors[options["harness"]])
		else:
			print(json.dumps(cursors, separators=(",", ":"), sort_keys=True))
		return 0
	started = datetime.now(tz=timezone.utc)
	try:
		records, skipped_other, skipped_malformed = read_invocation_ledger(
			options["ledger"] if options["ledger"] is not None else "/dev/stdin")
	except UsageError as exc:
		print(f"task-metrics rollup: {exc}", file=sys.stderr)
		return 2
	if not records:
		print("task-metrics rollup: no invocation records in the given ledger; "
			"an empty ledger is contract-invalid, nothing rolled", file=sys.stderr)
		return 1
	yield_tally = None
	if options["yield_tally_path"] is not None:
		try:
			yield_tally = load_yield_tally(options["yield_tally_path"])
		except UsageError as exc:
			print(f"task-metrics rollup: {exc}", file=sys.stderr)
			return 2
	batches = {}
	units = {}
	orphan_count = 0
	for position, record in enumerate(records, start=1):
		label = f"ledger record {position}"
		attribution = record.get("attribution") if isinstance(record.get("attribution"), dict) else {}
		batch_id = attribution.get("batch_id")
		batch_id = batch_id if isinstance(batch_id, str) and batch_id else None
		unit_id = attribution.get("unit_id")
		unit_id = unit_id if isinstance(unit_id, str) and unit_id else None
		if unit_id is None and options["unit"] is not None:
			# The pass ran over the declared unit's territory: its unattributed
			# strays count toward that unit's rollup instead of vanishing.
			unit_id = options["unit"]
		if batch_id is not None:
			batches.setdefault(batch_id, new_rollup_accumulator())
			accumulate_invocation(batches[batch_id], record, label)
		if unit_id is not None:
			key = (unit_id, batch_id)
			units.setdefault(key, new_rollup_accumulator())
			accumulate_invocation(units[key], record, label)
		elif batch_id is None:
			orphan_count += 1
	generated_at = rfc3339_utc(int(started.timestamp() * 1000))
	runtime_ms = max(0, int((datetime.now(tz=timezone.utc) - started).total_seconds() * 1000))
	batch_records = []
	for batch_id in sorted(batches):
		batch_records.append(build_batch_rollup(batch_id, options["declared"],
			batches[batch_id], generated_at, runtime_ms, yield_tally))
	unit_records = []
	for key in sorted(units, key=lambda item: (item[0], item[1] or "")):
		unit_records.append(build_unit_rollup(key[0], key[1], units[key],
			generated_at, runtime_ms))
	emitted = unit_records + batch_records
	if not emitted and orphan_count > 0:
		print(f"task-metrics rollup: aggregation produced nothing: all {orphan_count} "
			"invocation(s) carry neither unit_id nor batch_id, no rollup emitted",
			file=sys.stderr)
		return 1
	lines = "".join(json.dumps(record, separators=(",", ":")) + "\n" for record in emitted)
	if options["out"] is None:
		sys.stdout.write(lines)
	else:
		try:
			with open(Path(options["out"]).expanduser(), "a", encoding="utf-8") as ledger:
				ledger.write(lines)
		except OSError as exc:
			print(f"task-metrics rollup: cannot write {options['out']}: {exc}", file=sys.stderr)
			return 2
	if options["update_cursor"] is not None:
		cursors = merge_cursors(read_cursor_file(options["update_cursor"]), records)
		try:
			with open(Path(options["update_cursor"]).expanduser(), "w", encoding="utf-8") as handle:
				handle.write(json.dumps(cursors, separators=(",", ":"), sort_keys=True) + "\n")
		except OSError as exc:
			print(f"task-metrics rollup: cannot write cursor file "
				f"{options['update_cursor']}: {exc}", file=sys.stderr)
			return 2
	digest_batches = [(record["batch_id"], batches[record["batch_id"]],
			record["budget"]["over_budget"]) for record in batch_records]
	digest_units = [(key[0], units[key]) for key in sorted(units) if key[1] is None]
	print_rollup_digest(digest_batches, digest_units, orphan_count)
	print(f"task-metrics rollup: {len(unit_records)} unit rollup(s), {len(batch_records)} "
		f"batch rollup(s) from {len(records)} invocation(s) in {runtime_ms} ms "
		f"({skipped_other} non-invocation and {skipped_malformed} malformed line(s) skipped)",
		file=sys.stderr)
	return 0


def parse_ac12_args(argv):
	options = {"results": None, "phase": None, "harness": None, "out": None}
	value_flags = {
		"--results": "results",
		"--phase": "phase",
		"--harness": "harness",
		"--out": "out",
	}
	index = 0
	while index < len(argv):
		flag = argv[index]
		if flag in ("--help", "-h"):
			raise HelpRequested()
		if flag in value_flags:
			if index + 1 >= len(argv):
				raise UsageError(f"{flag} requires a value")
			options[value_flags[flag]] = argv[index + 1]
			index += 1
		else:
			raise UsageError(f"unknown option {flag!r}")
		index += 1
	if options["results"] is None:
		raise UsageError("--results FILE is required: the probe's five-family results JSON")
	if options["phase"] not in AC12_PHASES:
		raise UsageError(f"--phase must be one of {', '.join(AC12_PHASES)}")
	if options["harness"] not in CURSOR_HARNESSES:
		raise UsageError(f"--harness must be one of {', '.join(CURSOR_HARNESSES)}")
	return options


def build_ac12_snapshot(results, phase, harness, generated_at):
	"""Shape-check probe results into an ac12_snapshot record; UsageError names the gap.

	The contract fixes exactly the five family keys, each carrying a
	non-empty method and source, a values map of metric names to numbers
	or null, and a nullable notes string; anything else refuses rather
	than emitting an invalid snapshot.
	"""
	if not isinstance(results, dict):
		raise UsageError("probe results must be a JSON object with a families object")
	families_in = results.get("families")
	if not isinstance(families_in, dict):
		raise UsageError("probe results must carry a families object")
	unexpected = sorted(set(families_in) - set(AC12_FAMILIES))
	if unexpected:
		raise UsageError(f"probe results carry unknown families {unexpected} "
			f"(known: {', '.join(AC12_FAMILIES)})")
	missing = [family for family in AC12_FAMILIES if family not in families_in]
	if missing:
		raise UsageError(f"probe results are missing families {missing}")
	families = {}
	for family in AC12_FAMILIES:
		spec = families_in[family]
		if not isinstance(spec, dict):
			raise UsageError(f"family {family} must be an object")
		for field in ("method", "source"):
			if not isinstance(spec.get(field), str) or not spec[field]:
				raise UsageError(f"family {family} must carry a non-empty {field}")
		values_in = spec.get("values")
		if not isinstance(values_in, dict):
			raise UsageError(f"family {family} must carry a values object")
		values = {}
		for name, value in values_in.items():
			if not isinstance(name, str) or not name:
				raise UsageError(f"family {family} carries an empty metric name")
			if value is not None and not is_amount(value):
				raise UsageError(f"family {family} value {name!r} must be a number or null, "
					f"got {value!r}")
			values[name] = value
		notes = spec.get("notes")
		if notes is not None and not isinstance(notes, str):
			raise UsageError(f"family {family} notes must be a string or null")
		families[family] = {
			"method": spec["method"],
			"source": spec["source"],
			"values": values,
			"notes": notes,
		}
	return {
		"schema_version": SCHEMA_VERSION,
		"record_type": "ac12_snapshot",
		"generated_at": generated_at,
		"phase": phase,
		"harness": harness,
		"families": families,
	}


def run_ac12(argv):
	"""Run the ac12 snapshot emission; returns the process exit code."""
	try:
		options = parse_ac12_args(argv)
	except HelpRequested:
		print(__doc__, file=sys.stdout)
		return 0
	except UsageError as exc:
		print(f"task-metrics ac12: {exc}", file=sys.stderr)
		return 2
	try:
		with open(Path(options["results"]).expanduser(), encoding="utf-8") as handle:
			results = json.load(handle)
	except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
		print(f"task-metrics ac12: cannot read results {options['results']}: {exc}", file=sys.stderr)
		return 2
	try:
		record = build_ac12_snapshot(results, options["phase"], options["harness"],
			rfc3339_utc(int(datetime.now(tz=timezone.utc).timestamp() * 1000)))
	except UsageError as exc:
		print(f"task-metrics ac12: {exc}", file=sys.stderr)
		return 2
	line = json.dumps(record, separators=(",", ":")) + "\n"
	if options["out"] is None:
		sys.stdout.write(line)
	else:
		try:
			with open(Path(options["out"]).expanduser(), "a", encoding="utf-8") as ledger:
				ledger.write(line)
		except OSError as exc:
			print(f"task-metrics ac12: cannot write {options['out']}: {exc}", file=sys.stderr)
			return 2
	print(f"task-metrics ac12: {options['phase']} snapshot for {options['harness']} "
		"emitted", file=sys.stderr)
	return 0


def run_pi(argv):
	"""Parse pi mode arguments and run the extraction; returns the exit code."""
	parser = argparse.ArgumentParser(
		prog="task-metrics pi",
		description="Extract invocation records from a pi session store "
			"into the metrics ledger (schema 1.0).")
	parser.add_argument("--session-dir", default=None,
		help="pi session root (default: $PI_CODING_AGENT_SESSION_DIR, "
			f"else {PI_SESSION_ROOT})")
	parser.add_argument("--engine-log", default=None,
		help="pi-continue engine.log (default under $PI_CONTINUE_STATE_DIR, "
			f"else {PI_CONTINUE_STATE_DIR}/engine.log)")
	parser.add_argument("--batch-id", default=None,
		help="stamp every record's attribution.batch_id with this batch")
	parser.add_argument("--output", default=None,
		help="append records to this JSONL file (default: stdout)")
	args = parser.parse_args(argv)
	return cmd_pi(args)


def main(argv):
	if len(argv) < 2:
		print(USAGE_TEXT, file=sys.stderr)
		return 2
	mode, rest = argv[1], argv[2:]
	if mode in ("--help", "-h"):
		print(USAGE_TEXT, file=sys.stdout)
		return 0
	if mode == "oc":
		return run_oc(rest)
	if mode == "pi":
		return run_pi(rest)
	if mode == "rollup":
		return run_rollup(rest)
	if mode == "ac12":
		return run_ac12(rest)
	print(f"task-metrics: unknown mode {mode!r} (known: {', '.join(MODES)})",
		file=sys.stderr)
	return 2


if __name__ == "__main__":
	sys.exit(main(sys.argv))
