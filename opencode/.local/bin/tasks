#!/usr/bin/env bash
#
# tasks - concurrency-safe board tool for the .tasks/ task-file protocol.
#
# The dashboard is a derived artifact: `render` rebuilds it from the task
# files under a process-held flock on .tasks/.lock, so concurrent sessions
# serialize harmlessly and never lose an update. Task ownership is claimed
# atomically via an O_EXCL sidecar (<taskfile>.claim), never by editing a
# text field. Bulky agent reports are deposited under
# .tasks/reports/<taskfile>/NN-<slug>.md by `tasks report` under the same
# lock and linked from the Work Log with a one-line digest. See
# ~/.agents/skills/task-files/SKILL.md, section
# "Concurrency and Multi-Session Safety".

set -euo pipefail

readonly LOCK_NAME=".lock"
readonly DASHBOARD_NAME="dashboard.md"
readonly CURRENT_DIR="current"
readonly ARCHIVE_DIR="archive"
readonly REPORTS_DIR="reports"
readonly CLAIM_SUFFIX=".claim"

# Keyed rows travel from the assembler through one LC_ALL=C sort as
# "<ordinal><SORT_SEP><sortkey><SORT_SEP><idkey><SORT_SEP><row>"; the
# ordinal is the lane's dashboard position, so byte order groups lanes in
# board order and orders rows within a lane by their keys.
readonly SORT_SEP=$'\034'

# Section headers for the six dashboard lanes, indexed by the lane ordinal
# the row assembler emits (lane 7 is the latest-updated tag and has none).
# Each string carries the exact bytes of the old per-lane printf block,
# including the blank separator line ahead of lanes 2-6, so the render can
# print them straight through before each lane's first row.
readonly -a LANE_HEADERS=("" \
	$'## Triage\n\n| Task | Priority | Created | Updated |\n|------|----------|---------|---------|\n' \
	$'\n## Ready\n\n| Task | Priority | Created | Updated |\n|------|----------|---------|---------|\n' \
	$'\n## In Progress\n\n| Task | Progress | Updated | Priority |\n|------|----------|---------|----------|\n' \
	$'\n## Blocked/Cancelled\n\n| Task | Status | Created | Updated |\n|------|--------|---------|---------|\n' \
	$'\n## Completed\n\n| Task | Completed | Duration |\n|------|-----------|----------|\n' \
	$'\n## Archive\n\n| Task | Completed | Duration |\n|------|-----------|----------|\n')
# The assembler's trailing line carries the newest-Updated value, not a
# lane row; this is its ordinal.
readonly LANE_LATEST=7

# Rows without a derivable date sort after every dated row in their
# lane. Relies on header dates arriving in canonical
# "YYYY-MM-DD HH:MM" form, which byte-sorts chronologically, so the
# sentinel lands last; a malformed hand-edited value may sort
# elsewhere in its lane, but still deterministically.
readonly UNDATED_SORT_KEY="9999-99-99 99:99"
# Each ID segment is zero-padded to this width in the sort key, so byte
# order equals numeric order for any plausible sequential numbering.
readonly ID_KEY_SEGMENT_WIDTH=6

readonly STATUS_TRIAGE="Triage"
readonly STATUS_READY="Ready"
readonly STATUS_IN_PROGRESS="In Progress"
readonly STATUS_BLOCKED="Blocked"
readonly STATUS_CANCELLED="Cancelled"
readonly STATUS_COMPLETED="Completed"

# The header contract ties Status Reason to Blocked/Cancelled only (the
# task-files skill's Task File Template); set refuses the no-space variant
# and every other misspelling via the canonical-key whitelist.
readonly STATUS_REASON_KEY="Status Reason"

# The sections the task-files skill's Task File Template defines, in the
# order they must appear. tasks edit creates a missing section from this
# list at its canonical slot (before its first present successor) and
# refuses sections outside it; the template's planning sections live
# between Success Criteria and Work Log, which is exactly the slot the
# tasks-new scaffold omits.
readonly -a TEMPLATE_SECTIONS=("Table of Contents" "Objective" "Success Criteria" "Technical Approach" "Risk Assessment" "Testing Strategy" "TDD Workflow" "Task Breakdown" "Work Log" "Execution Log")
readonly TEMPLATE_SECTION_LEVEL=2

# Shared awk function source: parse the current line's markdown heading
# level (0 when the line is not a level-1..6 heading followed by a space),
# setting HTEXT to the heading text with trailing whitespace stripped.
# Concatenated ahead of the program body in the three heading-delimited
# passes below (section_level, replace_section_body, insert_section_body),
# so the heading parser exists exactly once.
readonly AWK_HEADING_LEVEL='		function heading_level(    h) {
			HTEXT = ""
			if (substr($0, 1, 1) != "#") return 0
			h = 0
			while (substr($0, h + 1, 1) == "#") h++
			if (h > 6 || substr($0, h + 1, 1) != " ") return 0
			HTEXT = substr($0, h + 2)
			sub(/[ \t\r]+$/, "", HTEXT)
			return h
		}
'

readonly DEFAULT_PRIORITY="Medium"
readonly DEFAULT_STATUS="$STATUS_TRIAGE"
readonly DEFAULT_FROM="Manager"
readonly DEFAULT_TAIL="10"
readonly NA="N/A"
readonly STATUS_VALUES="$STATUS_TRIAGE, $STATUS_READY, $STATUS_IN_PROGRESS, $STATUS_BLOCKED, $STATUS_CANCELLED, $STATUS_COMPLETED"
# The header fields the task-file template defines, in the canonical order
# the new-task scaffold lays them out in: valid_header_key checks membership
# against this list, HEADER_FIELDS is derived from it for error messages,
# and the header writers insert an absent field before the first present
# field that canonically follows it, so delete/re-insert cycles keep the
# header order stable.
readonly -a TEMPLATE_HEADER_FIELDS=("Created" "Status" "$STATUS_REASON_KEY" "Priority" "Progress" "Owner" "Checkpoint Gating" "Updated" "Completed" "Duration" "Latest Update")

# Comma-separated form of TEMPLATE_HEADER_FIELDS for error messages.
_header_fields_list() {
	local fields
	fields="$(printf '%s, ' "$@")"
	printf '%s' "${fields%, }"
}
readonly HEADER_FIELDS="$(_header_fields_list "${TEMPLATE_HEADER_FIELDS[@]}")"

err() { printf 'tasks: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }
now() { date '+%Y-%m-%d %H:%M'; }

# The Status vocabulary is fixed; new/set must reject anything else.
valid_status() {
	case "$1" in
		"$STATUS_TRIAGE"|"$STATUS_READY"|"$STATUS_IN_PROGRESS"|"$STATUS_BLOCKED"|"$STATUS_CANCELLED"|"$STATUS_COMPLETED") return 0 ;;
		*) return 1 ;;
	esac
}

# Task IDs are PREFIX-N with optional hierarchical -N segments (LRU-4,
# LRU-4-2). The ID leads the filename, so anything outside this shape
# (spaces, slashes, glob characters) must never reach a path.
valid_task_id() {
	[[ "$1" =~ ^[A-Za-z]+(-[0-9]+)+$ ]]
}

# The header keys `tasks set` may write are exactly the fields the task-file
# template defines (see the task-files skill's Task File Template). A near
# miss like "StatusReason" must be rejected, not inserted as a new field.
valid_header_key() {
	local candidate
	for candidate in "${TEMPLATE_HEADER_FIELDS[@]}"; do
		[[ "$1" == "$candidate" ]] && return 0
	done
	return 1
}

# Report slugs become filename segments under reports/; strict kebab-case
# keeps that namespace path-safe (no dots, slashes, or case drift).
valid_slug() { [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; }

# A stable per-session identifier for claims. Callers may override with
# --owner or TASKS_SESSION; the pid fallback keeps distinct shells distinct.
session_id() { printf '%s' "${TASKS_SESSION:-$(hostname -s 2>/dev/null || hostname)-$$}"; }

usage() {
	cat <<'EOF'
Usage: tasks <command> [options]

Commands:
  init [--dir DIR]                     Scaffold a .tasks/ directory and empty board.
  render [--dir DIR]                   Rebuild dashboard.md from the task files (locked).
  new --id ID --name NAME [opts]       Create a task file with canonical header fields.
                                       opts: --status S --priority P --dir DIR
  set [--dir DIR] <taskfile> K=V...    Update header field(s), refresh Updated, render.
  report [--dir DIR] <taskfile> --slug SLUG [--from WORKER] --digest TEXT [<file>|-]
                                       Deposit a report file under reports/ and
                                       link it from the Work Log (locked).
  log [--dir DIR] <taskfile> [--from WORKER] MSG
                                       Append a Work Log entry attributed to
                                       WORKER (default Manager), render.
  edit [--dir DIR] <taskfile> --section HEADING [--append] [<file>|-]
                                       Replace or append a section body from
                                       <file> or stdin, refresh Updated, render
                                       (locked).
  show [--dir DIR] <taskfile> [--tail N]
                                       Print header fields, Latest Update, and
                                       the last N Work Log entries (default 10).
  claim <taskfile> [--owner ID]        Atomically claim a task (O_EXCL sidecar), render.
  release <taskfile>                   Release a claim and clear Owner, render.
  help                                 Show this help.

Options accept "--flag VALUE" or "--flag=VALUE"; only the = form can pass
a value that itself begins with "--" (e.g. --name=--force).

The .tasks/ directory is located from --dir, then $TASKS_DIR, then by walking
up from the current directory, then ./.tasks as a last resort.
EOF
}

# Resolve the .tasks directory: explicit value wins, else search upward, else default.
resolve_tasks_dir() {
	local explicit="${1:-}"
	if [[ -n "$explicit" ]]; then printf '%s' "$explicit"; return; fi
	if [[ -n "${TASKS_DIR:-}" ]]; then printf '%s' "$TASKS_DIR"; return; fi
	local dir="$PWD"
	while [[ "$dir" != "/" ]]; do
		if [[ -d "$dir/.tasks" ]]; then printf '%s' "$dir/.tasks"; return; fi
		dir="$(dirname "$dir")"
	done
	printf '%s' "$PWD/.tasks"
}

# Resolve a task file argument to a real path: as given, or under current/, or archive/.
resolve_task_file() {
	local tasks_dir="$1" arg="$2"
	if [[ -f "$arg" ]]; then printf '%s' "$arg"; return; fi
	if [[ -f "$tasks_dir/$CURRENT_DIR/$arg" ]]; then printf '%s' "$tasks_dir/$CURRENT_DIR/$arg"; return; fi
	if [[ -f "$tasks_dir/$ARCHIVE_DIR/$arg" ]]; then printf '%s' "$tasks_dir/$ARCHIVE_DIR/$arg"; return; fi
	die "task file not found: $arg"
}

# Print the header region of a task file from stdin: everything before the
# first "## " heading.
header_of() { awk '/^## /{exit} {print}'; }

# Extract a "**Key:** value" field from a header block supplied on stdin.
header_field() {
	local key="$1"
	grep -m1 -oP "^\\*\\*${key}:\\*\\*[[:space:]]+\\K.*" || true
}

# Assemble each task file's dashboard row in one batched awk process: for
# every file named as an argument, emit one line
# "<lane><SORT_SEP><sortkey><SORT_SEP><idkey><SORT_SEP><row>", where <lane>
# is the dashboard ordinal (1 Triage, 2 Ready, 3 In Progress, 4
# Blocked/Cancelled, 5 Completed, 6 Archive). Paths are relative to the
# board ("<subdir>/<name>.md"), which both fixes the lane subdir and
# identifies the file across the two subdirs; the caller's tasks_dir is
# prefixed back on for reading. This performs
# the whole per-file assembly the render loop used to do in bash: header
# extraction (first occurrence wins, the decorative "*Created: ...*" line
# as the Created fallback), cell escaping (backslash first, then pipes
# and brackets, whitespace collapsed), Task ID derivation from the
# filename's leading ID component, segment-numeric ID sort keys, progress
# normalization, lane selection, and the newest-Updated maximum, which is
# emitted as the final line "7<SORT_SEP><newest>" (ordinal 7 is the
# latest-updated tag, not a lane). Each file is read up to its first
# "## " heading, an empty file yielding the bare defaults.
# Explicit character classes and capture-free matching throughout: mawk
# lacks [[:space:]] and capture arrays, so the program stays inside the
# gawk/mawk intersection.
assemble_rows() {
	# Values travel via the environment (not awk -v) so backslash-bearing
	# paths survive verbatim; the AWK_ prefix avoids the shell's own
	# readonly constant names.
	AWK_NA="$NA" AWK_DEFAULT_PRIORITY="$DEFAULT_PRIORITY" AWK_UNDATED="$UNDATED_SORT_KEY" \
		AWK_TASKS_DIR="$tasks_dir" AWK_CURRENT_DIR="$CURRENT_DIR" AWK_ARCHIVE_DIR="$ARCHIVE_DIR" \
		AWK_ID_KEY_WIDTH="$ID_KEY_SEGMENT_WIDTH" \
		AWK_READY="$STATUS_READY" AWK_IN_PROGRESS="$STATUS_IN_PROGRESS" \
		AWK_BLOCKED="$STATUS_BLOCKED" AWK_CANCELLED="$STATUS_CANCELLED" \
		AWK_COMPLETED="$STATUS_COMPLETED" \
		awk '
		function mdescape(s) {
			gsub(/\\/, "&&", s)
			gsub(/\n/, " ", s)
			gsub(/\r/, " ", s)
			gsub(/\|/, "\\|", s)
			gsub(/\[/, "\\[", s)
			gsub(/\]/, "\\]", s)
			return s
		}
		function normprog(p) {
			sub(/%$/, "", p)
			gsub("[" wsp "]", "", p)
			if (p == "") p = "0"
			return p "%"
		}
		# The Task ID mirrors the greedy capture of the bash render regex
		# with backtracking: walk the filename numeric -N segments from the
		# rightmost backward; the ID is the longest segment-terminated
		# prefix whose remainder is exactly ".md" or matches the stamp form
		# "-YYYYMMDD-HHMM" plus an optional slug, so a numeric-only slug
		# segment (TASK-5-20260101-1200-12-factor.md -> TASK-5) lands in
		# the stamp role only when nothing right of it qualifies. Empty
		# when no segment boundary qualifies.
		function taskid(fb,  p, rest, segend, cand, remainder) {
			for (p = length(fb) - 1; p > 1; p--) {
				if (substr(fb, p, 1) != "-") continue
				rest = substr(fb, p)
				if (!match(rest, "^-[0-9]+")) continue
				segend = p + RLENGTH
				cand = substr(fb, 1, segend - 1)
				if (cand !~ segmentre) continue
				remainder = substr(fb, segend)
				if (remainder == ".md" || remainder ~ stampre) return cand
			}
			return ""
		}
		function idkeyof(id,  rest, key, seg) {
			rest = id
			sub(/^[A-Za-z]+/, "", rest)
			key = ""
			while (match(rest, /^-[0-9]+/)) {
				seg = substr(rest, 2, RLENGTH - 1) + 0
				key = key "-" sprintf("%0" idw "d", seg)
				rest = substr(rest, RLENGTH + 1)
			}
			sub(/^-/, "", key)
			return key
		}
		BEGIN {
			sep = "\034"
			wsp = " \t\r\v\f"
			ws = "[" wsp "]+"
			na = ENVIRON["AWK_NA"]
			dp = ENVIRON["AWK_DEFAULT_PRIORITY"]
			undated = ENVIRON["AWK_UNDATED"]
			td = ENVIRON["AWK_TASKS_DIR"] "/"
			cd = ENVIRON["AWK_CURRENT_DIR"]
			ad = ENVIRON["AWK_ARCHIVE_DIR"]
			idw = ENVIRON["AWK_ID_KEY_WIDTH"]
			st_ready = ENVIRON["AWK_READY"]
			st_ip = ENVIRON["AWK_IN_PROGRESS"]
			st_blocked = ENVIRON["AWK_BLOCKED"]
			st_cancelled = ENVIRON["AWK_CANCELLED"]
			st_completed = ENVIRON["AWK_COMPLETED"]
			d8 = "[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]"
			d4 = "[0-9][0-9][0-9][0-9]"
			segmentre = "^[A-Za-z]+(-[0-9]+)+$"
			stampre = "^-" d8 "-" d4 "(-.*)?\\.md$"
			newest_acc = ""
			for (argi = 1; argi < ARGC; argi++) {
				file = ARGV[argi]
				fb = file
				sub(/.*\//, "", fb)
				subdir = file
				arch = 0
				if (subdir ~ "^" cd "/") {
					subdir = cd
				} else if (subdir ~ "^" ad "/") {
					subdir = ad
					arch = 1
				}
				name = status = priority = progress = ""
				created = updated = completed = duration = deco = ""
				have_name = have_status = have_priority = have_progress = 0
				have_created = have_deco = have_updated = have_completed = have_duration = 0
				while ((getline line < (td file)) > 0) {
					if (line ~ /^## /) break
					if (!have_name && match(line, "^# Task:" ws)) { name = substr(line, RSTART + RLENGTH); have_name = 1 }
					if (!have_status && match(line, "^\\*\\*Status:\\*\\*" ws)) { status = substr(line, RSTART + RLENGTH); have_status = 1 }
					if (!have_priority && match(line, "^\\*\\*Priority:\\*\\*" ws)) { priority = substr(line, RSTART + RLENGTH); have_priority = 1 }
					if (!have_progress && match(line, "^\\*\\*Progress:\\*\\*" ws)) { progress = substr(line, RSTART + RLENGTH); have_progress = 1 }
					if (!have_created && match(line, "^\\*\\*Created:\\*\\*" ws)) { created = substr(line, RSTART + RLENGTH); have_created = 1 }
					if (!have_deco && match(line, "^\\*Created:" ws)) { deco = substr(line, RSTART + RLENGTH); sub(/\*.*/, "", deco); have_deco = 1 }
					if (!have_updated && match(line, "^\\*\\*Updated:\\*\\*" ws)) { updated = substr(line, RSTART + RLENGTH); have_updated = 1 }
					if (!have_completed && match(line, "^\\*\\*Completed:\\*\\*" ws)) { completed = substr(line, RSTART + RLENGTH); have_completed = 1 }
					if (!have_duration && match(line, "^\\*\\*Duration:\\*\\*" ws)) { duration = substr(line, RSTART + RLENGTH); have_duration = 1 }
				}
				close(td file)
				if (created == "") created = deco
				if (created == "") created = na
				nb = fb
				sub(/\.md$/, "", nb)
				if (name == "") name = nb
				id = taskid(fb)
				idkey = idkeyof(id)
				if (id != "") name = id ": " name
				if (priority == "") priority = dp
				if (duration == "") duration = na
				link = "[" mdescape(name) "](./" subdir "/" mdescape(fb) ")"
				if (updated != "" && updated > newest_acc) newest_acc = updated
				if (arch) {
					sortkey = (completed == "" ? undated : completed)
					row = "| " link " | " mdescape(completed == "" ? na : completed) " | " mdescape(duration) " |"
					print "6" sep sortkey sep idkey sep row
					continue
				}
				sortkey = (created == na ? undated : created)
				if (status == st_ready) {
					row = "| " link " | " mdescape(priority) " | " mdescape(created) " | " mdescape(updated) " |"
					print "2" sep sortkey sep idkey sep row
				} else if (status == st_ip) {
					row = "| " link " | " mdescape(normprog(progress)) " | " mdescape(updated) " | " mdescape(priority) " |"
					print "3" sep sortkey sep idkey sep row
				} else if (status == st_blocked || status == st_cancelled) {
					row = "| " link " | " mdescape(status) " | " mdescape(created) " | " mdescape(updated) " |"
					print "4" sep sortkey sep idkey sep row
				} else if (status == st_completed) {
					sortkey = (completed == "" ? undated : completed)
					row = "| " link " | " mdescape(completed == "" ? updated : completed) " | " mdescape(duration) " |"
					print "5" sep sortkey sep idkey sep row
				} else {
					row = "| " link " | " mdescape(priority) " | " mdescape(created) " | " mdescape(updated) " |"
					print "1" sep sortkey sep idkey sep row
				}
			}
			print "7" sep newest_acc
			exit
		}
	' "$@"
}

slugify() {
	printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
		| sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# --- rendering -------------------------------------------------------------

# Rebuild dashboard.md from all task files. Pure function of the files on disk:
# same inputs produce byte-identical output, including the derived "Last updated"
# line (the newest Updated timestamp, not wall-clock).
render_unlocked() {
	local tasks_dir="$1"
	# A relative tasks_dir with a leading dash or tilde option-poisons or
	# tilde-expands the utilities the render spawns and the re-parsed trap
	# string; "./" defuses both.
	[[ "$tasks_dir" == -* || "$tasks_dir" == ~* ]] && tasks_dir="./$tasks_dir"
	local dash="$tasks_dir/$DASHBOARD_NAME"
	local tmp; tmp="$(mktemp "$dash.XXXXXX")"
	# Both render temps die with the render span: an EXIT trap carrying
	# the concrete temp paths (printf %q keeps arbitrary board paths
	# byte-safe) runs on every abort set -e produces, where scattered rm
	# calls never execute. Paths are baked in at set time because the
	# trap fires after the function frame is gone; the script sets no
	# other EXIT trap, so clearing it here restores the previous state.
	# Cleared after the dashboard commit, when cleanup is moot, so the
	# trap never spans other subcommands. That clear is also why the
	# render span must never nest: the commit's trap - EXIT discards any
	# outer render span's cleanup with it, so no code path may run one
	# render span inside another (none does).
	local render_cleanup; render_cleanup="rm -f -- $(printf '%q' "$tmp")"
	trap "$render_cleanup" EXIT

	local -a files=()
	local subdir file
	for subdir in "$CURRENT_DIR" "$ARCHIVE_DIR"; do
		[[ -d "$tasks_dir/$subdir" ]] || continue
		for file in "$tasks_dir/$subdir"/*.md; do
			[[ -e "$file" ]] || continue
			files+=("${file#"$tasks_dir/"}")
		done
	done

	local newest="" lane_entry ordinal key_row
	local prev_lane=0 lane_i
	# The assembled rows route through a temp file rather than a pipe:
	# bash's mapfile consumes pipes with per-byte reads (the read builtin
	# cannot push back surplus bytes), which at board size costs more in
	# syscall churn than the extra mktemp and rm; reading a regular file
	# is buffered. One LC_ALL=C sort orders every row at once: the leading
	# lane ordinal groups the lanes in board order, the sort keys order
	# rows within a lane, and byte order keeps ties deterministic. The
	# walk then prints each lane's header exactly where the old per-lane
	# printf block put it, including the header of a lane with no rows
	# (printed when the stream jumps across it, or all of them on an
	# empty board).
	local -a sorted=()
	local rows_file; rows_file="$(mktemp "$dash.XXXXXX")"
	render_cleanup+=" $(printf '%q' "$rows_file")"
	trap "$render_cleanup" EXIT
	assemble_rows "${files[@]+"${files[@]}"}" >"$rows_file"
	LC_ALL=C sort -o "$rows_file" "$rows_file"
	mapfile -t sorted <"$rows_file"
	rm -f "$rows_file"
	{
		printf '# Task Board Dashboard\n\n'
		printf '*Jira-style task management board. Auto-generated by `tasks render`; do not edit by hand.*\n\n'
		for lane_entry in ${sorted[@]+"${sorted[@]}"}; do
			ordinal="${lane_entry%%"$SORT_SEP"*}"
			lane_entry="${lane_entry#*"$SORT_SEP"}"
			if (( ordinal == LANE_LATEST )); then
				[[ -n "$lane_entry" && "$lane_entry" > "$newest" ]] && newest="$lane_entry"
				continue
			fi
			if (( ordinal != prev_lane )); then
				lane_i=$(( prev_lane + 1 ))
				while (( lane_i <= ordinal )); do
					printf '%s' "${LANE_HEADERS[lane_i]}"
					(( lane_i += 1 ))
				done
				prev_lane=$ordinal
			fi
			key_row="${lane_entry#*"$SORT_SEP"}"
			printf '%s\n' "${key_row#*"$SORT_SEP"}"
		done
		lane_i=$(( prev_lane + 1 ))
		while (( lane_i <= ${#LANE_HEADERS[@]} - 1 )); do
			printf '%s' "${LANE_HEADERS[lane_i]}"
			(( lane_i += 1 ))
		done
		printf '\n---\n\n*Last updated: %s*\n' "${newest:-$NA}"
	} >"$tmp"

	mv -f "$tmp" "$dash"
	trap - EXIT
}

# Fail unless the .tasks directory exists.
require_tasks_dir() {
	[[ -d "$1" ]] || die "no .tasks directory at $1 (run 'tasks init')"
}

# Acquire the board lock on fd 9 for this process. The lock is released
# automatically when the process exits, so an abandoned session never
# deadlocks the others. Every read-modify-render span holds it, so
# concurrent mutations serialize instead of racing their writes.
acquire_board_lock() {
	exec 9>"$1/$LOCK_NAME"
	flock 9
}

# Acquire the board lock, then rebuild dashboard.md.
render() {
	local tasks_dir="$1"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	render_unlocked "$tasks_dir"
}

# --- header mutation -------------------------------------------------------

# Rewrite the header region placing every "**Key:** ..." line given as
# arguments "<key>\034<line>" in ONE pass: an existing "**Key:** ..." line
# is replaced in place (first occurrence wins, any duplicate key line is
# dropped), an absent one inserts at its canonical template slot (before
# the first present field that canonically follows the key in
# TEMPLATE_HEADER_FIELDS), and end of header is the fallback when no
# successor exists (also covering fields outside the template order).
# Keys emit in canonical template order: at every emission point the
# pending keys are visited sorted by their TEMPLATE_HEADER_FIELDS position
# (stable, so keys outside the template keep command order), which is the
# order the old sequential per-key passes produced when several missing
# keys share one insertion anchor. An EMPTY line deletes the key's
# lines instead of writing one. The per-key lines travel via per-key
# environment variables (not awk -v) so backslashes in user values
# survive verbatim. Atomic: output
# is staged into a temp file and a single mv commits it, so a failure
# mid-pass leaves the original file untouched. Only the header region is
# touched.
write_header_fields() {
	local file="$1"; shift
	# Nothing requested, nothing to write: no temp, no rewrite.
	(($# > 0)) || return 0
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	# The per-key values export under generated names (KEY_1, LINE_1, ...):
	# export, like env, parses each argument as an assignment itself, while
	# a shell env-prefix built from an array would arrive quoted and stop
	# being assignments. Every variable is unset again on every exit path,
	# exported state must never leak to later commands' children.
	local i=0 pair key rc=0
	export TEMPLATE_ORDER="$(printf '%s\034' "${TEMPLATE_HEADER_FIELDS[@]}")" NKEYS="$#"
	for pair in "$@"; do
		((i += 1))
		key="${pair%%$'\034'*}"
		export "KEY_$i=$key" "LINE_$i=${pair#*$'\034'}"
	done
	awk '
		BEGIN {
			inhdr = 1
			nkeys = ENVIRON["NKEYS"] + 0
			for (i = 1; i <= nkeys; i++) {
				k = ENVIRON["KEY_" i]
				keyseq[i] = k
				line_of[k] = ENVIRON["LINE_" i]
				have[k] = 0
			}
			n = split(ENVIRON["TEMPLATE_ORDER"], order, SUBSEP)
			for (i = 1; i <= n; i++) if (order[i] != "") pos[order[i]] = i
			for (i = 1; i <= nkeys; i++) {
				k = ENVIRON["KEY_" i]
				if (k in pos) orderpos[i] = pos[k] + 0
				else orderpos[i] = 1e9 + i
			}
			# Stable insertion sort of the key sequence by canonical
			# position: ties (non-template keys) keep command order.
			for (i = 1; i <= nkeys; i++) emseq[i] = keyseq[i]
			for (i = 2; i <= nkeys; i++) {
				k = emseq[i]
				p = orderpos[i]
				for (j = i - 1; j >= 1 && orderpos[j] > p; j--) {
					emseq[j + 1] = emseq[j]
					orderpos[j + 1] = orderpos[j]
				}
				emseq[j + 1] = k
				orderpos[j + 1] = p
			}
		}
		function emit_key(k) { if (line_of[k] != "") print line_of[k]; have[k] = 1 }
		function pending_emit() {
			for (i = 1; i <= nkeys; i++) if (!have[emseq[i]]) emit_key(emseq[i])
		}
		inhdr && /^## / {
			pending_emit()
			inhdr = 0
		}
		{
			if (inhdr) {
				if (match($0, /^\*\*[^*:]+:\*\*/)) {
					field = substr($0, RSTART + 2, RLENGTH - 5)
					if (field in pos)
						for (i = 1; i <= nkeys; i++) {
							k = emseq[i]
							if (!have[k] && (k in pos) && pos[field] > pos[k]) emit_key(k)
						}
				}
				for (i = 1; i <= nkeys; i++) {
					k = emseq[i]
					if ($0 ~ ("^\\*\\*" k ":\\*\\*")) {
						if (!have[k]) emit_key(k)
						next
					}
				}
			}
			print
		}
		END { pending_emit() }
	' "$file" >"$tmp" || rc=1
	if ((rc == 0)); then
		mv -f "$tmp" "$file" || rc=1
	fi
	unset TEMPLATE_ORDER NKEYS
	for ((key = 1; key <= i; key++)); do unset "KEY_$key" "LINE_$key"; done
	((rc != 0)) && rm -f "$tmp"
	return "$rc"
}

# Replace a "**Key:** value" line within the header, or insert it at its
# canonical template slot when absent (see write_header_fields). An empty
# value removes the line instead: a blank field is never written (a
# deleted reason must not survive as an empty duplicate).
set_header_field() {
	local file="$1" key="$2" value="$3"
	write_header_fields "$file" "$key"$'\034'"**$key:** $value"
}

# Append a Work Log entry at the end of the "## Work Log" section and
# refresh the Updated/Latest Update header fields in one atomic rewrite:
# output is staged into a temp file and a single mv commits it, so a
# failure mid-pass leaves the original file untouched. Entry and field
# values travel via ENVIRON (not awk -v) so backslashes in user text
# survive verbatim. Empty updated/latest skips that refresh rather than
# blanking the field. Returns non-zero without touching the file if any
# stage fails.
append_work_log_entry() {
	local file="$1" entry="$2" updated="$3" latest="${4:-}"
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	ENTRY="$entry" UPDATED="$updated" LATEST="$latest" awk '
		BEGIN {
			inhdr = 1; inwork = 0; done_u = 0; done_l = 0; prevblank = 1
			entry = ENVIRON["ENTRY"]; updated = ENVIRON["UPDATED"]; latest = ENVIRON["LATEST"]
		}
		inhdr && /^## / {
			if (updated != "" && !done_u) { print "**Updated:** " updated; done_u = 1 }
			if (latest != "" && !done_l) { print "**Latest Update:** " latest; done_l = 1 }
			inhdr = 0
		}
		{
			if (inhdr && updated != "" && !done_u && $0 ~ /^\*\*Updated:\*\*/) {
				print "**Updated:** " updated; done_u = 1; next
			}
			if (inhdr && latest != "" && !done_l && $0 ~ /^\*\*Latest Update:\*\*/) {
				print "**Latest Update:** " latest; done_l = 1; next
			}
			if ($0 ~ /^## Work Log/) { inwork = 1; print; next }
			if (inwork && /^## /) {
				if (entry != "") {
					if (!prevblank) print ""
					printf "%s", entry
					entry = ""
				}
				inwork = 0
			}
			print
			prevblank = ($0 == "")
		}
		END {
			if (entry != "") {
				if (!prevblank) print ""
				printf "%s", entry
			}
			if (updated != "" && !done_u) print "**Updated:** " updated
			if (latest != "" && !done_l) print "**Latest Update:** " latest
		}
	' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# Print the heading level (2..6) of the first section heading matching the
# given name, reading the file without writing anything, and exit non-zero
# when no heading matches. Level-1 headings are the document title, not
# sections, and never match, so a --section naming the title is reported
# as unknown instead of silently replacing everything below it.
section_level() {
	SECTION="$2" awk "$AWK_HEADING_LEVEL"'
		BEGIN { section = ENVIRON["SECTION"]; found = 0 }
		{
			level = heading_level()
			if (level >= 2 && HTEXT == section) { print level; found = 1; exit }
		}
		END { exit found ? 0 : 1 }
	' "$1"
}

# Report whether the file carries a section heading matching the given name
# at level 2 or deeper. A thin wrapper over section_level for callers that
# only need the existence bit.
section_exists() { section_level "$1" "$2" >/dev/null; }

# Report whether the named section is one the task-file template defines,
# and so may be created when absent. Sections outside the template stay
# unknown and are refused.
can_create_section() {
	local candidate
	for candidate in "${TEMPLATE_SECTIONS[@]}"; do
		[[ "$candidate" == "$1" ]] && return 0
	done
	return 1
}

# Print the first section of the canonical template order that comes after
# the given section and exists in the file: the anchor the new section is
# inserted before. Prints nothing when no successor exists (the new section
# belongs at the end of the file).
canonical_section_anchor() {
	local file="$1" section="$2" candidate after=0
	for candidate in "${TEMPLATE_SECTIONS[@]}"; do
		if ((after == 0)); then
			[[ "$candidate" == "$section" ]] && after=1
			continue
		fi
		if section_exists "$file" "$candidate"; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	return 0
}

# Insert a section heading and its body at the named anchor heading, or at
# end of file when the anchor is empty, in one atomic rewrite: output is
# staged into a temp file and a single mv commits it, so a failure mid-pass
# leaves the original file untouched. Blank lines separate the new section
# from the surrounding content, keeping the canonical heading/body layout.
# The anchor must exist when non-empty; a missing anchor fails the write
# instead of silently appending. Section name, body, and mode travel via
# ENVIRON (not awk -v) so backslashes in user text survive verbatim.
insert_section_body() {
	local file="$1" section="$2" body="$3" anchor="$4"
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	NEW_SECTION="$section" NEW_BODY="$body" ANCHOR="$anchor" awk "$AWK_HEADING_LEVEL"'
		function emit_section() {
			if (!prevblank) print ""
			print "## " section
			print ""
			printf "%s", body
			if (body != "") print ""
			inserted = 1
		}
		BEGIN {
			section = ENVIRON["NEW_SECTION"]; body = ENVIRON["NEW_BODY"]
			anchor = ENVIRON["ANCHOR"]; atend = anchor == ""
			inserted = 0; prevblank = 1
		}
		{
			if (!inserted && !atend) {
				level = heading_level()
				if (level >= 2 && HTEXT == anchor) {
					emit_section()
				}
			}
			print
			prevblank = ($0 == "")
		}
		END {
			if (atend && !inserted) emit_section()
			if (!inserted) exit 1
		}
	' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# Replace the body of a named section, or append to it, in one atomic
# rewrite: output is staged into a temp file and a single mv commits it, so
# a failure mid-pass leaves the original file untouched. The section spans
# its heading through the line before the next heading of the same or
# higher level; replace swaps that whole region for the new body, append
# inserts the new body after the existing one (trailing blank lines
# trimmed) with a blank line between. The blank separator line under the
# section heading is always preserved (consumed from the original when
# present), so both modes keep the canonical heading/body layout. Sections
# match at level 2 and deeper only; the level-1 document title is not a
# section. Section name, new body, and mode travel via ENVIRON (not
# awk -v) so backslashes in user text survive verbatim. Returns non-zero
# without touching the file when no section heading matches.
replace_section_body() {
	local file="$1" section="$2" body="$3" append="$4"
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	SECTION="$section" EDIT_BODY="$body" EDIT_APPEND="$append" awk "$AWK_HEADING_LEVEL"'
		function flush_body(    i) {
			while (nbuf > 0 && buf[nbuf] == "") nbuf--
			for (i = 1; i <= nbuf; i++) print buf[i]
		}
		BEGIN {
			section = ENVIRON["SECTION"]
			body = ENVIRON["EDIT_BODY"]
			appending = ENVIRON["EDIT_APPEND"] == "1"
			state = 0; found = 0; nbuf = 0; fresh = 0
		}
		{
			if (state == 2) { print; next }
			level = heading_level()
			if (state == 0) {
				if (level >= 2 && HTEXT == section) {
					found = 1; sec_level = level; state = 1; fresh = 1
					print
					print ""
					next
				}
				print; next
			}
			if (fresh) {
				fresh = 0
				if ($0 == "") next
			}
			if (level && level <= sec_level) {
				if (appending) {
					flush_body()
					if (body != "") {
						if (nbuf > 0) print ""
						print body
						print ""
					}
				} else {
					print body
					print ""
				}
				print
				state = 2
				next
			}
			if (appending) buf[++nbuf] = $0
			next
		}
		END {
			if (!found) exit 1
			if (state == 1) {
				if (appending) {
					flush_body()
					if (body != "") {
						if (nbuf > 0) print ""
						print body
					}
				} else {
					print body
				}
			}
		}
	' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# --- commands --------------------------------------------------------------

# Every option accepts a --flag=VALUE long form in addition to the
# space-separated one. The long form is the only way to express a value
# that itself starts with "--": the space form refuses flag-shaped tokens
# as values, so a name like "--force" is only spellable --name=--force.

cmd_init() {
	local dir=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "init: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) die "init: unknown argument: $1" ;;
		esac
	done
	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	mkdir -p "$tasks_dir/$CURRENT_DIR" "$tasks_dir/$ARCHIVE_DIR"
	render "$tasks_dir"
	printf '%s\n' "$tasks_dir"
}

cmd_render() {
	local dir=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "render: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) die "render: unknown argument: $1" ;;
		esac
	done
	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	render "$tasks_dir"
}

cmd_new() {
	local id="" name="" status="$DEFAULT_STATUS" priority="$DEFAULT_PRIORITY" dir=""
	while (($#)); do
		case "$1" in
			--id) [[ $# -ge 2 && "$2" != --* ]] || die "new: --id requires a value"; id="$2"; shift 2 ;;
			--id=*) id="${1#*=}"; shift ;;
			--name) [[ $# -ge 2 && "$2" != --* ]] || die "new: --name requires a value"; name="$2"; shift 2 ;;
			--name=*) name="${1#*=}"; shift ;;
			--status) [[ $# -ge 2 && "$2" != --* ]] || die "new: --status requires a value"; status="$2"; shift 2 ;;
			--status=*) status="${1#*=}"; shift ;;
			--priority) [[ $# -ge 2 && "$2" != --* ]] || die "new: --priority requires a value"; priority="$2"; shift 2 ;;
			--priority=*) priority="${1#*=}"; shift ;;
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "new: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) die "new: unknown option: $1" ;;
		esac
	done
	[[ -n "$id" ]] || die "new: --id is required"
	[[ -n "$name" ]] || die "new: --name is required"
	valid_task_id "$id" || die "new: invalid task ID: $id (expected PREFIX-N, hierarchically PREFIX-N-N)"
	valid_status "$status" || die "new: unknown status: $status (valid: $STATUS_VALUES)"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"

	local ts; ts="$(now)"
	local stamp; stamp="$(date '+%Y%m%d-%H%M')"
	local body; body="$(cat <<EOF
# Task: $name

**Created:** $ts
**Status:** $status
**Priority:** $priority
**Progress:** 0%
**Owner:**
**Updated:** $ts
**Latest Update:** [$ts] Task created ([detail](#execution-log))

## Table of Contents

- [Objective](#objective)
- [Success Criteria](#success-criteria)
- [Work Log](#work-log)
- [Execution Log](#execution-log)

---

## Objective

[$id] $name

## Success Criteria

- [ ] TODO

## Work Log

## Execution Log

- $ts - Task file created
EOF
)"

	# Exclusive create (noclobber) makes the existence test atomic, so a
	# concurrent new can never clobber this file; on a same-minute name
	# collision, retry with an incremented numeric suffix.
	local slug; slug="$(slugify "$name")"
	local n=1 candidate file
	while :; do
		if ((n == 1)); then candidate="$tasks_dir/$CURRENT_DIR/$id-$stamp-$slug.md"
		else candidate="$tasks_dir/$CURRENT_DIR/$id-$stamp-$slug-$n.md"; fi
		if (set -o noclobber; printf '%s\n' "$body" >"$candidate") 2>/dev/null; then
			file="$candidate"
			break
		fi
		[[ -e "$candidate" ]] || die "new: cannot create task file $candidate (check permissions)"
		n=$((n + 1))
	done
	render_unlocked "$tasks_dir"
	printf '%s\n' "$file"
}

cmd_set() {
	local dir="" args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "set: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} >= 1)) || die "set: usage: tasks set <taskfile> Key=Value..."

	# Validate every pair before touching the file, so a bad key or a bad
	# Status cannot leave a half-applied update behind. The Status/Status
	# Reason coupling needs the file's current header, so it is enforced
	# under the board lock below, still ahead of the first write.
	local pair key value i new_status status_reason_value status_reason_given
	new_status=""
	status_reason_value=""
	status_reason_given=0
	for ((i = 1; i < ${#args[@]}; i++)); do
		pair="${args[$i]}"
		[[ "$pair" == *=* ]] || die "set: expected Key=Value, got: $pair"
		key="${pair%%=*}"
		value="${pair#*=}"
		valid_header_key "$key" \
			|| die "set: unknown header key: $key (valid fields: $HEADER_FIELDS)"
		if [[ "$key" == "Status" ]]; then
			valid_status "$value" || die "set: unknown status: $value (valid: $STATUS_VALUES)"
			new_status="$value"
		elif [[ "$key" == "$STATUS_REASON_KEY" ]]; then
			status_reason_value="$value"
			status_reason_given=1
		fi
	done

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	# Status Reason exists only under Blocked/Cancelled (the header contract
	# omits it otherwise), so the effective transition target decides what
	# this call must do with the reason. Landing on Blocked/Cancelled demands
	# a non-empty reason in the same call or already on the file; landing
	# anywhere else with a non-empty reason is a contradiction and is refused
	# rather than silently leaving a stale field behind. A call without a
	# Status pair keeps the file's current status as the target, so clearing
	# the reason on a Blocked task is refused instead of unexplained. The
	# two lookups read the header region directly in bash with the same
	# first-match, whitespace-run semantics as the extraction greps, so a
	# validation-only command spawns nothing here. The read's || guard
	# processes a file whose header lacks the trailing newline, exactly
	# where awk's header_of stops.
	local target_status="$new_status" current_reason=""
	local hline
	local re_status='^\*\*Status:\*\*[[:space:]]+(.*)$'
	local re_reason='^\*\*'"$STATUS_REASON_KEY"':\*\*[[:space:]]+(.*)$'
	local have_status=0 have_reason=0
	# An explicit Status pair already fixed the transition target; only an
	# absent one is read from the file.
	[[ -n "$new_status" ]] && have_status=1
	while IFS= read -r hline || [[ -n "$hline" ]]; do
		[[ "$hline" == "## "* ]] && break
		# First match wins per key even when the value is empty, so the
		# flags - not the variables - gate the capture.
		if ((have_status == 0)) && [[ "$hline" =~ $re_status ]]; then
			target_status="${BASH_REMATCH[1]}"
			have_status=1
		elif ((have_reason == 0)) && [[ "$hline" =~ $re_reason ]]; then
			current_reason="${BASH_REMATCH[1]}"
			have_reason=1
		fi
		((have_status == 1 && have_reason == 1)) && break
	done <"$file"
	if [[ "$target_status" == "$STATUS_BLOCKED" || "$target_status" == "$STATUS_CANCELLED" ]]; then
		if ((status_reason_given == 0)); then
			[[ -n "$current_reason" ]] \
				|| die "set: status $target_status requires a $STATUS_REASON_KEY (why is this task blocked?)"
		else
			[[ -n "$status_reason_value" ]] \
				|| die "set: status $target_status requires a non-empty $STATUS_REASON_KEY (supply one or drop the pair)"
		fi
	else
		if ((status_reason_given == 1)); then
			[[ -z "$status_reason_value" ]] \
				|| die "set: $STATUS_REASON_KEY applies only under $STATUS_BLOCKED/$STATUS_CANCELLED (clear it with ${STATUS_REASON_KEY}= or keep the task $STATUS_BLOCKED)"
		fi
	fi

	# All pairs land in one whole-file rewrite: composed lines (or empty
	# ones for deletions) ride as "<key>\034<line>" entries so a mid-crash
	# can never strand half the pairs, and the Updated refresh joins the
	# same commit. Leaving Blocked/Cancelled drops the reason with the
	# transition (the header contract omits it under any other status),
	# unless this call already manages the pair explicitly; deleting an
	# absent key writes nothing for it, so a task that never carried a
	# reason is not rewritten for nothing beyond the pairs themselves.
	local -a writes=()
	local touched_updated=0
	for ((i = 1; i < ${#args[@]}; i++)); do
		pair="${args[$i]}"
		key="${pair%%=*}"
		value="${pair#*=}"
		# Empty means delete everywhere except Updated: set exists to keep
		# that field fresh, the dashboard depends on it, so an emptied
		# Updated= pair is a refresh request, never a deletion.
		if [[ "$key" == "Updated" && -z "$value" ]]; then
			value="$(now)"
		fi
		if [[ -z "$value" ]]; then
			writes+=("$key"$'\034')
		else
			writes+=("$key"$'\034'"**$key:** $value")
		fi
		[[ "$key" == "Updated" ]] && touched_updated=1
	done
	((touched_updated == 0)) && writes+=("Updated"$'\034'"**Updated:** $(now)")
	if [[ "$target_status" != "$STATUS_BLOCKED" && "$target_status" != "$STATUS_CANCELLED" ]] \
		&& ((status_reason_given == 0)) && [[ -n "$current_reason" ]]; then
		writes+=("$STATUS_REASON_KEY"$'\034')
	fi
	write_header_fields "$file" ${writes[@]+"${writes[@]}"}
	render_unlocked "$tasks_dir"
}

cmd_claim() {
	local owner="" dir="" target=""
	while (($#)); do
		case "$1" in
			--owner) [[ $# -ge 2 && "$2" != --* ]] || die "claim: --owner requires a value"; owner="$2"; shift 2 ;;
			--owner=*) owner="${1#*=}"; shift ;;
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "claim: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) target="$1"; shift ;;
		esac
	done
	[[ -n "$target" ]] || die "claim: usage: tasks claim <taskfile> [--owner ID]"
	[[ -n "$owner" ]] || owner="$(session_id)"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target")"
	local claim="$file$CLAIM_SUFFIX"

	# O_EXCL create: exactly one racer wins. noclobber makes '>' fail if it exists.
	if (set -o noclobber; printf '%s\n' "$owner" >"$claim") 2>/dev/null; then
		write_header_fields "$file" \
			"Owner"$'\034'"**Owner:** $owner" \
			"Updated"$'\034'"**Updated:** $(now)"
		render_unlocked "$tasks_dir"
		printf 'claimed %s by %s\n' "$(basename "$file")" "$owner"
	elif [[ -e "$claim" ]]; then
		die "already claimed by $(cat "$claim" 2>/dev/null || printf 'unknown')"
	else
		die "claim: cannot create $claim (check permissions)"
	fi
}

cmd_release() {
	local dir="" target=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "release: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) target="$1"; shift ;;
		esac
	done
	[[ -n "$target" ]] || die "release: usage: tasks release <taskfile>"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target")"
	rm -f "$file$CLAIM_SUFFIX"
	write_header_fields "$file" \
		"Owner"$'\034'"**Owner:**" \
		"Updated"$'\034'"**Updated:** $(now)"
	render_unlocked "$tasks_dir"
	printf 'released %s\n' "$(basename "$file")"
}

# Next report sequence number for a task's reports directory: one past the
# highest NN prefix on disk (base-10 parse strips the zero padding), so
# numbering never reuses a number even when gaps exist.
next_report_seq() {
	local report_dir="$1" max=0 base seq f
	for f in "$report_dir"/*.md; do
		[[ -e "$f" ]] || continue
		base="${f##*/}"
		[[ "$base" =~ ^([0-9]+)- ]] || continue
		seq=$((10#${BASH_REMATCH[1]}))
		((seq > max)) && max="$seq"
	done
	printf '%d' "$((max + 1))"
}

cmd_report() {
	local dir="" slug="" from="" digest=""
	local args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "report: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--slug) [[ $# -ge 2 && "$2" != --* ]] || die "report: --slug requires a value"; slug="$2"; shift 2 ;;
			--slug=*) slug="${1#*=}"; shift ;;
			--from) [[ $# -ge 2 && "$2" != --* ]] || die "report: --from requires a value"; from="$2"; shift 2 ;;
			--from=*) from="${1#*=}"; shift ;;
			--digest) [[ $# -ge 2 && "$2" != --* ]] || die "report: --digest requires a value"; digest="$2"; shift 2 ;;
			--digest=*) digest="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} >= 1 && ${#args[@]} <= 2)) \
		|| die 'report: usage: tasks report <taskfile> --slug <kebab-slug> [--from <worker>] --digest "<one line>" [<file>|-]'
	local target_arg="${args[0]}"
	local content_file="${args[1]:-}"

	# Validate every argument before touching the board, so a bad one can
	# never leave a half-applied deposit behind.
	[[ -n "$slug" ]] || die "report: --slug is required"
	[[ -n "$digest" ]] || die "report: --digest is required"
	valid_slug "$slug" || die "report: invalid slug: $slug (expected kebab-case: lowercase letters, digits, hyphens)"
	[[ "$digest" != *$'\n'* && "$digest" != *$'\r'* ]] || die "report: --digest must be a single line"
	[[ -n "${from//[[:space:]]/}" ]] || from="$DEFAULT_FROM"
	[[ "$from" != *$'\n'* && "$from" != *$'\r'* ]] || die "report: --from must be a single line"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"

	# Read the report content before taking the board lock: content is not
	# board state, an unreadable or empty source must fail before anything
	# changes, and a slow pipe must never stretch the lock hold.
	local content
	if [[ -z "$content_file" || "$content_file" == "-" ]]; then
		content="$(cat)" || die "report: cannot read report content from stdin"
	else
		[[ -f "$content_file" ]] || die "report: report file not found: $content_file"
		content="$(cat "$content_file")" || die "report: cannot read report file: $content_file"
	fi
	[[ -n "$content" ]] || die "report: report content is empty"

	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target_arg")"

	local base; base="${file##*/}"
	local report_dir="$tasks_dir/$REPORTS_DIR/$base"
	mkdir -p "$report_dir" || die "report: cannot create $report_dir (check permissions)"
	local seq; seq="$(next_report_seq "$report_dir")"
	local name; name="$(printf '%02d-%s.md' "$seq" "$slug")"
	local deposit="$report_dir/$name"

	# Stage the deposit and commit with a single mv: a write failure leaves
	# no file behind, and the existence check under the board lock refuses
	# to overwrite an existing report.
	[[ -e "$deposit" ]] && die "report: refusing to overwrite existing report: $REPORTS_DIR/$base/$name"
	local staged; staged="$(mktemp "$report_dir/.reportXXXXXX")" \
		|| die "report: cannot create report in $report_dir (check permissions)"
	printf '%s\n' "$content" >"$staged" || { rm -f "$staged"; die "report: cannot write $deposit"; }
	mv -f "$staged" "$deposit" || { rm -f "$staged"; die "report: cannot create $deposit"; }

	local ts; ts="$(now)"
	local rel="$REPORTS_DIR/$base/$name"
	local entry latest
	printf -v entry '### %s: %s: Report\n\n**Report:** [%s](../%s)\n**Digest:** %s\n\n' \
		"$ts" "$from" "$name" "$rel" "$digest"
	printf -v latest '[%s] %s ([report](../%s))' "$ts" "$digest" "$rel"

	# Commit the task-file side; on failure roll the deposit back, so a
	# report file never exists without its Work Log entry.
	if ! append_work_log_entry "$file" "$entry" "$ts" "$latest"; then
		rm -f "$deposit"
		die "report: failed to update $base (deposit removed)"
	fi
	render_unlocked "$tasks_dir"
	printf '%s\n' "$deposit"
}

cmd_log() {
	local dir="" from="" args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "log: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--from) [[ $# -ge 2 && "$2" != --* ]] || die "log: --from requires a value"; from="$2"; shift 2 ;;
			--from=*) from="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 2)) || die 'log: usage: tasks log <taskfile> [--from <worker>] "<message>"'
	local target_arg="${args[0]}" message="${args[1]}"

	# Validate every argument before touching the board, so a rejected
	# message can never leave a half-applied entry behind.
	[[ -n "${message//[[:space:]]/}" ]] || die "log: message must not be empty"
	local first="${message%%$'\n'*}"
	[[ -n "${first//[[:space:]]/}" ]] || die "log: message's first line must not be blank (it becomes the entry heading)"
	[[ -n "${from//[[:space:]]/}" ]] || from="$DEFAULT_FROM"
	[[ "$from" != *$'\n'* && "$from" != *$'\r'* ]] || die "log: --from must be a single line"
	[[ "$message" != *$'\r'* ]] || die "log: message must not contain carriage return characters"
	# Entry bodies ride verbatim into the Work Log section, whose structure
	# is heading-delimited; a message line shaped like a markdown heading
	# would inject fake sections (or forge entries), so it is refused.
	local heading_re='^#{1,6} ' line
	while IFS= read -r line; do
		[[ "$line" =~ $heading_re ]] && die "log: message lines must not begin with a markdown heading"
	done <<<"$message"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target_arg")"

	# The first message line becomes the heading title (Jira-style scan
	# value); any remaining lines ride along as the entry body.
	local ts rest entry
	ts="$(now)"
	if [[ "$message" == *$'\n'* ]]; then
		rest="${message#*$'\n'}"
		printf -v entry '### %s: %s: %s\n\n%s\n\n' "$ts" "$from" "$first" "$rest"
	else
		printf -v entry '### %s: %s: %s\n\n' "$ts" "$from" "$first"
	fi
	append_work_log_entry "$file" "$entry" "$ts" "" || die "log: failed to update $(basename "$file")"
	render_unlocked "$tasks_dir"
	printf 'logged %s\n' "$(basename "$file")"
}

cmd_edit() {
	local dir="" section="" append=0
	local args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "edit: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--section) [[ $# -ge 2 && "$2" != --* ]] || die "edit: --section requires a value"; section="$2"; shift 2 ;;
			--section=*) section="${1#*=}"; shift ;;
			--append) append=1; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} >= 1 && ${#args[@]} <= 2)) \
		|| die 'edit: usage: tasks edit <taskfile> --section <heading> [--append] [<file>|-]'
	local target_arg="${args[0]}"
	local content_file="${args[1]:-}"

	# Validate every argument before touching the board, so a rejected edit
	# can never leave a half-applied body behind.
	[[ -n "$section" ]] || die "edit: --section is required"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"

	# Read the new body before taking the board lock: content is not board
	# state, an unreadable or empty source must fail before anything changes,
	# and a slow pipe must never stretch the lock hold.
	local content
	if [[ -z "$content_file" || "$content_file" == "-" ]]; then
		content="$(cat)" || die "edit: cannot read section body from stdin"
	else
		[[ -f "$content_file" ]] || die "edit: section body file not found: $content_file"
		content="$(cat "$content_file")" || die "edit: cannot read section body file: $content_file"
	fi

	# A replacement must never blank a section: an empty body is refused
	# outright. Whether a heading-shaped body line is refused depends on the
	# target section's own level (checked under the lock below): sections
	# are heading-delimited, so a line at the same level or higher would
	# inject a fake section boundary into every later parser pass, while a
	# strictly deeper heading is legal structure (### Decision Log inside
	# ## Technical Approach, ### Task entries inside ## Task Breakdown).
	if ((append == 0)); then
		[[ -n "$content" ]] \
			|| die "edit: refusing to replace section '$section' with an empty body (supply content or use --append)"
	fi

	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target_arg")"

	# Section existence is checked read-only under the lock, so every path
	# (including the --append empty-input no-op) refuses an unknown section
	# before anything is written, and a later mktemp or awk write failure
	# reports as an update failure instead of a lookup miss. A missing
	# section the template defines is created instead of refused (the
	# planning pass must never need a hand edit for a new section); anything
	# outside the template stays unknown. Creation without content would
	# write a bare heading, so it is refused too, with its own actionable
	# message; appending nothing to an existing section stays a no-op.
	local sec_level created=0
	if ! sec_level="$(section_level "$file" "$section")"; then
		can_create_section "$section" || die "edit: unknown section: $section"
		# Creation without content would write a bare heading: refuse with
		# the actionable message instead of silently scaffolding.
		[[ -n "$content" ]] \
			|| die "edit: refusing to create section '$section' with an empty body (supply content)"
		created=1
		sec_level="$TEMPLATE_SECTION_LEVEL"
	fi

	# Heading guard, level-aware: refuse heading lines at the target
	# section's level or above; permit strictly deeper structure.
	local heading_line heading_re='^(#{1,6} )' line
	while IFS= read -r line; do
		[[ "$line" =~ $heading_re ]] || continue
		heading_line="${line%% *}"
		(( ${#heading_line} <= sec_level )) \
			&& die "edit: body lines must not begin with a heading at or above the '$section' section's own level"
	done <<<"$content"

	# --append with empty input is a no-op: skip the rewrite, keep the
	# uniform success bookkeeping (Updated refresh plus render). A created
	# section always has a body, so it never takes this branch.
	if ((created == 1)); then
		insert_section_body "$file" "$section" "$content" \
			"$(canonical_section_anchor "$file" "$section")" \
			|| die "edit: failed to update $(basename "$file")"
	elif ((append == 0)) || [[ -n "$content" ]]; then
		replace_section_body "$file" "$section" "$content" "$append" \
			|| die "edit: failed to update $(basename "$file")"
	fi
	set_header_field "$file" "Updated" "$(now)"
	render_unlocked "$tasks_dir"
	printf 'edited %s\n' "$(basename "$file")"
}

# Print the final N entries of a task's Work Log section, verbatim, from a
# snapshot supplied on stdin. Entries start at each "### " heading; the tail
# begins at the Nth-from-last heading and runs to the end of the section
# with trailing blank lines trimmed.
work_log_tail() {
	local n="$1"
	awk -v n="$n" '
		/^## Work Log/ { inwork = 1; next }
		inwork && /^## / { inwork = 0 }
		inwork {
			lines[NR] = $0
			if ($0 ~ /^### /) starts[++count] = NR
			lastline = NR
		}
		END {
			if (count == 0) exit 0
			first = (count > n) ? starts[count - n + 1] : starts[1]
			while (lastline > first && lines[lastline] == "") lastline--
			for (i = first; i <= lastline; i++) print lines[i]
		}
	'
}

cmd_show() {
	local dir="" tail="$DEFAULT_TAIL" args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "show: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--tail) [[ $# -ge 2 && "$2" != --* ]] || die "show: --tail requires a value"; tail="$2"; shift 2 ;;
			--tail=*) tail="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 1)) || die "show: usage: tasks show <taskfile> [--tail N]"
	[[ "$tail" =~ ^[1-9][0-9]*$ ]] || die "show: --tail expects a positive integer, got: $tail"

	local tasks_dir; tasks_dir="$(resolve_tasks_dir "$dir")"
	require_tasks_dir "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	# Strictly read-only: no board lock, no render, no header bump. Task
	# mutations publish via atomic mv, so a lock-free reader sees complete
	# old-or-new content either way. The file is read ONCE into a snapshot
	# and both the header and the tail are extracted from that single
	# image, so a concurrent mutation can never yield a torn composite of
	# an old header with a new tail.
	local snapshot
	snapshot="$(cat "$file")"
	header_of <<<"$snapshot"
	printf '\n## Work Log (last %s entries)\n\n' "$tail"
	work_log_tail "$tail" <<<"$snapshot"
}

main() {
	(($#)) || { usage; exit 2; }
	local cmd="$1"; shift
	case "$cmd" in
		init) cmd_init "$@" ;;
		render) cmd_render "$@" ;;
		new) cmd_new "$@" ;;
		set) cmd_set "$@" ;;
		claim) cmd_claim "$@" ;;
		release) cmd_release "$@" ;;
		report) cmd_report "$@" ;;
		log) cmd_log "$@" ;;
		edit) cmd_edit "$@" ;;
		show) cmd_show "$@" ;;
		help | -h | --help) usage ;;
		*) err "unknown command: $cmd"; usage; exit 2 ;;
	esac
}

main "$@"
