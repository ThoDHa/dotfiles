#!/usr/bin/env bash
#
# tasks - concurrency-safe board tool for the .tasks/ task-file protocol.
#
# The dashboard is a derived artifact: `render` rebuilds it from the task
# files under a process-held flock on .tasks/.lock, so concurrent sessions
# serialize harmlessly and never lose an update. Task ownership is claimed
# atomically via an O_EXCL sidecar (<taskfile>.claim), never by editing a
# text field. Bulky agent reports are deposited under
# .tasks/reports/<taskfile>/NN-<slug>.md by `tasks report` under the same
# lock and linked from the Work Log with a one-line digest. See
# ~/.agents/skills/task-files/SKILL.md, section
# "Concurrency and Multi-Session Safety".

set -euo pipefail

readonly LOCK_NAME=".lock"
readonly DASHBOARD_NAME="dashboard.md"
readonly CURRENT_DIR="current"
readonly ARCHIVE_DIR="archive"
readonly REPORTS_DIR="reports"
readonly CLAIM_SUFFIX=".claim"

# The version marker every JSON payload of the read surface carries (the
# versioned JSON readers' typed contract: consumers pin the marker and the
# payload shape it names, and a breaking change requires a new version,
# never a silent reshaping).
readonly SCHEMA_VERSION=1

# Keyed rows travel from the assembler through one LC_ALL=C sort as
# "<ordinal><SORT_SEP><sortkey><SORT_SEP><idkey><SORT_SEP><row>"; the
# ordinal is the lane's dashboard position, so byte order groups lanes in
# board order and orders rows within a lane by their keys.
readonly SORT_SEP=$'\034'

# The claim release a terminal transition performs, as two pieces: the
# blank Owner line joins the caller's single locked header rewrite (the
# same whole-file commit as its other pairs), and release_claim drops
# the sidecar once that write commits. A terminal task owns nothing, so
# a surviving sidecar is stale by definition. close (both branches), set,
# release, and archive route through these pieces, so a sidecar
# semantics change lands in one place.
readonly CLAIM_RELEASE_WRITE="Owner${SORT_SEP}**Owner:**"

# Section headers for the six dashboard lanes, indexed by the lane ordinal
# the row assembler emits (lane 7 is the latest-updated tag and has none).
# Each string carries the exact bytes of the old per-lane printf block,
# including the blank separator line ahead of lanes 2-6, so the render can
# print them straight through before each lane's first row.
readonly -a LANE_HEADERS=("" \
	$'## Triage\n\n| Task | Priority | Created | Updated |\n|------|----------|---------|---------|\n' \
	$'\n## Ready\n\n| Task | Priority | Created | Updated |\n|------|----------|---------|---------|\n' \
	$'\n## In Progress\n\n| Task | Progress | Updated | Priority |\n|------|----------|---------|----------|\n' \
	$'\n## Blocked/Cancelled\n\n| Task | Status | Created | Updated |\n|------|--------|---------|---------|\n' \
	$'\n## Completed\n\n| Task | Completed | Duration |\n|------|-----------|----------|\n' \
	$'\n## Archive\n\n| Task | Completed | Duration |\n|------|-----------|----------|\n')
# The assembler's trailing line carries the newest-Updated value, not a
# lane row; this is its ordinal.
readonly LANE_LATEST=7

# Rows without a derivable date sort after every dated row in their
# lane. Relies on header dates arriving in canonical
# "YYYY-MM-DD HH:MM" form, which byte-sorts chronologically, so the
# sentinel lands last; a malformed hand-edited value may sort
# elsewhere in its lane, but still deterministically.
readonly UNDATED_SORT_KEY="9999-99-99 99:99"
# Each ID segment is zero-padded to this width in the sort key, so byte
# order equals numeric order for any plausible sequential numbering.
readonly ID_KEY_SEGMENT_WIDTH=6

readonly STATUS_TRIAGE="Triage"
readonly STATUS_READY="Ready"
readonly STATUS_IN_PROGRESS="In Progress"
readonly STATUS_BLOCKED="Blocked"
readonly STATUS_CANCELLED="Cancelled"
readonly STATUS_COMPLETED="Completed"

# The header contract ties Status Reason to Blocked/Cancelled only (the
# task-files skill's Task File Template); set refuses the no-space variant
# and every other misspelling via the canonical-key whitelist.
readonly STATUS_REASON_KEY="Status Reason"

# The sections the task-files skill's Task File Template defines, in the
# order they must appear. tasks edit creates a missing section from this
# list at its canonical slot (before its first present successor) and
# refuses sections outside it; the template's planning sections live
# between Success Criteria and Work Log, which is exactly the slot the
# tasks-new scaffold omits. Dependencies sits with the planning sections
# (the template's subtask **Dependencies:** field has this section as its
# standalone form) and is a dedicated dependency surface: the closure
# gate's child detection reads it, so a declared child blocks closure
# while prose citations elsewhere do not. Questions and Evidence give the
# open questions and the evidence links their own cumulative record homes
# (the template had no section for either), slotted immediately before
# Work Log so the question/evidence appends never reorder or interleave
# with the CLI-stamped timeline sections.
readonly -a TEMPLATE_SECTIONS=("Table of Contents" "Objective" "Success Criteria" "Technical Approach" "Risk Assessment" "Testing Strategy" "TDD Workflow" "Task Breakdown" "Dependencies" "Questions" "Evidence" "Work Log" "Execution Log")
readonly TEMPLATE_SECTION_LEVEL=2

# The sections every task file must carry for the lint pass: the new-task
# scaffold's set. The template's planning sections stay optional (the Lite
# Profile collapses or omits them, and tasks edit creates them on demand),
# so linting their absence would fire on every lean file.
readonly -a LINT_REQUIRED_SECTIONS=("Table of Contents" "Objective" "Success Criteria" "Work Log" "Execution Log")

# Shared awk function source: parse a line's markdown heading level (0
# when it is not a level-1..6 heading followed by a space), setting HTEXT
# to the heading text with trailing whitespace stripped. The line arrives
# as the argument (record-driven passes pass $0; getline-driven loops
# pass the variable getline filled, which never touches $0). Concatenated
# ahead of the program body in every heading-delimited pass (section_level,
# replace_section_body, insert_section_body, the closure gate's scan, and
# the board lint's scanner, the latter two also via AWK_CRITERIA_COUNTER),
# so the heading parser exists exactly once.
readonly AWK_HEADING_LEVEL='		function heading_level(text,    h) {
			HTEXT = ""
			if (substr(text, 1, 1) != "#") return 0
			h = 0
			while (substr(text, h + 1, 1) == "#") h++
			if (h > 6 || substr(text, h + 1, 1) != " ") return 0
			HTEXT = substr(text, h + 2)
			sub(/[ \t\r]+$/, "", HTEXT)
			return h
		}
'

# Shared awk function source: the Success-Criteria counter both the
# closure gate and the board lint run, so the two can never drift apart
# on what counts as checked, unchecked, or superseded, or on the verdict
# a criterion carries. Requires AWK_HEADING_LEVEL concatenated ahead of
# it: track_criteria_section builds on heading_level, whose parser and
# trailing-whitespace trim are the single heading-reading implementation.
# Call track_criteria_section on heading lines; on a level-2 heading it
# sets SECNAME to the trimmed heading text and INSC to whether that
# heading opens the Success Criteria section, leaving both untouched on
# any other line. criteria_box classifies a Success Criteria body line
# as "checked" (- [x] / - [X], the reviewed-and-established tick whose
# claim carries recorded evidence), "unchecked" (- [ ]), or "superseded"
# (- ~ [ ], the resolved-but-unfulfilled annotation), returning "" for
# everything else. The ^``` fence toggle rides here too: criteria_box
# tracks fenced regions in fence and returns "" for every line inside
# one (delimiters included), so a fenced example box counts zero in both
# consumers and the gate and lint cannot drift on fenced content; each
# file must start with fence unset. superseded_text strips the exact
# marker prefix criteria_box matched.
#
# The verdict dimension rides the same marker lines as a second,
# orthogonal classification: criteria_verdict returns "verified",
# "refuted", or "unverifiable" when the line carries the tag
# (verdict: <word>) (lowercase, exactly one of the three), and
# criteria_excepted returns 1 when it also carries (exception: <text>)
# with non-empty text, the documented exception that admits a closure
# the unverifiable verdict would otherwise refuse. Both run on lines
# criteria_box has already classified this pass (it must run on every
# body line: it owns the fence toggle the two verdict readers depend on)
# and return ""/0 outside the Success Criteria section, inside a fence,
# or on a line without a criteria marker prefix, so verdict-shaped prose
# elsewhere in a file classifies as nothing. criteria_claim_line is the
# shared prologue both verdict readers guard with.
readonly AWK_CRITERIA_COUNTER='		function track_criteria_section(line,    lvl) {
			lvl = heading_level(line)
			if (lvl != 2) { SECNAME = ""; return }
			SECNAME = HTEXT
			INSC = (SECNAME == "Success Criteria") ? 1 : 0
		}
		function criteria_box(line) {
			if (line ~ /^```/) fence = !fence
			if (fence || !INSC) return ""
			if (line ~ /^- \[[xX]\] /) return "checked"
			if (line ~ /^- \[ \] /) return "unchecked"
			if (line ~ /^- ~ \[ \] /) return "superseded"
			return ""
		}
		function criteria_claim_line(line) {
			if (fence || !INSC) return 0
			return (line ~ /^- \[[xX ]\] / || line ~ /^- ~ \[ \] /) ? 1 : 0
		}
		function criteria_verdict(line) {
			if (!criteria_claim_line(line)) return ""
			if (match(line, /\(verdict: (verified|refuted|unverifiable)\)/)) {
				return substr(line, RSTART + 10, RLENGTH - 11)
			}
			return ""
		}
		function criteria_excepted(line) {
			if (!criteria_claim_line(line)) return 0
			return (line ~ /\(exception: .+\)/) ? 1 : 0
		}
		function superseded_text(line,    text) {
			text = substr(line, 9)
			sub(/[ \t\r]+$/, "", text)
			return text
		}
'

# Shared awk function source: the row-assembly helpers every board-wide
# pass over task files needs, so the ID derivation, key computation, and
# cell escaping exist exactly once and the dashboard and the JSON readers
# can never drift on what a Task ID is. Requires the host program to set
# idw (ID_KEY_SEGMENT_WIDTH) before the functions run; wsp, segmentre,
# and stampre are defined in the fragment's own BEGIN so a host program
# needs nothing beyond the idw environment value.
readonly AWK_ROW_HELPERS='		BEGIN {
			wsp = " \t\r\v\f"
			ws = "[" wsp "]+"
			d8 = "[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]"
			d4 = "[0-9][0-9][0-9][0-9]"
			segmentre = "^[A-Za-z]+(-[0-9]+)+$"
			stampre = "^-" d8 "-" d4 "(-.*)?\\.md$"
		}
		function mdescape(s) {
			gsub(/\\/, "&&", s)
			gsub(/\n/, " ", s)
			gsub(/\r/, " ", s)
			gsub(/\|/, "\\|", s)
			gsub(/\[/, "\\[", s)
			gsub(/\]/, "\\]", s)
			return s
		}
		function normprog(p) {
			sub(/%$/, "", p)
			gsub("[" wsp "]", "", p)
			if (p == "") p = "0"
			return p "%"
		}
		# The Task ID mirrors the greedy capture of the bash render regex
		# with backtracking: walk the filename numeric -N segments from the
		# rightmost backward; the ID is the longest segment-terminated
		# prefix whose remainder is exactly ".md" or matches the stamp form
		# "-YYYYMMDD-HHMM" plus an optional slug, so a numeric-only slug
		# segment (TASK-5-20260101-1200-12-factor.md -> TASK-5) lands in
		# the stamp role only when nothing right of it qualifies. Empty
		# when no segment boundary qualifies.
		function taskid(fb,  p, rest, segend, cand, remainder) {
			for (p = length(fb) - 1; p > 1; p--) {
				if (substr(fb, p, 1) != "-") continue
				rest = substr(fb, p)
				if (!match(rest, "^-[0-9]+")) continue
				segend = p + RLENGTH
				cand = substr(fb, 1, segend - 1)
				if (cand !~ segmentre) continue
				remainder = substr(fb, segend)
				if (remainder == ".md" || remainder ~ stampre) return cand
			}
			return ""
		}
		function idkeyof(id,  rest, key, seg) {
			rest = id
			sub(/^[A-Za-z]+/, "", rest)
			key = ""
			while (match(rest, /^-[0-9]+/)) {
				seg = substr(rest, 2, RLENGTH - 1) + 0
				key = key "-" sprintf("%0" idw "d", seg)
				rest = substr(rest, RLENGTH + 1)
			}
			sub(/^-/, "", key)
			return key
		}
'

# Shared awk function source: the JSON string escaper every emitter of the
# versioned JSON readers runs, so escaping exists exactly once and no
# reader can emit an invalid string. JSON strings need quoted backslashes
# and quotes, named escapes for the common C0 controls, and \u00XX for any
# other control character; valid UTF-8 passes through byte-for-byte (the
# emitters assume task files are UTF-8 text). The fast path is a fixed
# gsub chain; the slow path walks a line character by character only when
# a control character outside the named escapes is present, using an ord
# table built once per program (sprintf("%c", 0) is unreliable across
# awk variants, so NUL is left to the slow path's table gap and control
# codes run 1..31).
readonly AWK_JSON_ESCAPE='		function json_escape(s,  out, i, n, c, code, hexd) {
			gsub(/\\/, "\\\\\\\\", s)
			gsub(/"/, "\\\"", s)
			# The named-control replacements carry one source backslash ("\\n"):
			# gawk >= 5.3 uses the replacement value literally after \\\\ collapsing,
			# so "\\\\n" (value \\\\n) would emit two backslashes and break JSON
			# decoding, while older awks that pairwise-collapse emit a non-special
			# backslash-letter pair unchanged; one source backslash is correct under
			# both replacement semantics.
			gsub(/\n/, "\\n", s)
			gsub(/\r/, "\\r", s)
			gsub(/\t/, "\\t", s)
			gsub(/\b/, "\\b", s)
			gsub(/\f/, "\\f", s)
			if (s !~ /[\001-\010\013\014\016-\037]/) return s
			hexd = "0123456789abcdef"
			out = ""; n = length(s)
			for (i = 1; i <= n; i++) {
				c = substr(s, i, 1)
				code = ORDC[c]
				if (code == "" ) {
					out = out c
					continue
				}
				out = out "\\u00" substr(hexd, int(code / 16) + 1, 1) substr(hexd, code % 16 + 1, 1)
			}
			return out
		}
		# The quoted-string form every emitter wraps values in, so call sites
		# never hand-build quote pairs around json_escape.
		function jq(s) {
			return "\"" json_escape(s) "\""
		}
		BEGIN {
			for (ORDI = 1; ORDI <= 31; ORDI++) ORDC[sprintf("%c", ORDI)] = ORDI
		}
'

# Shared awk function source: the task-file header reader every row-level
# emitter runs, so the header-field regexes exist exactly once and the
# dashboard assembler and the versioned JSON readers can never drift on
# what a logical header field is (artifact 28's named drift site between
# assemble_rows and the board-wide scanners). hdr_reset clears the per-file
# state (call before each file's header region); hdr_feed feeds one
# candidate header line, first occurrence wins per field, values kept
# verbatim (trimming is the caller's presentation decision, so the
# assembler's legacy fallbacks stay byte-identical). The field set covers
# every template header field plus the two legacy forms the dashboard
# falls back to (the "# Task:" title and the decorative "*Created:.*"
# line); a caller not needing a field simply never reads it. Self-contained:
# the fragment defines its own whitespace classes with the same values as
# AWK_ROW_HELPERS', so concatenating both fragments is order-independent.
readonly AWK_HEADER_FIELDS='		BEGIN {
			wsp = " \t\r\v\f"
			ws = "[" wsp "]+"
		}
		function hdr_reset(    k) {
			for (k in FLD) delete FLD[k]
			for (k in HAVE) delete HAVE[k]
		}
		function hdr_feed(line) {
			if (!("Title" in HAVE) && match(line, "^# Task:" ws)) { FLD["Title"] = substr(line, RSTART + RLENGTH); HAVE["Title"] = 1 }
			if (!("Status" in HAVE) && match(line, "^\\*\\*Status:\\*\\*" ws)) { FLD["Status"] = substr(line, RSTART + RLENGTH); HAVE["Status"] = 1 }
			if (!("Priority" in HAVE) && match(line, "^\\*\\*Priority:\\*\\*" ws)) { FLD["Priority"] = substr(line, RSTART + RLENGTH); HAVE["Priority"] = 1 }
			if (!("Progress" in HAVE) && match(line, "^\\*\\*Progress:\\*\\*" ws)) { FLD["Progress"] = substr(line, RSTART + RLENGTH); HAVE["Progress"] = 1 }
			if (!("Created" in HAVE) && match(line, "^\\*\\*Created:\\*\\*" ws)) { FLD["Created"] = substr(line, RSTART + RLENGTH); HAVE["Created"] = 1 }
			if (!("DecoCreated" in HAVE) && match(line, "^\\*Created:" ws)) { FLD["DecoCreated"] = substr(line, RSTART + RLENGTH); sub(/\*.*/, "", FLD["DecoCreated"]); HAVE["DecoCreated"] = 1 }
			if (!("Updated" in HAVE) && match(line, "^\\*\\*Updated:\\*\\*" ws)) { FLD["Updated"] = substr(line, RSTART + RLENGTH); HAVE["Updated"] = 1 }
			if (!("Completed" in HAVE) && match(line, "^\\*\\*Completed:\\*\\*" ws)) { FLD["Completed"] = substr(line, RSTART + RLENGTH); HAVE["Completed"] = 1 }
			if (!("Duration" in HAVE) && match(line, "^\\*\\*Duration:\\*\\*" ws)) { FLD["Duration"] = substr(line, RSTART + RLENGTH); HAVE["Duration"] = 1 }
			if (!("Status Reason" in HAVE) && match(line, "^\\*\\*Status Reason:\\*\\*" ws)) { FLD["Status Reason"] = substr(line, RSTART + RLENGTH); HAVE["Status Reason"] = 1 }
			if (!("Owner" in HAVE) && match(line, "^\\*\\*Owner:\\*\\*" ws)) { FLD["Owner"] = substr(line, RSTART + RLENGTH); HAVE["Owner"] = 1 }
			if (!("Checkpoint Gating" in HAVE) && match(line, "^\\*\\*Checkpoint Gating:\\*\\*" ws)) { FLD["Checkpoint Gating"] = substr(line, RSTART + RLENGTH); HAVE["Checkpoint Gating"] = 1 }
			if (!("Latest Update" in HAVE) && match(line, "^\\*\\*Latest Update:\\*\\*" ws)) { FLD["Latest Update"] = substr(line, RSTART + RLENGTH); HAVE["Latest Update"] = 1 }
		}
'

readonly DEFAULT_PRIORITY="Medium"
readonly DEFAULT_STATUS="$STATUS_TRIAGE"
readonly DEFAULT_FROM="Manager"
readonly DEFAULT_TAIL="10"
readonly NA="N/A"
readonly STATUS_VALUES="$STATUS_TRIAGE, $STATUS_READY, $STATUS_IN_PROGRESS, $STATUS_BLOCKED, $STATUS_CANCELLED, $STATUS_COMPLETED"

# The Priority vocabulary is fixed; new/set must reject anything else. The
# board's own corpus uses exactly these three values; the render's
# missing-field default stays Medium.
readonly PRIORITY_VALUES="Low, Medium, High"
# The header fields the task-file template defines, in the canonical order
# the new-task scaffold lays them out in: valid_header_key checks membership
# against this list, HEADER_FIELDS is derived from it for error messages,
# and the header writers insert an absent field before the first present
# field that canonically follows it, so delete/re-insert cycles keep the
# header order stable.
readonly -a TEMPLATE_HEADER_FIELDS=("Created" "Status" "$STATUS_REASON_KEY" "Priority" "Progress" "Owner" "Checkpoint Gating" "Updated" "Completed" "Duration" "Latest Update")

# Comma-separated form of TEMPLATE_HEADER_FIELDS for error messages.
_header_fields_list() {
	local fields
	fields="$(printf '%s, ' "$@")"
	printf '%s' "${fields%, }"
}
readonly HEADER_FIELDS="$(_header_fields_list "${TEMPLATE_HEADER_FIELDS[@]}")"

err() { printf 'tasks: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

# Reader-surface failures carry a stable machine-readable code in trailing
# parentheses: consumers of the versioned JSON readers match the code, not
# the prose. The shared dies below sit on both reader and writer paths, so
# writers gain the suffix too; it is additive text after the pinned message.
readonly CODE_NO_BOARD="NO_BOARD"
readonly CODE_TASK_NOT_FOUND="TASK_NOT_FOUND"
readonly CODE_BOARD_ROOT_ESCAPE="BOARD_ROOT_ESCAPE"
readonly CODE_SECTION_NOT_FOUND="SECTION_NOT_FOUND"
readonly CODE_USAGE="USAGE"
diec() { local code="$1"; shift; err "$* (code: $code)"; exit 1; }

# The CLI clock. Test harnesses may pin it by exporting TASKS_TEST_CLOCK
# ("YYYY-MM-DD HH:MM") together with TASKS_DIR: every derived timestamp
# (header stamps, report and log entries, the new-task filename stamp)
# then follows that value, and `tasks set` accepts the CLI-owned header
# fields so fixtures can backdate deterministically. The clock is honored
# only on an explicitly pinned board (test boards always export both
# variables); a clock without TASKS_DIR dies at startup, so exporting the
# clock alone can never open the seam on an interactive board.
TEST_CLOCK=""
if [[ -n "${TASKS_TEST_CLOCK:-}" ]]; then
	if [[ ! "$TASKS_TEST_CLOCK" =~ ^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\ [0-9][0-9]:[0-9][0-9]$ ]]; then
		die "TASKS_TEST_CLOCK must be CLI-shaped (YYYY-MM-DD HH:MM), got: $TASKS_TEST_CLOCK"
	fi
	[[ -n "${TASKS_DIR:-}" ]] || die "TASKS_TEST_CLOCK is honored only when TASKS_DIR is also exported (test boards set both)"
	TEST_CLOCK="$TASKS_TEST_CLOCK"
fi

# Test-only lock-hold seam: with TASKS_TEST_LOCK_HOLD_MS set (alongside
# TASKS_DIR, same co-gate as the clock), every writer holds the board lock
# for that many milliseconds after acquiring it, so a second writer
# provably blocks on the flock instead of serializing by scheduler luck
# and the concurrency battery's no-lost-update assertion becomes a
# serialization proof. Unset: no-op.
LOCK_HOLD_SECS=""
if [[ -n "${TASKS_TEST_LOCK_HOLD_MS:-}" ]]; then
	if [[ ! "$TASKS_TEST_LOCK_HOLD_MS" =~ ^[1-9][0-9]*$ ]]; then
		die "TASKS_TEST_LOCK_HOLD_MS must be a positive integer of milliseconds, got: $TASKS_TEST_LOCK_HOLD_MS"
	fi
	[[ -n "${TASKS_DIR:-}" ]] || die "TASKS_TEST_LOCK_HOLD_MS is honored only when TASKS_DIR is also exported (test boards set both)"
	LOCK_HOLD_SECS="$(awk -v ms="$TASKS_TEST_LOCK_HOLD_MS" 'BEGIN { printf "%.3f", ms / 1000 }')"
fi

# Test-only crash-window seam: with TASKS_TEST_CRASH_POINT set (same
# co-gate), the edit section-write path pauses that many seconds between
# staging the new body and committing it with mv, so the crash battery can
# SIGKILL inside the real window (staged tmp written, commit not yet made)
# and exercise the old-or-new invariant deterministically. Unset: no-op.
CRASH_POINT_SECS=""
if [[ -n "${TASKS_TEST_CRASH_POINT:-}" ]]; then
	if [[ ! "$TASKS_TEST_CRASH_POINT" =~ ^[1-9][0-9]*(\.[0-9]+)?$ ]]; then
		die "TASKS_TEST_CRASH_POINT must be a positive number of seconds, got: $TASKS_TEST_CRASH_POINT"
	fi
	[[ -n "${TASKS_DIR:-}" ]] || die "TASKS_TEST_CRASH_POINT is honored only when TASKS_DIR is also exported (test boards set both)"
	CRASH_POINT_SECS="$TASKS_TEST_CRASH_POINT"
fi

now() {
	if [[ -n "$TEST_CLOCK" ]]; then printf '%s\n' "$TEST_CLOCK"; else date '+%Y-%m-%d %H:%M'; fi
}

# The new-task filename stamp form of the clock (YYYYMMDD-HHMM).
now_stamp() {
	local digits
	digits="$(now | tr -d ' :-')"
	printf '%s-%s\n' "${digits:0:8}" "${digits:8:4}"
}

# The Status vocabulary is fixed; new/set must reject anything else.
valid_status() {
	case "$1" in
		"$STATUS_TRIAGE"|"$STATUS_READY"|"$STATUS_IN_PROGRESS"|"$STATUS_BLOCKED"|"$STATUS_CANCELLED"|"$STATUS_COMPLETED") return 0 ;;
		*) return 1 ;;
	esac
}

# Task IDs are PREFIX-N with optional hierarchical -N segments (LRU-4,
# LRU-4-2). The ID leads the filename, so anything outside this shape
# (spaces, slashes, glob characters) must never reach a path.
valid_task_id() {
	[[ "$1" =~ ^[A-Za-z]+(-[0-9]+)+$ ]]
}

# The Priority vocabulary is fixed; new/set must reject anything else.
valid_priority() {
	case "$1" in
		Low|Medium|High) return 0 ;;
		*) return 1 ;;
	esac
}

# The header keys `tasks set` may write are exactly the fields the task-file
# template defines (see the task-files skill's Task File Template). A near
# miss like "StatusReason" must be rejected, not inserted as a new field.
valid_header_key() {
	local candidate
	for candidate in "${TEMPLATE_HEADER_FIELDS[@]}"; do
		[[ "$1" == "$candidate" ]] && return 0
	done
	return 1
}

# Report slugs become filename segments under reports/; strict kebab-case
# keeps that namespace path-safe (no dots, slashes, or case drift).
valid_slug() { [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; }

# A stable per-session identifier for claims. Callers may override with
# --owner or TASKS_SESSION; the pid fallback keeps distinct shells distinct.
session_id() { printf '%s' "${TASKS_SESSION:-$(hostname -s 2>/dev/null || hostname)-$$}"; }

usage() {
	cat <<'EOF'
Usage: tasks <command> [options]

Commands:
  init [--dir DIR]                     Scaffold a .tasks/ directory and empty board.
  render [--dir DIR]                   Rebuild dashboard.md from the task files (locked).
  new --id ID --name NAME [opts]       Create a task file with canonical header fields.
                                       opts: --status S (Triage or Ready; a test board
                                       pinning the clock seam may set deeper states)
                                       --priority P --dir DIR; --force admits a
                                       deliberate task ID reuse (IDs are unique across
                                       current/ and archive/)
  set [--dir DIR] <taskfile> K=V...    Update header field(s), refresh Updated, render.
                                       CLI-owned timeline fields (Created, Updated,
                                       Completed, Duration, Latest Update) refuse
                                       direct writes; closure goes through close;
                                       Owner is claim-owned (claim/release only);
                                       Priority and Progress validate against the
                                       header contract
  report [--dir DIR] <taskfile> --slug SLUG [--from WORKER] --digest TEXT [<file>|-]
                                       Deposit a report file under reports/ and
                                       link it from the Work Log (locked).
  log [--dir DIR] <taskfile> [--from WORKER] MSG
                                       Append a Work Log entry attributed to
                                       WORKER (default Manager), render.
  edit [--dir DIR] <taskfile> --section HEADING [--append] [<file>|-]
                                       Replace or append a section body from
                                       <file> or stdin, refresh Updated, render
                                       (locked).
  show [--dir DIR] <taskfile> [--tail N] [--json] [--section HEADING] [--raw]
                                       Print header fields, Latest Update, and
                                       the last N Work Log entries (default 10).
                                       --json prints the schema_version 1
                                       snapshot (every header field, complete
                                       section bodies, structured Work Log);
                                       --section prints one section's canonical
                                       body (the edit write model's span, so
                                       read and write round-trip); --raw prints
                                       the whole file byte-exact.
  list [--dir DIR] [--json] [--lane NAME] [--limit N] [--offset N]
                                       Read-only board listing in dashboard lane
                                       order. --json emits the schema_version 1
                                       payload (logical fields, owner and claim
                                       restrictions included); --lane filters one
                                       lane; --limit/--offset page the sorted set.
  reports [--dir DIR] <taskfile> [--json] [--include-body] [--limit N] [--offset N]
                                       Read-only report index for one task with
                                       Work Log provenance (stamp, from, digest).
                                       --include-body adds report bodies (--json
                                       only); --limit/--offset page by sequence.
  export [--dir DIR] [--format jsonl] [--include-reports]
                                       Lossless JSONL export of the board's task
                                       files (reports added by --include-reports):
                                       raw content plus a final_newline flag
                                       reconstruct every file byte-exactly.
  lint [--dir DIR] [--verbose]         Read-only board lint (sections, header shape, reason
                                       coupling, dead report links, checkbox drift, claim/archive
                                       hygiene, commit reachability); exits 1 on hard
                                       findings. --verbose lists every advisory.
  doctor [--dir DIR] [--json] [--all]  Read-only diagnostics for the eight stable problem-code
                                       classes (DUPLICATE_ID, FILE_NAMING, STATUS_REASON,
                                       STALE_CLAIM, MISSING_DEP, DEP_CYCLE, DEAD_REPORT_LINK,
                                       DASHBOARD_DIVERGENCE), grandfathered to fire only on
                                       the live working set; --all also lists the findings
                                       grandfathered away under a GRANDFATHERED marker with
                                       their own count; always exits 0 (lint enforces).
  frontier [--dir DIR] [--json]        Read-only dependency-ready frontier and graph over the
                                       shared dependency-token scan: a live Ready task whose
                                       resolvable dependencies are all terminal is Runnable
                                       (derived, reported beside the declared status).
                                       Unknown deps on active work fail closed (the doctor
                                       flags them; the frontier never reports the task
                                       runnable); legacy unknown deps on Ready/Triage report
                                       in unknown_deps without blocking; archived deps
                                       resolve by header status; self-deps are ignored;
                                       live-cycle membership surfaces in cycle without
                                       gating Runnable (the doctor's DEP_CYCLE stays the
                                       repair arm). The human view lists the runnable and
                                       open rows; --json emits the schema_version 1 payload
                                       (tasks plus the from->to dep edges).
  claim <taskfile> [--owner ID]        Atomically claim a task (O_EXCL sidecar), render.
  release <taskfile>                   Release a claim and clear Owner, render. A claim
                                       owned by another session warns with both
                                       identities and proceeds (recovery unlock).
  archive [--dir DIR] <taskfile>       Move a terminal (Completed or Cancelled) task
                                       from current/ into archive/, dropping any
                                       claim sidecar; render.
  close [--dir DIR] <taskfile>         Stamp and transition to Completed: Status, Completed
                                       (CLI clock), elapsed Duration (first-to-last Work
                                       Log anchors), Updated; drops Status Reason and
                                       any claim; render. The closure gate refuses when
                                       Success Criteria carry unticked boxes (a
                                       '- ~ [ ] ' line is a superseded annotation:
                                       resolved for the gate, listed in the close Work
                                       Log entry), a criterion carries
                                       (verdict: unverifiable) without a documented
                                       (exception: ...) on the same line, or a child
                                       named on a dedicated dependency surface is
                                       unfinished; --force closes anyway and records
                                       the override in the Work Log.
                                       --cancelled transitions to Cancelled instead: Status,
                                       Duration, Updated (no Completed stamp); keeps the
                                       Status Reason already on file (refused without one),
                                       drops any claim; render.
  stamp [--dir DIR] <taskfile>         Re-stamp Completed and the elapsed Duration (first
                                       to last Work Log anchor) on an already Completed
                                       task from the CLI clock; render.
                                       --repair inspects each stamped timeline field
                                       (Updated, Duration, Completed, Latest Update)
                                       against its canonical shape and re-stamps only
                                       the malformed ones, on any task: the sanctioned
                                       repair for malformed CLI-owned header fields.
  help                                 Show this help.

Options accept "--flag VALUE" or "--flag=VALUE"; only the = form can pass
a value that itself begins with "--" (e.g. --name=--force).

The .tasks/ directory is located from --dir, then $TASKS_DIR, then by walking
up from the current directory, then ./.tasks as a last resort. Writing
commands refuse the bare last resort; show and render only warn about it.
EOF
}

# How the last resolve_tasks_dir call reached its answer: flag (--dir), env
# (TASKS_DIR), walkup (an upward search that found an existing board), or
# fallback (the bare ./.tasks last resort). The guards below hang off this
# marker: writers refuse the fallback root, readers only warn, and every
# other branch passes either way.
RESOLVED_VIA=""
# The resolved directory itself. Resolution assigns both globals in the
# caller's shell instead of printing the directory: a printf contract
# would run inside the $( ) command substitution every caller wraps this
# in, stranding both markers in the subshell where the guards never see
# them.
RESOLVED_TASKS_DIR=""

# Resolve the .tasks directory: explicit value wins, else search upward, else default.
resolve_tasks_dir() {
	local explicit="${1:-}"
	if [[ -n "$explicit" ]]; then RESOLVED_VIA=flag; RESOLVED_TASKS_DIR="$explicit"; return; fi
	if [[ -n "${TASKS_DIR:-}" ]]; then RESOLVED_VIA=env; RESOLVED_TASKS_DIR="$TASKS_DIR"; return; fi
	local dir="$PWD"
	while [[ "$dir" != "/" ]]; do
		if [[ -d "$dir/.tasks" ]]; then RESOLVED_VIA=walkup; RESOLVED_TASKS_DIR="$dir/.tasks"; return; fi
		dir="$(dirname "$dir")"
	done
	RESOLVED_VIA=fallback
	RESOLVED_TASKS_DIR="$PWD/.tasks"
}

# Refuse the bare ./.tasks last resort for mutations: a write pinned by
# nothing (no --dir, no TASKS_DIR) that finds no board walking up would
# land in a stray root at an arbitrary cwd, the stray-board incident class
# this guard exists for.
refuse_fallback_tasks_dir() {
	[[ "$RESOLVED_VIA" == "fallback" ]] || return 0
	die "refusing to write to the bare ./.tasks fallback at $1 (no board found walking up from $PWD); pass --dir, export TASKS_DIR, or run from inside the board's tree"
}

# Writer chokepoint: the fallback refusal first (its remediation covers the
# missing-board case too), then the existence check.
require_tasks_dir_for_write() {
	refuse_fallback_tasks_dir "$1"
	require_tasks_dir "$1"
}

# Reader chokepoint: announce the bare last resort without refusing it, so
# show and render keep their existing outcome (succeed on an existing
# fallback root, keep the missing-board die otherwise).
warn_fallback_tasks_dir() {
	[[ "$RESOLVED_VIA" == "fallback" ]] || return 0
	err "warning: no board found walking up from $PWD; using the bare ./.tasks fallback at $1 (writes refuse it; pass --dir or export TASKS_DIR to pin the board)"
}

# Resolve a task file argument to a real path: as given, or under current/,
# or archive/. Every existing-file candidate is contained to the board root:
# the resolved candidate (readlink -f, so traversal and symlinks cannot
# smuggle a write past a string prefix) must carry the resolved board root
# as a path prefix, which keeps explicit --dir boards, relative in-board
# arguments, and in-board traversal working while refusing any argument
# that escapes the board.
resolve_task_file() {
	local tasks_dir="$1" arg="$2"
	local board; board="$(readlink -f "$tasks_dir")"
	local cand
	if [[ -f "$arg" ]]; then cand="$arg"
	elif [[ -f "$tasks_dir/$CURRENT_DIR/$arg" ]]; then cand="$tasks_dir/$CURRENT_DIR/$arg"
	elif [[ -f "$tasks_dir/$ARCHIVE_DIR/$arg" ]]; then cand="$tasks_dir/$ARCHIVE_DIR/$arg"
	else diec "$CODE_TASK_NOT_FOUND" "task file not found: $arg"
	fi
	local real; real="$(readlink -f "$cand")" || diec "$CODE_TASK_NOT_FOUND" "task file not found: $arg"
	# Literal prefix strip, not a "==" glob: a board root containing glob
	# metacharacters must not let a sibling path match the pattern and slip
	# past containment. under == real means the prefix did not match; under
	# lacking its leading slash means real is the root itself or a sibling.
	local under="${real#"$board"}"
	[[ "$under" != "$real" && "$under" == /* ]] \
		|| diec "$CODE_BOARD_ROOT_ESCAPE" "task file escapes the board root: $arg resolves to $real, outside the board at $board"
	printf '%s' "$cand"
}

# Print the header region of a task file from stdin: everything before the
# first "## " heading.
header_of() { awk '/^## /{exit} {print}'; }

# Assemble each task file's dashboard row in one batched awk process: for
# every file named as an argument, emit one line
# "<lane><SORT_SEP><sortkey><SORT_SEP><idkey><SORT_SEP><row>", where <lane>
# is the dashboard ordinal (1 Triage, 2 Ready, 3 In Progress, 4
# Blocked/Cancelled, 5 Completed, 6 Archive). Paths are relative to the
# board ("<subdir>/<name>.md"), which both fixes the lane subdir and
# identifies the file across the two subdirs; the caller's tasks_dir is
# prefixed back on for reading. This performs
# the whole per-file assembly the render loop used to do in bash: header
# extraction (first occurrence wins, the decorative "*Created: ...*" line
# as the Created fallback), cell escaping (backslash first, then pipes
# and brackets, whitespace collapsed), Task ID derivation from the
# filename's leading ID component, segment-numeric ID sort keys, progress
# normalization, lane selection, and the newest-Updated maximum, which is
# emitted as the final line "7<SORT_SEP><newest>" (ordinal 7 is the
# latest-updated tag, not a lane). Each file is read up to its first
# "## " heading, an empty file yielding the bare defaults.
# Explicit character classes and capture-free matching throughout: mawk
# lacks [[:space:]] and capture arrays, so the program stays inside the
# gawk/mawk intersection.
assemble_rows() {
	# Values travel via the environment (not awk -v) so backslash-bearing
	# paths survive verbatim; the AWK_ prefix avoids the shell's own
	# readonly constant names.
	AWK_NA="$NA" AWK_DEFAULT_PRIORITY="$DEFAULT_PRIORITY" AWK_UNDATED="$UNDATED_SORT_KEY" \
		AWK_TASKS_DIR="$tasks_dir" AWK_CURRENT_DIR="$CURRENT_DIR" AWK_ARCHIVE_DIR="$ARCHIVE_DIR" \
		AWK_ID_KEY_WIDTH="$ID_KEY_SEGMENT_WIDTH" \
		AWK_READY="$STATUS_READY" AWK_IN_PROGRESS="$STATUS_IN_PROGRESS" \
		AWK_BLOCKED="$STATUS_BLOCKED" AWK_CANCELLED="$STATUS_CANCELLED" \
		AWK_COMPLETED="$STATUS_COMPLETED" \
		awk "$AWK_ROW_HELPERS$AWK_HEADER_FIELDS"'
		BEGIN {
			sep = "\034"
			na = ENVIRON["AWK_NA"]
			dp = ENVIRON["AWK_DEFAULT_PRIORITY"]
			undated = ENVIRON["AWK_UNDATED"]
			td = ENVIRON["AWK_TASKS_DIR"] "/"
			cd = ENVIRON["AWK_CURRENT_DIR"]
			ad = ENVIRON["AWK_ARCHIVE_DIR"]
			idw = ENVIRON["AWK_ID_KEY_WIDTH"]
			st_ready = ENVIRON["AWK_READY"]
			st_ip = ENVIRON["AWK_IN_PROGRESS"]
			st_blocked = ENVIRON["AWK_BLOCKED"]
			st_cancelled = ENVIRON["AWK_CANCELLED"]
			st_completed = ENVIRON["AWK_COMPLETED"]
			newest_acc = ""
			for (argi = 1; argi < ARGC; argi++) {
				file = ARGV[argi]
				fb = file
				sub(/.*\//, "", fb)
				subdir = file
				arch = 0
				if (subdir ~ "^" cd "/") {
					subdir = cd
				} else if (subdir ~ "^" ad "/") {
					subdir = ad
					arch = 1
				}
				hdr_reset()
				while ((getline line < (td file)) > 0) {
					if (line ~ /^## /) break
					hdr_feed(line)
				}
				close(td file)
				name = FLD["Title"]; status = FLD["Status"]; priority = FLD["Priority"]
				progress = FLD["Progress"]; created = FLD["Created"]; deco = FLD["DecoCreated"]
				updated = FLD["Updated"]; completed = FLD["Completed"]; duration = FLD["Duration"]
				if (created == "") created = deco
				if (created == "") created = na
				nb = fb
				sub(/\.md$/, "", nb)
				if (name == "") name = nb
				id = taskid(fb)
				idkey = idkeyof(id)
				if (id != "") name = id ": " name
				if (priority == "") priority = dp
				if (duration == "") duration = na
				link = "[" mdescape(name) "](./" subdir "/" mdescape(fb) ")"
				if (updated != "" && updated > newest_acc) newest_acc = updated
				if (arch) {
					sortkey = (completed == "" ? undated : completed)
					row = "| " link " | " mdescape(completed == "" ? na : completed) " | " mdescape(duration) " |"
					print "6" sep sortkey sep idkey sep row
					continue
				}
				sortkey = (created == na ? undated : created)
				if (status == st_ready) {
					row = "| " link " | " mdescape(priority) " | " mdescape(created) " | " mdescape(updated) " |"
					print "2" sep sortkey sep idkey sep row
				} else if (status == st_ip) {
					row = "| " link " | " mdescape(normprog(progress)) " | " mdescape(updated) " | " mdescape(priority) " |"
					print "3" sep sortkey sep idkey sep row
				} else if (status == st_blocked || status == st_cancelled) {
					row = "| " link " | " mdescape(status) " | " mdescape(created) " | " mdescape(updated) " |"
					print "4" sep sortkey sep idkey sep row
				} else if (status == st_completed) {
					sortkey = (completed == "" ? undated : completed)
					row = "| " link " | " mdescape(completed == "" ? updated : completed) " | " mdescape(duration) " |"
					print "5" sep sortkey sep idkey sep row
				} else {
					row = "| " link " | " mdescape(priority) " | " mdescape(created) " | " mdescape(updated) " |"
					print "1" sep sortkey sep idkey sep row
				}
			}
			print "7" sep newest_acc
			exit
		}
	' "$@"
}

slugify() {
	printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
		| sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# --- rendering -------------------------------------------------------------

# Print the dashboard content for a board from the given sorted row-records
# file (assemble_rows output after one LC_ALL=C sort): the pure printer half
# of the render. Same inputs produce byte-identical output, including the
# derived "Last updated" line (the newest Updated timestamp, not
# wall-clock). Strictly read-only; the doctor's divergence check consumes
# this output against the on-disk dashboard without ever writing the board.
board_walk() {
	local rows_file="$1"
	local -a sorted=()
	# Reading a regular file rather than a pipe: bash's mapfile consumes
	# pipes with per-byte reads (the read builtin cannot push back surplus
	# bytes), which at board size costs more in syscall churn than the
	# caller-side temp file; reading a regular file is buffered.
	mapfile -t sorted <"$rows_file"
	local newest="" lane_entry ordinal key_row
	local prev_lane=0 lane_i
	# The walk prints each lane's header exactly where the old per-lane
	# printf block put it, including the header of a lane with no rows
	# (printed when the stream jumps across it, or all of them on an
	# empty board).
	{
		printf '# Task Board Dashboard\n\n'
		printf '*Jira-style task management board. Auto-generated by `tasks render`; do not edit by hand.*\n\n'
		for lane_entry in ${sorted[@]+"${sorted[@]}"}; do
			ordinal="${lane_entry%%"$SORT_SEP"*}"
			lane_entry="${lane_entry#*"$SORT_SEP"}"
			if (( ordinal == LANE_LATEST )); then
				[[ -n "$lane_entry" && "$lane_entry" > "$newest" ]] && newest="$lane_entry"
				continue
			fi
			if (( ordinal != prev_lane )); then
				lane_i=$(( prev_lane + 1 ))
				while (( lane_i <= ordinal )); do
					printf '%s' "${LANE_HEADERS[lane_i]}"
					(( lane_i += 1 ))
				done
				prev_lane=$ordinal
			fi
			key_row="${lane_entry#*"$SORT_SEP"}"
			printf '%s\n' "${key_row#*"$SORT_SEP"}"
		done
		lane_i=$(( prev_lane + 1 ))
		while (( lane_i <= ${#LANE_HEADERS[@]} - 1 )); do
			printf '%s' "${LANE_HEADERS[lane_i]}"
			(( lane_i += 1 ))
		done
		printf '\n---\n\n*Last updated: %s*\n' "${newest:-$NA}"
	}
}

# Collect a board's task-file paths (current/ then archive/, basename
# order), relative to the board root. Shared by every board-wide pass:
# render, lint, and the doctor's divergence check read the same file set.
board_files() { # <tasks_dir> <array-name>
	local tasks_dir="$1" subdir file
	local -n out_files="$2"
	for subdir in "$CURRENT_DIR" "$ARCHIVE_DIR"; do
		[[ -d "$tasks_dir/$subdir" ]] || continue
		for file in "$tasks_dir/$subdir"/*.md; do
			[[ -e "$file" ]] || continue
			out_files+=("${file#"$tasks_dir/"}")
		done
	done
}

# Rebuild dashboard.md from all task files under the board lock (callers
# pre-lock via render; direct callers must hold the lock themselves).
render_unlocked() {
	local tasks_dir="$1"
	# A relative tasks_dir with a leading dash or tilde option-poisons or
	# tilde-expands the utilities the render spawns and the re-parsed trap
	# string; "./" defuses both.
	[[ "$tasks_dir" == -* || "$tasks_dir" == ~* ]] && tasks_dir="./$tasks_dir"
	local dash="$tasks_dir/$DASHBOARD_NAME"
	local tmp; tmp="$(mktemp "$dash.XXXXXX")"
	# Both render temps die with the render span: the EXIT trap runs on
	# every abort set -e produces, where scattered rm calls never
	# execute. The script sets no other EXIT trap, so clearing it here
	# restores the previous state. Cleared after the dashboard commit,
	# when cleanup is moot, so the trap never spans other subcommands.
	# That clear is also why the render span must never nest: the
	# commit's trap - EXIT discards any outer render span's cleanup with
	# it, so no code path may run one render span inside another (none
	# does).
	arm_tmp_cleanup_trap "$tmp"

	local -a files=()
	board_files "$tasks_dir" files

	# The assembled rows route through a temp file rather than a pipe:
	# bash's mapfile consumes pipes with per-byte reads (the read builtin
	# cannot push back surplus bytes), which at board size costs more in
	# syscall churn than the extra mktemp and rm; reading a regular file
	# is buffered. One LC_ALL=C sort orders every row at once: the leading
	# lane ordinal groups the lanes in board order, the sort keys order
	# rows within a lane, and byte order keeps ties deterministic.
	local rows_file; rows_file="$(mktemp "$dash.XXXXXX")"
	arm_tmp_cleanup_trap "$tmp" "$rows_file"
	assemble_rows "${files[@]+"${files[@]}"}" >"$rows_file"
	LC_ALL=C sort -o "$rows_file" "$rows_file"
	board_walk "$rows_file" >"$tmp"
	rm -f "$rows_file"

	mv -f "$tmp" "$dash"
	trap - EXIT
}

# Fail unless the .tasks directory exists.
require_tasks_dir() {
	[[ -d "$1" ]] || diec "$CODE_NO_BOARD" "no .tasks directory at $1 (run 'tasks init')"
}

# Acquire the board lock on fd 9 for this process. The lock is released
# automatically when the process exits, so an abandoned session never
# deadlocks the others. Every read-modify-render span holds it, so
# concurrent mutations serialize instead of racing their writes.
acquire_board_lock() {
	exec 9>"$1/$LOCK_NAME"
	flock 9
	if [[ -n "$LOCK_HOLD_SECS" ]]; then sleep "$LOCK_HOLD_SECS" 9>&-; fi
}

# The crash-window seam pause for the edit section-write path: sleeps only
# when the battery arms TASKS_TEST_CRASH_POINT, so a SIGKILL timed against
# the staged temp lands with the tmp written and the mv not yet made.
crash_point_pause() {
	[[ -n "$CRASH_POINT_SECS" ]] || return 0
	# 9>&-: forked children inherit the lock fd, so an un-closed sleep would
	# keep the board lock alive for the whole pause even after its writer is
	# SIGKILLed; the live writer holds the lock itself, so the child needs
	# no reference and a dead writer must release immediately.
	sleep "$CRASH_POINT_SECS" 9>&- || true
}

# Arm the process EXIT trap to remove the given temp files: every path is
# %-q-escaped into the trap string at set time (printf %q keeps arbitrary
# board and TMPDIR paths byte-safe), so the escapes re-parse as code when
# the trap fires, after the setting frame is gone. %-q run again on the
# fired string would double-escape under a metacharacter TMPDIR and rm
# would receive literal backslashes, leaking the temps. Every staged-temp
# cleanup site funnels through here so this discipline exists in exactly
# one place.
arm_tmp_cleanup_trap() {
	local cleanup="rm -f --" f
	for f in "$@"; do cleanup+=" $(printf '%q' "$f")"; done
	trap "$cleanup" EXIT
}

# Acquire the board lock, then rebuild dashboard.md.
render() {
	local tasks_dir="$1"
	require_tasks_dir "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	render_unlocked "$tasks_dir"
}

# --- header mutation -------------------------------------------------------

# Rewrite the header region placing every "**Key:** ..." line given as
# arguments "<key>\034<line>" in ONE pass: an existing "**Key:** ..." line
# is replaced in place (first occurrence wins, any duplicate key line is
# dropped), an absent one inserts at its canonical template slot (before
# the first present field that canonically follows the key in
# TEMPLATE_HEADER_FIELDS), and end of header is the fallback when no
# successor exists (also covering fields outside the template order).
# Keys emit in canonical template order: at every emission point the
# pending keys are visited sorted by their TEMPLATE_HEADER_FIELDS position
# (stable, so keys outside the template keep command order), which is the
# order the old sequential per-key passes produced when several missing
# keys share one insertion anchor. An EMPTY line deletes the key's
# lines instead of writing one. The per-key lines travel via per-key
# environment variables (not awk -v) so backslashes in user values
# survive verbatim. Atomic: output
# is staged into a temp file and a single mv commits it, so a failure
# mid-pass leaves the original file untouched. Only the header region is
# touched.
write_header_fields() {
	local file="$1"; shift
	# Nothing requested, nothing to write: no temp, no rewrite.
	(($# > 0)) || return 0
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	# The per-key values export under generated names (KEY_1, LINE_1, ...):
	# export, like env, parses each argument as an assignment itself, while
	# a shell env-prefix built from an array would arrive quoted and stop
	# being assignments. Every variable is unset again on every exit path,
	# exported state must never leak to later commands' children.
	local i=0 pair key rc=0
	export TEMPLATE_ORDER="$(printf '%s\034' "${TEMPLATE_HEADER_FIELDS[@]}")" NKEYS="$#"
	for pair in "$@"; do
		((i += 1))
		key="${pair%%$'\034'*}"
		export "KEY_$i=$key" "LINE_$i=${pair#*$'\034'}"
	done
	awk '
		BEGIN {
			inhdr = 1
			nkeys = ENVIRON["NKEYS"] + 0
			for (i = 1; i <= nkeys; i++) {
				k = ENVIRON["KEY_" i]
				keyseq[i] = k
				line_of[k] = ENVIRON["LINE_" i]
				have[k] = 0
			}
			n = split(ENVIRON["TEMPLATE_ORDER"], order, SUBSEP)
			for (i = 1; i <= n; i++) if (order[i] != "") pos[order[i]] = i
			for (i = 1; i <= nkeys; i++) {
				k = ENVIRON["KEY_" i]
				if (k in pos) orderpos[i] = pos[k] + 0
				else orderpos[i] = 1e9 + i
			}
			# Stable insertion sort of the key sequence by canonical
			# position: ties (non-template keys) keep command order.
			for (i = 1; i <= nkeys; i++) emseq[i] = keyseq[i]
			for (i = 2; i <= nkeys; i++) {
				k = emseq[i]
				p = orderpos[i]
				for (j = i - 1; j >= 1 && orderpos[j] > p; j--) {
					emseq[j + 1] = emseq[j]
					orderpos[j + 1] = orderpos[j]
				}
				emseq[j + 1] = k
				orderpos[j + 1] = p
			}
		}
		function emit_key(k) { if (line_of[k] != "") print line_of[k]; have[k] = 1 }
		function pending_emit() {
			for (i = 1; i <= nkeys; i++) if (!have[emseq[i]]) emit_key(emseq[i])
		}
		inhdr && /^## / {
			pending_emit()
			inhdr = 0
		}
		{
			if (inhdr) {
				if (match($0, /^\*\*[^*:]+:\*\*/)) {
					field = substr($0, RSTART + 2, RLENGTH - 5)
					if (field in pos)
						for (i = 1; i <= nkeys; i++) {
							k = emseq[i]
							if (!have[k] && (k in pos) && pos[field] > pos[k]) emit_key(k)
						}
				}
				for (i = 1; i <= nkeys; i++) {
					k = emseq[i]
					if ($0 ~ ("^\\*\\*" k ":\\*\\*")) {
						if (!have[k]) emit_key(k)
						next
					}
				}
			}
			print
		}
		END { pending_emit() }
	' "$file" >"$tmp" || rc=1
	if ((rc == 0)); then
		mv -f "$tmp" "$file" || rc=1
	fi
	unset TEMPLATE_ORDER NKEYS
	for ((key = 1; key <= i; key++)); do unset "KEY_$key" "LINE_$key"; done
	((rc != 0)) && rm -f "$tmp"
	return "$rc"
}

# Replace a "**Key:** value" line within the header, or insert it at its
# canonical template slot when absent (see write_header_fields). An empty
# value removes the line instead: a blank field is never written (a
# deleted reason must not survive as an empty duplicate).
set_header_field() {
	local file="$1" key="$2" value="$3"
	if [[ -z "$value" ]]; then
		write_header_fields "$file" "$key"$'\034'
		return
	fi
	write_header_fields "$file" "$key"$'\034'"**$key:** $value"
}

# Append a Work Log entry at the end of the "## Work Log" section and
# refresh the Updated/Latest Update header fields in one atomic rewrite:
# output is staged into a temp file and a single mv commits it, so a
# failure mid-pass leaves the original file untouched. Entry and field
# values travel via ENVIRON (not awk -v) so backslashes in user text
# survive verbatim. Empty updated/latest skips that refresh rather than
# blanking the field. Returns non-zero without touching the file if any
# stage fails.
append_work_log_entry() {
	local file="$1" entry="$2" updated="$3" latest="${4:-}"
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	ENTRY="$entry" UPDATED="$updated" LATEST="$latest" awk '
		BEGIN {
			inhdr = 1; inwork = 0; done_u = 0; done_l = 0; prevblank = 1
			entry = ENVIRON["ENTRY"]; updated = ENVIRON["UPDATED"]; latest = ENVIRON["LATEST"]
		}
		inhdr && /^## / {
			if (updated != "" && !done_u) { print "**Updated:** " updated; done_u = 1 }
			if (latest != "" && !done_l) { print "**Latest Update:** " latest; done_l = 1 }
			inhdr = 0
		}
		{
			if (inhdr && updated != "" && !done_u && $0 ~ /^\*\*Updated:\*\*/) {
				print "**Updated:** " updated; done_u = 1; next
			}
			if (inhdr && latest != "" && !done_l && $0 ~ /^\*\*Latest Update:\*\*/) {
				print "**Latest Update:** " latest; done_l = 1; next
			}
			if ($0 ~ /^## Work Log/) { inwork = 1; print; next }
			if (inwork && /^## /) {
				if (entry != "") {
					if (!prevblank) print ""
					printf "%s", entry
					entry = ""
				}
				inwork = 0
			}
			print
			prevblank = ($0 == "")
		}
		END {
			if (entry != "") {
				if (!prevblank) print ""
				printf "%s", entry
			}
			if (updated != "" && !done_u) print "**Updated:** " updated
			if (latest != "" && !done_l) print "**Latest Update:** " latest
		}
	' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# Print the heading level (2..6) of the first section heading matching the
# given name, reading the file without writing anything, and exit non-zero
# when no heading matches. Level-1 headings are the document title, not
# sections, and never match, so a --section naming the title is reported
# as unknown instead of silently replacing everything below it.
section_level() {
	SECTION="$2" awk "$AWK_HEADING_LEVEL"'
		BEGIN { section = ENVIRON["SECTION"]; found = 0 }
		{
			level = heading_level($0)
			if (level >= 2 && HTEXT == section) { print level; found = 1; exit }
		}
		END { exit found ? 0 : 1 }
	' "$1"
}

# Report whether the file carries a section heading matching the given name
# at level 2 or deeper. A thin wrapper over section_level for callers that
# only need the existence bit.
section_exists() { section_level "$1" "$2" >/dev/null; }

# Report whether the named section is one the task-file template defines,
# and so may be created when absent. Sections outside the template stay
# unknown and are refused.
can_create_section() {
	local candidate
	for candidate in "${TEMPLATE_SECTIONS[@]}"; do
		[[ "$candidate" == "$1" ]] && return 0
	done
	return 1
}

# Print the first section of the canonical template order that comes after
# the given section and exists in the file: the anchor the new section is
# inserted before. Prints nothing when no successor exists (the new section
# belongs at the end of the file).
canonical_section_anchor() {
	local file="$1" section="$2" candidate after=0
	for candidate in "${TEMPLATE_SECTIONS[@]}"; do
		if ((after == 0)); then
			[[ "$candidate" == "$section" ]] && after=1
			continue
		fi
		if section_exists "$file" "$candidate"; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	return 0
}

# Insert a section heading and its body at the named anchor heading, or at
# end of file when the anchor is empty, in one atomic rewrite: output is
# staged into a temp file and a single mv commits it, so a failure mid-pass
# leaves the original file untouched. Blank lines separate the new section
# from the surrounding content, keeping the canonical heading/body layout.
# The anchor must exist when non-empty; a missing anchor fails the write
# instead of silently appending. Section name, body, and mode travel via
# ENVIRON (not awk -v) so backslashes in user text survive verbatim.
insert_section_body() {
	local file="$1" section="$2" body="$3" anchor="$4"
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	NEW_SECTION="$section" NEW_BODY="$body" ANCHOR="$anchor" awk "$AWK_HEADING_LEVEL"'
		function emit_section() {
			if (!prevblank) print ""
			print "## " section
			print ""
			printf "%s", body
			if (body != "") print ""
			inserted = 1
		}
		BEGIN {
			section = ENVIRON["NEW_SECTION"]; body = ENVIRON["NEW_BODY"]
			anchor = ENVIRON["ANCHOR"]; atend = anchor == ""
			inserted = 0; prevblank = 1
		}
		{
			if (!inserted && !atend) {
				level = heading_level($0)
				if (level >= 2 && HTEXT == anchor) {
					emit_section()
				}
			}
			print
			prevblank = ($0 == "")
		}
		END {
			if (atend && !inserted) emit_section()
			if (!inserted) exit 1
		}
	' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
	crash_point_pause
	mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# Replace the body of a named section, or append to it, in one atomic
# rewrite: output is staged into a temp file and a single mv commits it, so
# a failure mid-pass leaves the original file untouched. The section spans
# its heading through the line before the next heading of the same or
# higher level; replace swaps that whole region for the new body, append
# inserts the new body after the existing one (trailing blank lines
# trimmed) with a blank line between. The blank separator line under the
# section heading is always preserved (consumed from the original when
# present), so both modes keep the canonical heading/body layout. Sections
# match at level 2 and deeper only; the level-1 document title is not a
# section. Section name, new body, and mode travel via ENVIRON (not
# awk -v) so backslashes in user text survive verbatim. Returns non-zero
# without touching the file when no section heading matches.
replace_section_body() {
	local file="$1" section="$2" body="$3" append="$4"
	local tmp; tmp="$(mktemp "$file.XXXXXX")" || return 1
	SECTION="$section" EDIT_BODY="$body" EDIT_APPEND="$append" awk "$AWK_HEADING_LEVEL"'
		function flush_body(    i) {
			while (nbuf > 0 && buf[nbuf] == "") nbuf--
			for (i = 1; i <= nbuf; i++) print buf[i]
		}
		BEGIN {
			section = ENVIRON["SECTION"]
			body = ENVIRON["EDIT_BODY"]
			appending = ENVIRON["EDIT_APPEND"] == "1"
			state = 0; found = 0; nbuf = 0; fresh = 0
		}
		{
			if (state == 2) { print; next }
			level = heading_level($0)
			if (state == 0) {
				if (level >= 2 && HTEXT == section) {
					found = 1; sec_level = level; state = 1; fresh = 1
					print
					print ""
					next
				}
				print; next
			}
			if (fresh) {
				fresh = 0
				if ($0 == "") next
			}
			if (level && level <= sec_level) {
				if (appending) {
					flush_body()
					if (body != "") {
						if (nbuf > 0) print ""
						print body
						print ""
					}
				} else {
					print body
					print ""
				}
				print
				state = 2
				next
			}
			if (appending) buf[++nbuf] = $0
			next
		}
		END {
			if (!found) exit 1
			if (state == 1) {
				if (appending) {
					flush_body()
					if (body != "") {
						if (nbuf > 0) print ""
						print body
					}
				} else {
					print body
				}
			}
		}
	' "$file" >"$tmp" || { rm -f "$tmp"; return 1; }
	crash_point_pause
	mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# --- commands --------------------------------------------------------------

# Every option accepts a --flag=VALUE long form in addition to the
# space-separated one. The long form is the only way to express a value
# that itself starts with "--": the space form refuses flag-shaped tokens
# as values, so a name like "--force" is only spellable --name=--force.

cmd_init() {
	local dir=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "init: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) die "init: unknown argument: $1" ;;
		esac
	done
	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	refuse_fallback_tasks_dir "$tasks_dir"
	mkdir -p "$tasks_dir/$CURRENT_DIR" "$tasks_dir/$ARCHIVE_DIR"
	render "$tasks_dir"
	printf '%s\n' "$tasks_dir"
}

cmd_render() {
	local dir=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "render: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) die "render: unknown argument: $1" ;;
		esac
	done
	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	render "$tasks_dir"
}

cmd_new() {
	local id="" name="" status="$DEFAULT_STATUS" priority="$DEFAULT_PRIORITY" dir="" force=0
	while (($#)); do
		case "$1" in
			--id) [[ $# -ge 2 && "$2" != --* ]] || die "new: --id requires a value"; id="$2"; shift 2 ;;
			--id=*) id="${1#*=}"; shift ;;
			--name) [[ $# -ge 2 && "$2" != --* ]] || die "new: --name requires a value"; name="$2"; shift 2 ;;
			--name=*) name="${1#*=}"; shift ;;
			--status) [[ $# -ge 2 && "$2" != --* ]] || die "new: --status requires a value"; status="$2"; shift 2 ;;
			--status=*) status="${1#*=}"; shift ;;
			--priority) [[ $# -ge 2 && "$2" != --* ]] || die "new: --priority requires a value"; priority="$2"; shift 2 ;;
			--priority=*) priority="${1#*=}"; shift ;;
			--force) force=1; shift ;;
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "new: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) die "new: unknown option: $1" ;;
		esac
	done
	[[ -n "$id" ]] || die "new: --id is required"
	[[ -n "$name" ]] || die "new: --name is required"
	# The name titles the file's level-1 heading and the dashboard row, both
	# single-line surfaces; a newline would inject bogus structure into both.
	[[ "$name" != *$'\n'* && "$name" != *$'\r'* ]] \
		|| die "new: --name must be a single line"
	valid_task_id "$id" || die "new: invalid task ID: $id (expected PREFIX-N, hierarchically PREFIX-N-N)"
	valid_status "$status" || die "new: unknown status: $status (valid: $STATUS_VALUES)"
	# Creation admits only the two intake states: deeper states are
	# lifecycle positions reachable through set/claim/release/close, and a
	# directly created Blocked file would skip the reason coupling while a
	# directly created terminal file would carry no closure stamps. Test
	# boards pinning the clock seam (TASKS_TEST_CLOCK with TASKS_DIR) admit
	# the full vocabulary for fixtures, mirroring the set guard.
	if [[ -z "$TEST_CLOCK" ]]; then
		case "$status" in
			"$STATUS_TRIAGE"|"$STATUS_READY") ;;
			*) die "new: --status accepts only $STATUS_TRIAGE or $STATUS_READY (got: $status; deeper states are lifecycle positions reachable through set/claim/release/close)" ;;
		esac
	fi
	valid_priority "$priority" || die "new: unknown priority: $priority (valid: $PRIORITY_VALUES)"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"

	# An ID names one piece of work across the whole board, current/ and
	# archive/ alike: a second new carrying a live ID would split it across
	# two files, so it is refused unless --force admits the deliberate
	# reuse. The glob carries the dash of the "<id>-<stamp>-<slug>" naming
	# scheme, so API-10 never trips API-1's guard.
	if ((force == 0)); then
		local -a dupes=()
		local dupe
		for dupe in "$tasks_dir/$CURRENT_DIR/$id-"*.md "$tasks_dir/$ARCHIVE_DIR/$id-"*.md; do
			[[ -e "$dupe" ]] || continue
			dupes+=("${dupe#"$tasks_dir"/}")
		done
		((${#dupes[@]} > 0)) \
			&& die "new: task ID $id already exists: ${dupes[*]} (pass --force to reuse it deliberately)"
	fi

	local ts; ts="$(now)"
	local stamp; stamp="$(now_stamp)"
	local body; body="$(cat <<EOF
# Task: $name

**Created:** $ts
**Status:** $status
**Priority:** $priority
**Progress:** 0%
**Owner:**
**Updated:** $ts
**Latest Update:** [$ts] Task created ([detail](#execution-log))

## Table of Contents

- [Objective](#objective)
- [Success Criteria](#success-criteria)
- [Work Log](#work-log)
- [Execution Log](#execution-log)

---

## Objective

[$id] $name

## Success Criteria

- [ ] TODO

## Work Log

## Execution Log

- $ts - Task file created
EOF
)"

	# Exclusive create (noclobber) makes the existence test atomic, so a
	# concurrent new can never clobber this file; on a same-minute name
	# collision, retry with an incremented numeric suffix.
	local slug; slug="$(slugify "$name")"
	local n=1 candidate file
	while :; do
		if ((n == 1)); then candidate="$tasks_dir/$CURRENT_DIR/$id-$stamp-$slug.md"
		else candidate="$tasks_dir/$CURRENT_DIR/$id-$stamp-$slug-$n.md"; fi
		if (set -o noclobber; printf '%s\n' "$body" >"$candidate") 2>/dev/null; then
			file="$candidate"
			break
		fi
		[[ -e "$candidate" ]] || die "new: cannot create task file $candidate (check permissions)"
		n=$((n + 1))
	done
	render_unlocked "$tasks_dir"
	printf '%s\n' "$file"
}

cmd_set() {
	local dir="" args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "set: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} >= 1)) || die "set: usage: tasks set <taskfile> Key=Value..."

	# Validate every pair before touching the file, so a bad key or a bad
	# Status cannot leave a half-applied update behind. The Status/Status
	# Reason coupling needs the file's current header, so it is enforced
	# under the board lock below, still ahead of the first write.
	local pair key value i new_status status_reason_value status_reason_given
	new_status=""
	status_reason_value=""
	status_reason_given=0
	for ((i = 1; i < ${#args[@]}; i++)); do
		pair="${args[$i]}"
		[[ "$pair" == *=* ]] || die "set: expected Key=Value, got: $pair"
		key="${pair%%=*}"
		value="${pair#*=}"
		valid_header_key "$key" \
			|| die "set: unknown header key: $key (valid fields: $HEADER_FIELDS)"
		# Ownership never moves through set: the Owner field is written by
		# claim (atomically, alongside its O_EXCL sidecar) and cleared by
		# release, so a header Owner without a sidecar is exactly the drift
		# the board lint flags as hard. This refusal is unconditional - it
		# does not open under the test clock seam, because the seam exists
		# for fixture backdating of timeline fields, not for ownership.
		if [[ "$key" == "Owner" ]]; then
			die "set: 'Owner' is claim-owned; ownership changes go through 'tasks claim' and 'tasks release'"
		fi
		# CLI-owned header fields take no direct writes: the timeline is
		# stamped by the CLI's own operations (log, report, claim, close,
		# stamp), and backdating them through set is exactly the drift the
		# Option-1 contract exists to stop. Test boards pin TASKS_TEST_CLOCK
		# together with TASKS_DIR, which unlocks these fields for fixture
		# backdating.
		if [[ -z "$TEST_CLOCK" ]]; then
			case "$key" in
				Created|Updated|Completed|Duration|"Latest Update")
					die "set: '$key' is CLI-owned; the header timeline is stamped by log/report/claim/close/stamp, not set" ;;
			esac
			if [[ "$key" == "Status" && "$value" == "$STATUS_COMPLETED" ]]; then
				die "set: Status=$STATUS_COMPLETED must go through 'tasks close' (closure stamps Completed, Duration, and Updated)"
			fi
			if [[ "$key" == "Status" && "$value" == "$STATUS_CANCELLED" ]]; then
				die "set: Status=$STATUS_CANCELLED must go through 'tasks close --cancelled' (closure stamps Duration and Updated; set the $STATUS_REASON_KEY while $STATUS_BLOCKED and it survives the closure)"
			fi
		fi
		if [[ "$key" == "Status" ]]; then
			valid_status "$value" || die "set: unknown status: $value (valid: $STATUS_VALUES)"
			new_status="$value"
		elif [[ "$key" == "Priority" ]]; then
			valid_priority "$value" || die "set: unknown priority: $value (valid: $PRIORITY_VALUES)"
		elif [[ "$key" == "Progress" && -n "$value" ]]; then
			# The dashboard's percent normalization is a render fallback for
			# legacy files, never a license for set to write one: the header
			# contract carries Progress as N%, so anything else is refused
			# here instead of being silently coerced at render time, and the
			# percentage itself is bounded to 0-100 inclusive.
			[[ "$value" =~ ^[0-9]+%$ ]] \
				|| die "set: Progress must be an N% percentage, got: $value (e.g. 45%)"
			# Range as a regex, not arithmetic: bash arithmetic wraps modulo
			# 2^64, so an astronomically large N could wrap to a passing value;
			# 0* tolerates leading zeros (007% is 7, 0100% is 100).
			[[ "$value" =~ ^0*([0-9]{1,2}|100)%$ ]] \
				|| die "set: Progress must be 0-100 inclusive, got: $value (e.g. 45%)"
		elif [[ "$key" == "$STATUS_REASON_KEY" ]]; then
			status_reason_value="$value"
			status_reason_given=1
		fi
	done

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	# Status Reason exists only under Blocked/Cancelled (the header contract
	# omits it otherwise), so the effective transition target decides what
	# this call must do with the reason. Landing on Blocked/Cancelled demands
	# a non-empty reason in the same call or already on the file; landing
	# anywhere else with a non-empty reason is a contradiction and is refused
	# rather than silently leaving a stale field behind. A call without a
	# Status pair keeps the file's current status as the target, so clearing
	# the reason on a Blocked task is refused instead of unexplained. The
	# two lookups read the header region directly in bash with the same
	# first-match, whitespace-run semantics as the extraction greps, so a
	# validation-only command spawns nothing here. The read's || guard
	# processes a file whose header lacks the trailing newline, exactly
	# where awk's header_of stops.
	local target_status="$new_status" current_reason=""
	local hline
	local re_status='^\*\*Status:\*\*[[:space:]]+(.*)$'
	local re_reason='^\*\*'"$STATUS_REASON_KEY"':\*\*[[:space:]]+(.*)$'
	local have_status=0 have_reason=0
	# An explicit Status pair already fixed the transition target; only an
	# absent one is read from the file.
	[[ -n "$new_status" ]] && have_status=1
	while IFS= read -r hline || [[ -n "$hline" ]]; do
		[[ "$hline" == "## "* ]] && break
		# First match wins per key even when the value is empty, so the
		# flags - not the variables - gate the capture.
		if ((have_status == 0)) && [[ "$hline" =~ $re_status ]]; then
			target_status="${BASH_REMATCH[1]}"
			have_status=1
		elif ((have_reason == 0)) && [[ "$hline" =~ $re_reason ]]; then
			current_reason="${BASH_REMATCH[1]}"
			have_reason=1
		fi
		((have_status == 1 && have_reason == 1)) && break
	done <"$file"
	if [[ "$target_status" == "$STATUS_BLOCKED" || "$target_status" == "$STATUS_CANCELLED" ]]; then
		if ((status_reason_given == 0)); then
			[[ -n "$current_reason" ]] \
				|| die "set: status $target_status requires a $STATUS_REASON_KEY (why is this task blocked?)"
		else
			[[ -n "$status_reason_value" ]] \
				|| die "set: status $target_status requires a non-empty $STATUS_REASON_KEY (supply one or drop the pair)"
		fi
	else
		if ((status_reason_given == 1)); then
			[[ -z "$status_reason_value" ]] \
				|| die "set: $STATUS_REASON_KEY applies only under $STATUS_BLOCKED/$STATUS_CANCELLED (clear it with ${STATUS_REASON_KEY}= or keep the task $STATUS_BLOCKED)"
		fi
	fi

	# All pairs land in one whole-file rewrite: composed lines (or empty
	# ones for deletions) ride as "<key>\034<line>" entries so a mid-crash
	# can never strand half the pairs, and the Updated refresh joins the
	# same commit. Leaving Blocked/Cancelled drops the reason with the
	# transition (the header contract omits it under any other status),
	# unless this call already manages the pair explicitly; deleting an
	# absent key writes nothing for it, so a task that never carried a
	# reason is not rewritten for nothing beyond the pairs themselves.
	# Reaching a terminal status releases a live claim on the same locked
	# commit, mirroring close: a terminal task owns nothing, so the
	# sidecar would only survive as the stale-claim drift the lint flags.
	# This covers a transition landing in this call and equally a set on
	# a file that is already terminal, where any surviving sidecar is
	# stale by definition.
	local -a writes=()
	local touched_updated=0
	for ((i = 1; i < ${#args[@]}; i++)); do
		pair="${args[$i]}"
		key="${pair%%=*}"
		value="${pair#*=}"
		# Empty means delete everywhere except Updated: set exists to keep
		# that field fresh, the dashboard depends on it, so an emptied
		# Updated= pair is a refresh request, never a deletion. Production
		# never reaches this branch for Updated: the CLI-owned guard above
		# refuses the pair outright (the seam admits it for fixtures), and
		# the refresh that matters happens through the auto-appended write
		# below.
		if [[ "$key" == "Updated" && -z "$value" ]]; then
			value="$(now)"
		fi
		if [[ -z "$value" ]]; then
			writes+=("$key"$'\034')
		else
			writes+=("$key"$'\034'"**$key:** $value")
		fi
		[[ "$key" == "Updated" ]] && touched_updated=1
	done
	((touched_updated == 0)) && writes+=("Updated"$'\034'"**Updated:** $(now)")
	if [[ "$target_status" != "$STATUS_BLOCKED" && "$target_status" != "$STATUS_CANCELLED" ]] \
		&& ((status_reason_given == 0)) && [[ -n "$current_reason" ]]; then
		writes+=("$STATUS_REASON_KEY"$'\034')
	fi
	local release_claim=0
	is_terminal_status "$target_status" && release_claim=1
	if ((release_claim == 1)); then
		writes+=("$CLAIM_RELEASE_WRITE")
	fi
	write_header_fields "$file" ${writes[@]+"${writes[@]}"}
	if ((release_claim == 1)); then
		release_claim "$file"
	fi
	render_unlocked "$tasks_dir"
}

cmd_claim() {
	local owner="" dir="" target=""
	while (($#)); do
		case "$1" in
			--owner) [[ $# -ge 2 && "$2" != --* ]] || die "claim: --owner requires a value"; owner="$2"; shift 2 ;;
			--owner=*) owner="${1#*=}"; shift ;;
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "claim: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) target="$1"; shift ;;
		esac
	done
	[[ -n "$target" ]] || die "claim: usage: tasks claim <taskfile> [--owner ID]"
	[[ -n "$owner" ]] || owner="$(session_id)"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target")"
	local claim="$file$CLAIM_SUFFIX"

	# O_EXCL create: exactly one racer wins. noclobber makes '>' fail if it exists.
	if (set -o noclobber; printf '%s\n' "$owner" >"$claim") 2>/dev/null; then
		write_header_fields "$file" \
			"Owner"$'\034'"**Owner:** $owner" \
			"Updated"$'\034'"**Updated:** $(now)"
		render_unlocked "$tasks_dir"
		printf 'claimed %s by %s\n' "$(basename "$file")" "$owner"
	elif [[ -e "$claim" ]]; then
		die "already claimed by $(cat "$claim" 2>/dev/null || printf 'unknown')"
	else
		die "claim: cannot create $claim (check permissions)"
	fi
}

cmd_release() {
	local dir="" target=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "release: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) target="$1"; shift ;;
		esac
	done
	[[ -n "$target" ]] || die "release: usage: tasks release <taskfile>"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target")"
	# Release is the cooperative unlock behind stale-claim recovery, so a
	# foreign owner is announced, never refused: the warning names both
	# identities and the release proceeds (the recovery policy depends on
	# any board-writer session being able to release a claim left behind
	# by a dead session). The sidecar read is best-effort: an unreadable
	# or empty sidecar releases without an identity to compare.
	local claim="$file$CLAIM_SUFFIX" sidecar_owner="" self_id
	self_id="$(session_id)"
	if [[ -e "$claim" ]]; then
		sidecar_owner="$(head -n 1 "$claim" 2>/dev/null || true)"
		if [[ -n "$sidecar_owner" && "$sidecar_owner" != "$self_id" ]]; then
			err "warning: releasing a claim owned by '$sidecar_owner' from session '$self_id' (recovery unlock proceeds)"
		fi
	fi
	release_claim "$file"
	write_header_fields "$file" \
		"$CLAIM_RELEASE_WRITE" \
		"Updated"$'\034'"**Updated:** $(now)"
	render_unlocked "$tasks_dir"
	printf 'released %s\n' "$(basename "$file")"
}

# Drop a released task's claim sidecar: the rm half of the terminal claim
# release (CLAIM_RELEASE_WRITE carries the blank Owner line, which rides
# the caller's locked header rewrite and commits before this runs).
release_claim() { # file
	rm -f "$1$CLAIM_SUFFIX"
}

# --- closure stamping -------------------------------------------------------

# Read a task file's header field value: the first "**<field>:**" line's
# text, whitespace-trimmed per the CLI's canonical extraction, empty when
# the field is missing, empty, or no header region exists. Shared by the
# closure paths (close, stamp, archive), which gate on Status through
# header_status, and by the callers that inspect a specific field: close
# --cancelled's Status Reason coupling and stamp --repair's per-field
# malformed check.
header_field_value() { # file field
	local file="$1" field="$2"
	awk -v field="$field" '
		/^## / {exit}
		index($0, "**" field ":**") == 1 {
			sub(("^\\*\\*" field ":\\*\\*[ \t]*"), "")
			print
			exit
		}
	' "$file"
}

header_status() { header_field_value "$1" "Status"; }

# Compact CLI duration form from a minute count: "45m", "2h 15m",
# "1d 3h", segments descending and only the nonzero trailing ones carried.
format_duration_minutes() {
	local total=$1 d=0 h=0 out=""
	(( total < 0 )) && { printf '%s\n' "$NA"; return; }
	if (( total >= 1440 )); then
		d=$((total / 1440))
		total=$((total % 1440))
		out="${d}d"
	fi
	if (( total >= 60 )); then
		h=$((total / 60))
		total=$((total % 60))
		out="${out:+$out }${h}h"
	fi
	(( total > 0 )) && out="${out:+$out }${total}m"
	[[ -n "$out" ]] || out="0m"
	printf '%s\n' "$out"
}

# First and last Work Log anchor timestamps (the "### YYYY-MM-DD HH:MM:
# ..." entry headings), in file order, as "first<TAB>last"; empty when the
# section carries fewer than two parseable anchors.
work_log_span() {
	awk '
		/^## Work Log/ { inwork = 1; next }
		inwork && /^## / { exit }
		inwork && /^### [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:/ {
			ts = substr($0, 5, 16)
			if (first == "") first = ts
			last = ts
		}
		END {
			if (first != "" && last != "") print first "\t" last
		}
	' "$1"
}

# Elapsed time from the first to the last Work Log anchor, in minutes;
# N/A when the anchors cannot produce a nonnegative span (fewer than two
# parseable entries, unparseable timestamps, or a log whose entries run
# backwards). The span is wall-clock: Blocked periods and idle waits ride
# inside it, only the anchors bound it.
derive_duration() {
	local span first last a b
	span="$(work_log_span "$1")" || span=""
	[[ -n "$span" ]] || { printf '%s\n' "$NA"; return; }
	first="${span%%$'\t'*}"
	last="${span#*$'\t'}"
	a="$(date -d "$first" +%s 2>/dev/null)" || { printf '%s\n' "$NA"; return; }
	b="$(date -d "$last" +%s 2>/dev/null)" || { printf '%s\n' "$NA"; return; }
	format_duration_minutes $(( (b - a) / 60 ))
}

# Re-stamp a Completed task: Completed and Updated follow the CLI clock and
# the elapsed Duration re-derives from the Work Log anchors. The repair path
# for legacy hand-stamps and re-closure bumps; closing a task that is not
# Completed belongs to `tasks close`.
cmd_stamp() {
	local dir="" repair=0 args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "stamp: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--repair) repair=1; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 1)) || die "stamp: usage: tasks stamp <taskfile> [--repair]"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	local status
	status="$(header_status "$file")"
	if ((repair == 0)); then
		[[ "$status" == "$STATUS_COMPLETED" ]] \
			|| die "stamp: $(basename "$file") is not Completed (status: ${status:-missing}); use 'tasks close' to close it"
	fi

	local ts duration
	ts="$(now)"
	duration="$(derive_duration "$file")"
	if ((repair == 1)); then
		# Repair path for malformed CLI-owned header fields: a hand-mangled
		# Latest Update or Updated left a file with no CLI route back to
		# canonical shape (log refreshes Updated but not Latest Update, and
		# set refuses the fields). Scoped to the fields that actually fail
		# their canonical shape (the lint's own shapes): a repair triggered
		# by one mangled field leaves well-formed siblings (a hand-curated
		# Latest Update note, a close-stamped Duration) untouched, and a
		# file with nothing to repair is reported without a write. An absent
		# or empty stamped field fails its shape and is restored, except
		# Completed, which follows the file's status: present on an open
		# task is the defect itself (deleted) and absent there is canonical
		# (nothing to restore); on a Completed file a missing or malformed
		# Completed is missing closure data and is re-stamped from the
		# clock. Created is left alone: its true value is not
		# reconstructible, and replacing it with the clock would be a worse
		# drift than the one being repaired.
		local tsre='^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]$'
		local durre='^(N/A|([0-9]+(d|h|m))( ([0-9]+(d|h|m)))*)$'
		local lure='^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]\] '
		local value repaired=""
		local -a writes=()
		value="$(header_field_value "$file" "Updated")"
		[[ "$value" =~ $tsre ]] || { writes+=("Updated"$'\034'"**Updated:** $ts"); repaired+=" Updated"; }
		value="$(header_field_value "$file" "Duration")"
		[[ "$value" =~ $durre ]] || { writes+=("Duration"$'\034'"**Duration:** $duration"); repaired+=" Duration"; }
		value="$(header_field_value "$file" "Latest Update")"
		[[ "$value" =~ $lure ]] || { writes+=("Latest Update"$'\034'"**Latest Update:** [$ts] CLI-owned header repaired via 'tasks stamp --repair'"); repaired+=" Latest Update"; }
		value="$(header_field_value "$file" "Completed")"
		if [[ "$status" == "$STATUS_COMPLETED" ]]; then
			[[ "$value" =~ $tsre ]] || { writes+=("Completed"$'\034'"**Completed:** $ts"); repaired+=" Completed"; }
		elif [[ -n "$value" ]]; then
			writes+=("Completed"$'\034')
			repaired+=" Completed"
		fi
		if ((${#writes[@]} == 0)); then
			printf 'nothing to repair in %s\n' "$(basename "$file")"
			return
		fi
		write_header_fields "$file" ${writes[@]+"${writes[@]}"}
		render_unlocked "$tasks_dir"
		printf 'repaired %s (%s)\n' "$(basename "$file")" "${repaired# }"
		return
	fi
	write_header_fields "$file" \
		"Completed"$'\034'"**Completed:** $ts" \
		"Duration"$'\034'"**Duration:** $duration" \
		"Updated"$'\034'"**Updated:** $ts"
	render_unlocked "$tasks_dir"
	printf 'stamped %s (Completed %s, elapsed Duration %s)\n' "$(basename "$file")" "$ts" "$duration"
}

# Archive a terminal task: move the file from current/ into archive/ under
# the board lock, then render. Only Completed or Cancelled tasks archive
# (the header contract's terminal statuses, the same rule the lint's
# archive hygiene enforces); anything else is refused with the closure
# path named. Any claim sidecar is dropped on the way: a terminal task
# owns nothing, so a surviving sidecar is stale by definition. The move
# refuses to overwrite an existing archive file (which also refuses
# re-archiving an already-archived task), and the reports/ tree is
# untouched: deposits are keyed by the task filename, whose basename the
# move preserves, so every ../reports/ link keeps resolving from the new
# directory.
cmd_archive() {
	local dir="" target=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "archive: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			*) target="$1"; shift ;;
		esac
	done
	[[ -n "$target" ]] || die "archive: usage: tasks archive <taskfile>"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target")"

	local status
	status="$(header_status "$file")"
	is_terminal_status "$status" \
		|| die "archive: $(basename "$file") is not terminal (status: ${status:-missing}); only Completed or Cancelled tasks archive (use 'tasks close')"

	local dest="$tasks_dir/$ARCHIVE_DIR/${file##*/}"
	[[ -e "$dest" ]] && die "archive: refusing to overwrite existing archive file: $ARCHIVE_DIR/${dest##*/}"
	# Move first, drop the sidecar second: a failed mv must leave the
	# current/ state exactly as it was, sidecar included. The archived
	# file is terminal, so its claim is released with the move; the Owner
	# blank already rode the closure write that made it terminal.
	mv "$file" "$dest" || die "archive: cannot move $(basename "$file") into $ARCHIVE_DIR (check permissions)"
	release_claim "$file"
	render_unlocked "$tasks_dir"
	printf 'archived %s\n' "${dest##*/}"
}

# The leading Task ID of a task-file basename, mirroring the assembler's
# taskid() extraction: the longest segment-terminated prefix whose
# remainder is exactly ".md" or the stamp form "-YYYYMMDD-HHMM" plus an
# optional slug. Prints nothing when no boundary qualifies.
task_id_of_basename() {
	local fb="$1" p rest cand remainder len
	for ((p = ${#fb} - 1; p > 1; p--)); do
		[[ "${fb:p:1}" == "-" ]] || continue
		rest="${fb:p}"
		[[ "$rest" =~ ^-[0-9]+ ]] || continue
		len=${#BASH_REMATCH[0]}
		cand="${fb:0:p+len}"
		remainder="${fb:p+len}"
		[[ "$cand" =~ ^[A-Za-z]+(-[0-9]+)+$ ]] || continue
		if [[ "$remainder" == ".md" ]] \
			|| [[ "$remainder" =~ ^-[0-9]{8}-[0-9]{4}(-.*)?\.md$ ]]; then
			printf '%s\n' "$cand"
			return
		fi
	done
	return 0
}

# One awk pass over a task file, emitting the closure gate's records:
# "U<TAB>n" (unticked Success Criteria boxes, counted by the shared
# criteria counter AWK_CRITERIA_COUNTER, the exact code the board lint's
# C record runs), one "S<TAB>text" per ~-marked superseded criterion in
# file order, one "V<TAB>text" per criterion carrying an unverifiable
# verdict without a documented (exception: ...) on the same line (the
# mandatory-unverifiable class: a claim closure cannot treat as
# established, admitted only by the recorded exception), and one
# "I<TAB>token" per task-ID-shaped token carried by a
# dedicated dependency surface. The dedicated surfaces are the ##
# Dependencies section body, the template's **Dependencies:** field
# lines, and explicit **Child tasks:** declaration lines; the two field
# forms bind only before the ## Work Log heading, because Work Log
# entries and report digests quote those field forms as prose. Prose
# citations in Work Log entries, risk notes, and report digests are not
# dependency surfaces and yield no tokens (citation is not dependency).
closure_gate_scan() { # <file>
	awk "$AWK_HEADING_LEVEL$AWK_CRITERIA_COUNTER"'
		/^## / {
			track_criteria_section($0)
			indeps = (SECNAME == "Dependencies") ? 1 : 0
			if (!fence && SECNAME == "Work Log") inwork = 1
			next
		}
		{
			box = criteria_box($0)
			if (box == "unchecked") unticked++
			else if (box == "superseded") print "S\t" superseded_text($0)
			if (criteria_verdict($0) == "unverifiable" && !criteria_excepted($0)) {
				vtext = $0
				sub(/^- \[[xX ]\] /, "", vtext)
				sub(/^- ~ \[ \] /, "", vtext)
				sub(/[ \t\r]+$/, "", vtext)
				print "V\t" vtext
			}
			if (indeps || (!inwork && ($0 ~ /^[ \t]*\*\*Dependencies:\*\*/ || $0 ~ /^[ \t]*\*\*[Cc]hild [Tt]asks?:\*\*/))) {
				rest = $0
				while (match(rest, /[A-Za-z]+(-[0-9]+)+/)) {
					print "I\t" substr(rest, RSTART, RLENGTH)
					rest = substr(rest, RSTART + RLENGTH)
				}
			}
		}
		END { print "U\t" unticked + 0 }
	' "$1"
}

# The dependency-token projection of the closure gate's scan: exactly
# the gate's I records (one per task-ID-shaped token carried by a
# dedicated dependency surface, in file order). This is the board's one
# dependency-token consumer path: the closure gate reads the full scan,
# and the doctor's MISSING_DEP/DEP_CYCLE passes and the frontier's graph
# derivation read it through this projection, so a grammar change lands
# in closure_gate_scan alone and every consumer sees it together (the
# battery's cross-consumer agreement test pins the identity).
dependency_tokens() { # <file>
	local rec
	while IFS=$'\t' read -r tag rec; do
		[[ "$tag" == "I" ]] && printf '%s\n' "$rec"
	done < <(closure_gate_scan "$1")
}

# The superseded-criteria fragment of a closure note: "<n> superseded
# Success Criteria: <text>; <text>" from the gate scan's S records (file
# order), empty when the file carries none. A ~-marked criterion counts
# as resolved for the gate while staying visibly unfulfilled, so close
# lists the marked criteria in its Work Log entry and the --force
# override note carries the fragment alongside the overridden findings.
superseded_note() { # <array-name>
	local -n sup="$1"
	((${#sup[@]} > 0)) || return 0
	local joined
	joined="$(IFS=';'; printf '%s' "${sup[*]}")"
	printf '%d superseded Success Criteria: %s' "${#sup[@]}" "$joined"
}

# Closure gate findings for a task about to be completed: every refusal
# finding, appended to the named findings array (an empty array means the
# closure may proceed), plus the file's superseded criteria appended to
# the named superseded array for the closure note. Three finding classes:
# the unticked Success Criteria boxes count, every criterion carrying an
# unverifiable verdict without a documented exception (see the scan's V
# records; the finding lists the criteria in file order), and every child
# task declared on a dedicated dependency surface (see closure_gate_scan)
# that is still open. A declared child is matched when the token resolves
# to a board file whose leading Task ID equals the token; the file's own ID and
# tokens naming no board file are ignored, and a child blocks unless its
# status is terminal (Completed/Cancelled).
closure_gate_findings() { # <findings-array> <superseded-array> <tasks_dir> <file>
	# The namerefs must not share their targets' names: a `local -n
	# findings` pointed at the caller's array of the same name is a
	# circular self reference, and bash resolves it to an empty local
	# instead of an error.
	local -n gate_findings="$1"
	local -n gate_superseded="$2"
	local tasks_dir="$3" file="$4"
	local rec tag unticked=0
	local -a child_tokens=() unverifiable=()
	while IFS=$'\t' read -r tag rec; do
		case "$tag" in
			U) unticked="$rec" ;;
			S) gate_superseded+=("$rec") ;;
			V) unverifiable+=("$rec") ;;
			I) child_tokens+=("$rec") ;;
		esac
	done < <(closure_gate_scan "$file")
	((unticked > 0)) && gate_findings+=("unchecked Success Criteria boxes: $unticked")
	if ((${#unverifiable[@]} > 0)); then
		local joined_verdicts
		joined_verdicts="$(IFS=';'; printf '%s' "${unverifiable[*]}")"
		gate_findings+=("unverifiable Success Criteria verdict(s) without a documented exception: $joined_verdicts")
	fi
	local own_id cand f child_id child_status child_rel
	own_id="$(task_id_of_basename "${file##*/}")"
	local -a children=()
	if ((${#child_tokens[@]} > 0)); then
		while IFS= read -r cand; do
			[[ -n "$cand" && "$cand" != "$own_id" ]] || continue
			for f in "$tasks_dir/$CURRENT_DIR/$cand"*.md "$tasks_dir/$ARCHIVE_DIR/$cand"*.md; do
				[[ -e "$f" ]] || continue
				child_id="$(task_id_of_basename "${f##*/}")"
				[[ "$child_id" == "$cand" ]] || continue
				child_status="$(header_status "$f")"
				is_terminal_status "$child_status" && continue
				child_rel="${f#"$tasks_dir"/}"
				children+=("$cand ($child_rel, Status: ${child_status:-missing})")
			done
		done < <(printf '%s\n' "${child_tokens[@]}" | LC_ALL=C sort -u)
	fi
	((${#children[@]} > 0)) && gate_findings+=("unfinished named child task(s): ${children[*]}")
	return 0
}

# Close a task: transition to Completed with the header timeline stamped
# from the CLI clock, as the one sanctioned write path for closure. Sets
# Status, Completed, the elapsed Duration (first-to-last Work Log anchor,
# N/A when they cannot produce a span), and Updated in one locked header
# rewrite; drops the Status Reason (the header contract carries it only
# under Blocked/Cancelled) and releases any claim sidecar with its Owner
# field, then renders. The completion gate refuses before any write on
# unticked Success Criteria (a ~-marked superseded annotation counts as
# resolved), a criterion carrying an unverifiable verdict without a
# documented exception, or an unfinished child declared on a dedicated
# dependency surface; --force closes past it, recording the override (with any
# superseded fragment) as a Work Log anchor, and a gate that passes on
# ~-marked criteria alone records them as its own Work Log anchor, both
# stamped at the closure clock so Duration derives after the append. The
# assembler and dashboard formats are the locked write path's own, so
# closure rows render byte-compatibly.
cmd_close() {
	local dir="" cancelled=0 force=0 args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "close: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--cancelled) cancelled=1; shift ;;
			--force) force=1; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 1)) || die "close: usage: tasks close <taskfile> [--cancelled] [--force]"
	((cancelled == 1 && force == 1)) \
		&& die "close: --force gates the completion path only; --cancelled closure already requires a deliberate Status Reason"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	local status
	status="$(header_status "$file")"
	[[ "$status" == "$STATUS_COMPLETED" ]] \
		&& die "close: $(basename "$file") is already Completed (use 'tasks stamp' to re-stamp)"

	local ts duration reason
	ts="$(now)"
	local -a superseded=()
	local summary entry note=""
	if ((cancelled == 0)); then
		local -a findings=()
		closure_gate_findings findings superseded "$tasks_dir" "$file"
		if ((${#findings[@]} > 0)); then
			if ((force == 0)); then
				local finding msg
				msg="close: $(basename "$file") fails the closure gate:"
				for finding in "${findings[@]}"; do msg+=$'\n'"  - $finding"; done
				msg+=$'\n'"close anyway with --force; the override is recorded in the Work Log"
				die "$msg"
			fi
			summary="$(IFS=';'; printf '%s' "${findings[*]}")"
			note="$(superseded_note superseded)"
			[[ -n "$note" ]] && summary+="; $note"
			# The override note is a Work Log anchor stamped by the same clock
			# the closure stamps, so deriving Duration after the append makes
			# the stamped span read first anchor to closure, matching the
			# elapsed definition the file itself now carries.
			printf -v entry '### %s: close: closure gate overridden (--force): %s\n\n' "$ts" "$summary"
			append_work_log_entry "$file" "$entry" "" "" \
				|| die "close: failed to record the override in $(basename "$file")"
		elif ((${#superseded[@]} > 0)); then
			# A gate that passes on ~-marked criteria alone still records
			# them: the same Work Log anchor pattern as the override note, so
			# the closure stays visibly annotated in the file it closes.
			printf -v entry '### %s: close: %s\n\n' "$ts" "$(superseded_note superseded)"
			append_work_log_entry "$file" "$entry" "" "" \
				|| die "close: failed to record the superseded criteria in $(basename "$file")"
		fi
	fi
	duration="$(derive_duration "$file")"
	if ((cancelled == 1)); then
		# Cancelled closure: the same CLI-stamped semantics as completion
		# minus the Completed field, so Cancelled files stop carrying
		# hand-derived closure data. The header contract ties Status Reason
		# to Blocked/Cancelled, so unlike completion it stays, and a task
		# that never carried one is refused before any write (set the
		# reason while Blocked and it survives the closure): writing the
		# header without it would strand the file in the exact drift the
		# contract and the board lint reject, blocking every later set. A
		# claim still releases (a terminal task owns nothing).
		[[ "$status" == "$STATUS_CANCELLED" ]] \
			&& die "close: $(basename "$file") is already Cancelled"
		reason="$(header_field_value "$file" "$STATUS_REASON_KEY")"
		[[ -n "$reason" ]] \
			|| die "close: cancelling $(basename "$file") requires a non-empty $STATUS_REASON_KEY (the header contract ties it to $STATUS_CANCELLED); set Status=$STATUS_BLOCKED with one first and it survives the closure"
		write_header_fields "$file" \
			"Status"$'\034'"**Status:** $STATUS_CANCELLED" \
			"Duration"$'\034'"**Duration:** $duration" \
			"Updated"$'\034'"**Updated:** $ts" \
			"$CLAIM_RELEASE_WRITE"
		release_claim "$file"
		render_unlocked "$tasks_dir"
		printf 'cancelled %s (elapsed Duration %s)\n' "$(basename "$file")" "$duration"
		return
	fi
	write_header_fields "$file" \
		"Status"$'\034'"**Status:** $STATUS_COMPLETED" \
		"Completed"$'\034'"**Completed:** $ts" \
		"Duration"$'\034'"**Duration:** $duration" \
		"Updated"$'\034'"**Updated:** $ts" \
		"$STATUS_REASON_KEY"$'\034' \
		"$CLAIM_RELEASE_WRITE"
	release_claim "$file"
	render_unlocked "$tasks_dir"
	printf 'closed %s (Completed %s, elapsed Duration %s)\n' "$(basename "$file")" "$ts" "$duration"
}

# Next report sequence number for a task's reports directory: one past the
# highest NN prefix on disk (base-10 parse strips the zero padding), so
# numbering never reuses a number even when gaps exist.
next_report_seq() {
	local report_dir="$1" max=0 base seq f
	for f in "$report_dir"/*.md; do
		[[ -e "$f" ]] || continue
		base="${f##*/}"
		[[ "$base" =~ ^([0-9]+)- ]] || continue
		seq=$((10#${BASH_REMATCH[1]}))
		((seq > max)) && max="$seq"
	done
	printf '%d' "$((max + 1))"
}

cmd_report() {
	local dir="" slug="" from="" digest=""
	local args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "report: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--slug) [[ $# -ge 2 && "$2" != --* ]] || die "report: --slug requires a value"; slug="$2"; shift 2 ;;
			--slug=*) slug="${1#*=}"; shift ;;
			--from) [[ $# -ge 2 && "$2" != --* ]] || die "report: --from requires a value"; from="$2"; shift 2 ;;
			--from=*) from="${1#*=}"; shift ;;
			--digest) [[ $# -ge 2 && "$2" != --* ]] || die "report: --digest requires a value"; digest="$2"; shift 2 ;;
			--digest=*) digest="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} >= 1 && ${#args[@]} <= 2)) \
		|| die 'report: usage: tasks report <taskfile> --slug <kebab-slug> [--from <worker>] --digest "<one line>" [<file>|-]'
	local target_arg="${args[0]}"
	local content_file="${args[1]:-}"

	# Validate every argument before touching the board, so a bad one can
	# never leave a half-applied deposit behind.
	[[ -n "$slug" ]] || die "report: --slug is required"
	[[ -n "$digest" ]] || die "report: --digest is required"
	valid_slug "$slug" || die "report: invalid slug: $slug (expected kebab-case: lowercase letters, digits, hyphens)"
	[[ "$digest" != *$'\n'* && "$digest" != *$'\r'* ]] || die "report: --digest must be a single line"
	[[ -n "${from//[[:space:]]/}" ]] || from="$DEFAULT_FROM"
	[[ "$from" != *$'\n'* && "$from" != *$'\r'* ]] || die "report: --from must be a single line"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"

	# Read the report content before taking the board lock: content is not
	# board state, an unreadable or empty source must fail before anything
	# changes, and a slow pipe must never stretch the lock hold.
	local content
	if [[ -z "$content_file" || "$content_file" == "-" ]]; then
		content="$(cat)" || die "report: cannot read report content from stdin"
	else
		[[ -f "$content_file" ]] || die "report: report file not found: $content_file"
		content="$(cat "$content_file")" || die "report: cannot read report file: $content_file"
	fi
	[[ -n "$content" ]] || die "report: report content is empty"

	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target_arg")"

	local base; base="${file##*/}"
	local report_dir="$tasks_dir/$REPORTS_DIR/$base"
	mkdir -p "$report_dir" || die "report: cannot create $report_dir (check permissions)"
	local seq; seq="$(next_report_seq "$report_dir")"
	local name; name="$(printf '%02d-%s.md' "$seq" "$slug")"
	local deposit="$report_dir/$name"

	# Stage the deposit and commit with a single mv: a write failure leaves
	# no file behind, and the existence check under the board lock refuses
	# to overwrite an existing report.
	[[ -e "$deposit" ]] && die "report: refusing to overwrite existing report: $REPORTS_DIR/$base/$name"
	local staged; staged="$(mktemp "$report_dir/.reportXXXXXX")" \
		|| die "report: cannot create report in $report_dir (check permissions)"
	printf '%s\n' "$content" >"$staged" || { rm -f "$staged"; die "report: cannot write $deposit"; }
	mv -f "$staged" "$deposit" || { rm -f "$staged"; die "report: cannot create $deposit"; }

	local ts; ts="$(now)"
	local rel="$REPORTS_DIR/$base/$name"
	local entry latest
	printf -v entry '### %s: %s: Report\n\n**Report:** [%s](../%s)\n**Digest:** %s\n\n' \
		"$ts" "$from" "$name" "$rel" "$digest"
	printf -v latest '[%s] %s ([report](../%s))' "$ts" "$digest" "$rel"

	# Commit the task-file side; on failure roll the deposit back, so a
	# report file never exists without its Work Log entry.
	if ! append_work_log_entry "$file" "$entry" "$ts" "$latest"; then
		rm -f "$deposit"
		die "report: failed to update $base (deposit removed)"
	fi
	render_unlocked "$tasks_dir"
	printf '%s\n' "$deposit"
}

cmd_log() {
	local dir="" from="" args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "log: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--from) [[ $# -ge 2 && "$2" != --* ]] || die "log: --from requires a value"; from="$2"; shift 2 ;;
			--from=*) from="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 2)) || die 'log: usage: tasks log <taskfile> [--from <worker>] "<message>"'
	local target_arg="${args[0]}" message="${args[1]}"

	# Validate every argument before touching the board, so a rejected
	# message can never leave a half-applied entry behind.
	[[ -n "${message//[[:space:]]/}" ]] || die "log: message must not be empty"
	local first="${message%%$'\n'*}"
	[[ -n "${first//[[:space:]]/}" ]] || die "log: message's first line must not be blank (it becomes the entry heading)"
	[[ -n "${from//[[:space:]]/}" ]] || from="$DEFAULT_FROM"
	[[ "$from" != *$'\n'* && "$from" != *$'\r'* ]] || die "log: --from must be a single line"
	[[ "$message" != *$'\r'* ]] || die "log: message must not contain carriage return characters"
	# Entry bodies ride verbatim into the Work Log section, whose structure
	# is heading-delimited; a message line shaped like a markdown heading
	# would inject fake sections (or forge entries), so it is refused.
	local heading_re='^#{1,6} ' line
	while IFS= read -r line; do
		[[ "$line" =~ $heading_re ]] && die "log: message lines must not begin with a markdown heading"
	done <<<"$message"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"
	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target_arg")"

	# The first message line becomes the heading title (Jira-style scan
	# value); any remaining lines ride along as the entry body.
	local ts rest entry
	ts="$(now)"
	if [[ "$message" == *$'\n'* ]]; then
		rest="${message#*$'\n'}"
		printf -v entry '### %s: %s: %s\n\n%s\n\n' "$ts" "$from" "$first" "$rest"
	else
		printf -v entry '### %s: %s: %s\n\n' "$ts" "$from" "$first"
	fi
	append_work_log_entry "$file" "$entry" "$ts" "" || die "log: failed to update $(basename "$file")"
	render_unlocked "$tasks_dir"
	printf 'logged %s\n' "$(basename "$file")"
}

cmd_edit() {
	local dir="" section="" append=0
	local args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "edit: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--section) [[ $# -ge 2 && "$2" != --* ]] || die "edit: --section requires a value"; section="$2"; shift 2 ;;
			--section=*) section="${1#*=}"; shift ;;
			--append) append=1; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} >= 1 && ${#args[@]} <= 2)) \
		|| die 'edit: usage: tasks edit <taskfile> --section <heading> [--append] [<file>|-]'
	local target_arg="${args[0]}"
	local content_file="${args[1]:-}"

	# Validate every argument before touching the board, so a rejected edit
	# can never leave a half-applied body behind.
	[[ -n "$section" ]] || die "edit: --section is required"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	require_tasks_dir_for_write "$tasks_dir"

	# Read the new body before taking the board lock: content is not board
	# state, an unreadable or empty source must fail before anything changes,
	# and a slow pipe must never stretch the lock hold.
	local content
	if [[ -z "$content_file" || "$content_file" == "-" ]]; then
		content="$(cat)" || die "edit: cannot read section body from stdin"
	else
		[[ -f "$content_file" ]] || die "edit: section body file not found: $content_file"
		content="$(cat "$content_file")" || die "edit: cannot read section body file: $content_file"
	fi

	# A replacement must never blank a section: an empty body is refused
	# outright. Whether a heading-shaped body line is refused depends on the
	# target section's own level (checked under the lock below): sections
	# are heading-delimited, so a line at the same level or higher would
	# inject a fake section boundary into every later parser pass, while a
	# strictly deeper heading is legal structure (### Decision Log inside
	# ## Technical Approach, ### Task entries inside ## Task Breakdown).
	if ((append == 0)); then
		[[ -n "$content" ]] \
			|| die "edit: refusing to replace section '$section' with an empty body (supply content or use --append)"
	fi

	acquire_board_lock "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "$target_arg")"

	# Section existence is checked read-only under the lock, so every path
	# (including the --append empty-input no-op) refuses an unknown section
	# before anything is written, and a later mktemp or awk write failure
	# reports as an update failure instead of a lookup miss. A missing
	# section the template defines is created instead of refused (the
	# planning pass must never need a hand edit for a new section); anything
	# outside the template stays unknown. Creation without content would
	# write a bare heading, so it is refused too, with its own actionable
	# message; appending nothing to an existing section stays a no-op.
	local sec_level created=0
	if ! sec_level="$(section_level "$file" "$section")"; then
		can_create_section "$section" || die "edit: unknown section: $section"
		# Creation without content would write a bare heading: refuse with
		# the actionable message instead of silently scaffolding.
		[[ -n "$content" ]] \
			|| die "edit: refusing to create section '$section' with an empty body (supply content)"
		created=1
		sec_level="$TEMPLATE_SECTION_LEVEL"
	fi

	# Heading guard, level-aware: refuse heading lines at the target
	# section's level or above; permit strictly deeper structure.
	local heading_line heading_re='^(#{1,6} )' line
	while IFS= read -r line; do
		[[ "$line" =~ $heading_re ]] || continue
		heading_line="${line%% *}"
		(( ${#heading_line} <= sec_level )) \
			&& die "edit: body lines must not begin with a heading at or above the '$section' section's own level"
	done <<<"$content"

	# Work Log entry anchors are CLI-stamped timeline data even though they
	# live in a body section: close and stamp derive Duration from the
	# "### <date> <time>:" headings, and log/report write them from the CLI
	# clock. Option-1's free-form principle covers prose, not CLI-shaped
	# timeline data, so an edit body carrying an anchor-shaped line is
	# refused (append and replace alike); entries go through tasks log and
	# tasks report. The guard's shape is exactly the anchor regex the
	# duration derivation scans for, so anything it would count as an
	# anchor cannot be forged here, and anything looser cannot corrupt the
	# derivation either.
	if [[ "$section" == "Work Log" ]]; then
		local anchor_re='^### [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]:'
		while IFS= read -r line; do
			[[ "$line" =~ $anchor_re ]] \
				&& die "edit: Work Log entry anchors (### <date> <time>: ...) are CLI-stamped; append entries via 'tasks log'"
		done <<<"$content"
	fi

	# --append with empty input is a no-op: skip the rewrite, keep the
	# uniform success bookkeeping (Updated refresh plus render). A created
	# section always has a body, so it never takes this branch.
	if ((created == 1)); then
		insert_section_body "$file" "$section" "$content" \
			"$(canonical_section_anchor "$file" "$section")" \
			|| die "edit: failed to update $(basename "$file")"
	elif ((append == 0)) || [[ -n "$content" ]]; then
		replace_section_body "$file" "$section" "$content" "$append" \
			|| die "edit: failed to update $(basename "$file")"
	fi
	set_header_field "$file" "Updated" "$(now)"
	render_unlocked "$tasks_dir"
	printf 'edited %s\n' "$(basename "$file")"
}

# --- board lint (read-only) ------------------------------------------------

# Severity class of a task file for the lint pass: hard when the file is an
# open task (Triage, Ready, In Progress, Blocked) outside archive/, advisory
# for Completed and Cancelled files and everything archived. Unknown or
# missing statuses classify as open: a file the renderer would drop in the
# Triage lane deserves the stricter eye.
is_terminal_status() { [[ "$1" == "$STATUS_COMPLETED" || "$1" == "$STATUS_CANCELLED" ]]; }

# Hard class of a scanned task file: open (Triage/Ready/In Progress/Blocked
# and anything the renderer would treat as such) outside archive/. Archived
# and terminal files are advisory-only so legacy noise never blocks lint.
lint_class_hard() { # rel; reads status_of/arch_of from the caller's scope
	local st="${status_of[$1]}"
	(( "${arch_of[$1]}" == 1 )) && return 1
	is_terminal_status "$st" && return 1
	return 0
}

# Scan every task file on the board for protocol drift. Strictly read-only:
# no board lock, no writes, and git is consulted only through read-only
# plumbing (rev-list). Checks: template-section completeness, header field
# shape (the CLI's canonical timestamp/duration forms per the Option-1
# split), Status vocabulary, Success-Criteria checkbox vs Status
# reconciliation, dead ../reports/ links, claim-sidecar hygiene, archive
# hygiene, and closure push-reconcile (every recorded commit hash must be
# reachable from some ref). Severity: open-task structural findings (header
# shape, sections, claim drift, unreachable commits) are hard; body-space
# findings (dead links, checkbox drift) stay advisory everywhere, and all
# findings on terminal or archived files stay advisory, so legacy noise
# never blocks a clean exit. Exit 1 only on hard findings. Default output
# caps the advisory lines and names the remainder; --verbose lists every
# finding.
LINT_ADVISORY_CAP=20

# The lint scanner itself: one awk pass over every task file, emitting
# tab-separated records the bash side classifies. S (file, status, archive
# bit, have-status), O (file, Owner value), C (file, checked, unchecked,
# superseded Success Criteria boxes, then the verdict counts verified,
# refuted, unverifiable, and unverifiable-without-a-documented-exception,
# all counted by the shared criteria counter AWK_CRITERIA_COUNTER the
# closure gate's U/S/V records also run), M (file,
# missing section), H (file, field, value, expected), L (file, line,
# ../reports/ link target), T (file, line, commit-hash candidate). Links
# inside code spans or fences and lines that
# carry an explicit "dead link" annotation are skipped; hash lines that
# document known drift ("unreachable", "superseded", "accepted-lost") are
# skipped, so a recorded disposition never re-reports itself. Hash
# candidates are word-bounded 7..40 char hex runs, never pure decimal
# (board date stamps), and runs of 8+ chars count only on a line carrying
# commit-context words (commit, landed, pushed, merged, integrated, hash,
# revert) - 7-char runs are the conventional short-hash form and count
# anywhere. Empty header values mean absent, which the header contract
# allows, so only non-empty values are shape-checked. Character classes are
# explicit throughout: mawk lacks [[:space:]] and brace intervals, so the
# program stays inside the gawk/mawk intersection.
lint_scan_files() { # tasks_dir files...
	local tasks_dir="$1"; shift
	AWK_TASKS_DIR="$tasks_dir" AWK_ARCHIVE_DIR="$ARCHIVE_DIR" \
		AWK_LINT_SECTIONS="$(printf '%s\034' "${LINT_REQUIRED_SECTIONS[@]}")" \
		awk "$AWK_HEADING_LEVEL$AWK_CRITERIA_COUNTER"'
		BEGIN {
			sep = "\t"
			td = ENVIRON["AWK_TASKS_DIR"] "/"
			ad = ENVIRON["AWK_ARCHIVE_DIR"]
			d2 = "[0-9][0-9]"
			d4 = d2 d2
			tsre = "^" d4 "-" d2 "-" d2 " " d2 ":" d2 "$"
			lure = "^\\[" d4 "-" d2 "-" d2 " " d2 ":" d2 "\\] "
			durre = "^(N/A|([0-9]+(d|h|m))( ([0-9]+(d|h|m)))*)$"
			progre = "^[0-9]+%$"
			nreq = split(ENVIRON["AWK_LINT_SECTIONS"], reqs, "\034")
			for (i = 1; i <= nreq; i++) if (reqs[i] != "") reqsec[reqs[i]] = 1
			hexrun = "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]"
			linkre = "\\(\\.\\./reports/[^)]+\\)"
			wordc = "[0-9A-Za-z_]"
		}
		BEGIN {
			shapere["Created"] = tsre
			shapere["Updated"] = tsre
			shapere["Completed"] = tsre
			shapexp["Created"] = "YYYY-MM-DD HH:MM or absent"
			shapexp["Updated"] = "YYYY-MM-DD HH:MM or absent"
			shapexp["Completed"] = "YYYY-MM-DD HH:MM or absent"
			shapere["Latest Update"] = lure
			shapexp["Latest Update"] = "[YYYY-MM-DD HH:MM] <digest> or absent"
			shapere["Duration"] = durre
			shapexp["Duration"] = "N/A or d/h/m segments like 2h 15m, or absent"
			shapere["Progress"] = progre
			shapexp["Progress"] = "<n>% or absent"
		}
		function scan_links(line, rel, ln,    rest, off, before, nb, target) {
			if (line ~ /[Dd]ead [Ll]ink/) return
			rest = line
			off = 0
			while (match(rest, linkre)) {
				off += RSTART
				before = substr(line, 1, off - 1)
				nb = gsub(/`/, "", before)
				if (nb % 2 == 0) {
					target = substr(rest, RSTART + 1, RLENGTH - 2)
					print "L" sep rel sep ln sep target
				}
				rest = substr(rest, RSTART + RLENGTH)
				off += RLENGTH - 1
			}
		}
		function scan_hashes(line, rel, ln,    low, n, i, c, tok, start, prev, nxt) {
			low = tolower(line)
			if (low ~ /unreachable|superseded|accepted-lost/) return
			if (line !~ hexrun) return
			n = length(line)
			i = 1
			while (i <= n) {
				c = substr(line, i, 1)
				if (c ~ /[0-9a-f]/) {
					start = i
					tok = ""
					while (i <= n && substr(line, i, 1) ~ /[0-9a-f]/) {
						tok = tok substr(line, i, 1)
						i++
					}
					prev = (start > 1) ? substr(line, start - 1, 1) : " "
					nxt = (i <= n) ? substr(line, i, 1) : " "
					if (prev !~ wordc && nxt !~ wordc \
						&& length(tok) >= 7 && length(tok) <= 40 \
						&& tok !~ /^[0-9]+$/ \
						&& (length(tok) == 7 || low ~ /(commit|landed|pushed|merged|integrated|hash|revert)/)) {
						print "T" sep rel sep ln sep tok
					}
				} else {
					i++
				}
			}
		}
		# emit_h walks the shapere/shapexp tables via the field name, so the
		# per-field header branch below stays a bare extraction.
		function field_check(rel, field, value) {
			gsub(/[ \t\r]+$/, "", value)
			if (value == "") return
			if (value ~ shapere[field]) return
			v = value
			gsub(/\t/, " ", v)
			print "H" sep rel sep field sep v sep shapexp[field]
		}
		BEGIN {
		for (argi = 1; argi < ARGC; argi++) {
			fpath = ARGV[argi]
			rel = fpath
			archbit = (index(rel, ad "/") == 1) ? 1 : 0
			for (k in have_sec) delete have_sec[k]
			status = ""; owner = ""; reason = ""
			have_status = 0; have_created = 0; have_updated = 0; have_completed = 0
			have_lu = 0; have_dur = 0; have_prog = 0; have_owner = 0; have_reason = 0
			checked = 0; unchecked = 0; superseded = 0
			verified = 0; refuted = 0; unverifiable = 0; unexcepted = 0
			inhdr = 1; INSC = 0; SECNAME = ""; fence = 0; fnr = 0
			while ((getline line < (td fpath)) > 0) {
				fnr++
				track_criteria_section(line)
				if (SECNAME != "") {
					inhdr = 0
					if (SECNAME in reqsec) have_sec[SECNAME] = 1
					continue
				}
				if (inhdr) {
					if (!have_status && match(line, /^\*\*Status:\*\*[ \t]*/)) {
						status = substr(line, RSTART + RLENGTH); have_status = 1
					} else if (!have_created && match(line, /^\*\*Created:\*\*[ \t]*/)) {
						have_created = 1
						field_check(rel, "Created", substr(line, RSTART + RLENGTH))
					} else if (!have_updated && match(line, /^\*\*Updated:\*\*[ \t]*/)) {
						have_updated = 1
						field_check(rel, "Updated", substr(line, RSTART + RLENGTH))
					} else if (!have_completed && match(line, /^\*\*Completed:\*\*[ \t]*/)) {
						have_completed = 1
						field_check(rel, "Completed", substr(line, RSTART + RLENGTH))
					} else if (!have_lu && match(line, /^\*\*Latest Update:\*\*[ \t]*/)) {
						have_lu = 1
						field_check(rel, "Latest Update", substr(line, RSTART + RLENGTH))
					} else if (!have_dur && match(line, /^\*\*Duration:\*\*[ \t]*/)) {
						have_dur = 1
						field_check(rel, "Duration", substr(line, RSTART + RLENGTH))
					} else if (!have_prog && match(line, /^\*\*Progress:\*\*[ \t]*/)) {
						have_prog = 1
						field_check(rel, "Progress", substr(line, RSTART + RLENGTH))
					} else if (!have_owner && match(line, /^\*\*Owner:\*\*[ \t]*/)) {
						owner = substr(line, RSTART + RLENGTH)
						gsub(/[ \t\r]+$/, "", owner)
						have_owner = 1
					} else if (!have_reason && match(line, /^\*\*Status Reason:\*\*[ \t]*/)) {
						reason = substr(line, RSTART + RLENGTH)
						gsub(/[ \t\r]+$/, "", reason)
						have_reason = 1
					}
				}
				box = criteria_box(line)
				if (box == "checked") checked++
				else if (box == "unchecked") unchecked++
				else if (box == "superseded") superseded++
				verdict = criteria_verdict(line)
				if (verdict == "verified") verified++
				else if (verdict == "refuted") refuted++
				else if (verdict == "unverifiable") {
					unverifiable++
					if (!criteria_excepted(line)) unexcepted++
				}
				if (!fence) {
					scan_links(line, rel, fnr)
					scan_hashes(line, rel, fnr)
				}
			}
			close(td fpath)
			print "S" sep rel sep (have_status ? status : "-") sep archbit sep have_status
			print "O" sep rel sep owner
			print "R" sep rel sep reason
			print "C" sep rel sep checked sep unchecked sep superseded sep verified sep refuted sep unverifiable sep unexcepted
			for (s in reqsec) if (!(s in have_sec)) print "M" sep rel sep s
			}
		}
	' "$@"
}

cmd_lint() {
	local dir="" verbose=""
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "lint: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--verbose) verbose=1; shift ;;
			*) die "lint: unknown argument: $1" ;;
		esac
	done
	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"
	# Same option-poisoning defusing as render_unlocked: the path is handed
	# to git and re-parsed below.
	[[ "$tasks_dir" == -* || "$tasks_dir" == ~* ]] && tasks_dir="./$tasks_dir"

	local -a files=()
	local subdir file
	for subdir in "$CURRENT_DIR" "$ARCHIVE_DIR"; do
		[[ -d "$tasks_dir/$subdir" ]] || continue
		for file in "$tasks_dir/$subdir"/*.md; do
			[[ -e "$file" ]] || continue
			files+=("${file#"$tasks_dir/"}")
		done
	done

	# ---- pass 1: one awk scan over every task file -------------------------
	local -a scan_recs=() cands=()
	if ((${#files[@]} > 0)); then
		mapfile -t scan_recs < <(lint_scan_files "$tasks_dir" "${files[@]}")
	fi

	local -A status_of arch_of have_status_of checked_of unchecked_of superseded_of verified_of refuted_of unverifiable_of unexcepted_of owner_of reason_of findings_of
	local rec tag rel
	for rec in "${scan_recs[@]}"; do
		local -a parts=()
		IFS=$'\t' read -r -a parts <<<"$rec"
		tag="${parts[0]}"; rel="${parts[1]}"
		case "$tag" in
			S) status_of["$rel"]="${parts[2]:-}"; arch_of["$rel"]="${parts[3]:-}"; have_status_of["$rel"]="${parts[4]:-}" ;;
			O) owner_of["$rel"]="${parts[2]:-}" ;;
			R) reason_of["$rel"]="${parts[2]:-}" ;;
			C) checked_of["$rel"]="${parts[2]:-}"; unchecked_of["$rel"]="${parts[3]:-}"; superseded_of["$rel"]="${parts[4]:-}"
				verified_of["$rel"]="${parts[5]:-}"; refuted_of["$rel"]="${parts[6]:-}"; unverifiable_of["$rel"]="${parts[7]:-}"; unexcepted_of["$rel"]="${parts[8]:-}" ;;
			M) findings_of["$rel"]+="M"$'\t'"${parts[2]:-}"$'\n' ;;
			H) findings_of["$rel"]+="H"$'\t'"${parts[2]:-}"$'\t'"${parts[3]:-}"$'\t'"${parts[4]:-}"$'\n' ;;
			L) findings_of["$rel"]+="L"$'\t'"${parts[2]:-}"$'\t'"${parts[3]:-}"$'\n' ;;
			T) findings_of["$rel"]+="T"$'\t'"${parts[2]:-}"$'\t'"${parts[3]:-}"$'\n'
				cands+=("${parts[3]:-}") ;;
		esac
	done

	# ---- pass 2: closure push-reconcile ------------------------------------
	# Every recorded hash must be reachable from some ref. One rev-list
	# stream merges against the sorted candidate list (cands collected while
	# consuming the scan records), so a board with hundreds of recorded
	# hashes costs one git process total. Without a usable history (board
	# outside a repo, or a repo with no commits) the pass is skipped with a
	# note rather than reporting every hash unreachable.
	local -A cand_reach=()
	local have_history=0 skipped_reconcile=""
	if ((${#cands[@]} > 0)); then
		local -a uniq_cands=()
		mapfile -t uniq_cands < <(printf '%s\n' "${cands[@]}" | LC_ALL=C sort -u)
		local ci=0 nc=${#uniq_cands[@]}
		local sha saw_any=false
		# The merge needs BOTH streams sorted; rev-list emits newest-first,
		# so the stream is sorted to byte order to match the candidates.
		while IFS= read -r sha; do
			saw_any=true
			while ((ci < nc)); do
				if [[ "$sha" == "${uniq_cands[ci]}"* ]]; then
					cand_reach["${uniq_cands[ci]}"]="1"; ((ci += 1)); continue
				fi
				if [[ "${uniq_cands[ci]}" < "$sha" ]]; then ((ci += 1)); continue; fi
				break
			done
			((ci >= nc)) && break
		done < <(git -C "$tasks_dir" rev-list --all 2>/dev/null | LC_ALL=C sort)
		$saw_any && have_history=1
		((have_history)) || skipped_reconcile="no reachable git history found from $tasks_dir"
	fi

	# ---- pass 3: classify every finding ------------------------------------
	local -a hard_out=() advisory_out=()
	local msg sev st
	local -a rels=()
	for rel in "${!status_of[@]}"; do rels+=("$rel"); done
	local -a sorted_rels=()
	if ((${#rels[@]} > 0)); then
		mapfile -t sorted_rels < <(printf '%s\n' "${rels[@]}" | LC_ALL=C sort)
	fi
	for rel in "${sorted_rels[@]}"; do
		st="${status_of[$rel]}"
		# Missing Status field entirely: the renderer defaults the lane to
		# Triage, so the file acts as an open task with an incomplete header.
		if (( "${have_status_of[$rel]}" == 0 )); then
			msg="header Status field missing (expected one of: $STATUS_VALUES)"
			if lint_class_hard "$rel"; then hard_out+=("HARD $rel: $msg"); else advisory_out+=("ADVISORY $rel: $msg"); fi
		fi
		if [[ "$st" != "-" ]] && ! valid_status "$st"; then
			msg="header Status not a CLI-recognized value: '$st' (valid: $STATUS_VALUES)"
			if lint_class_hard "$rel"; then hard_out+=("HARD $rel: $msg"); else advisory_out+=("ADVISORY $rel: $msg"); fi
		fi
		# The header contract ties the Status Reason to Blocked/Cancelled, and
		# set and close --cancelled refuse to create the drift, so a Blocked
		# or Cancelled header without one is a finding: hard on an open task,
		# where the missing reason also blocks every later set until it is
		# repaired, advisory once the file is archived (terminal files are
		# advisory-only).
		if [[ "$st" == "$STATUS_BLOCKED" || "$st" == "$STATUS_CANCELLED" ]] \
			&& [[ -z "${reason_of[$rel]:-}" ]]; then
			msg="Status $st requires a $STATUS_REASON_KEY (the header contract ties it to $STATUS_BLOCKED/$STATUS_CANCELLED)"
			if (( "${arch_of[$rel]}" == 1 )); then advisory_out+=("ADVISORY $rel: $msg"); else hard_out+=("HARD $rel: $msg"); fi
		fi
		# Checkbox-vs-Status reconciliation lives in the body (Success
		# Criteria), so it stays advisory everywhere per the Option-1 split.
		# The ~ superseded annotation is its own state, neither unchecked
		# nor ticked: it never reports as an unchecked box on a terminal
		# file, and an open file whose boxes are all ticked reports only
		# when no ~ annotation stands (the "all checked" message would
		# otherwise be a ticked lie about the whole section). Verdict
		# counts ride the same shared counter, so an open all-checked
		# file whose unverifiable verdicts lack documented exceptions
		# gets the corrected nudge instead of the closure nudge the gate
		# would refuse.
		if (( "${unchecked_of[$rel]}" > 0 )) && is_terminal_status "$st"; then
			advisory_out+=("ADVISORY $rel: Status $st with ${unchecked_of[$rel]} unchecked Success Criteria boxes")
		elif (( "${unchecked_of[$rel]}" == 0 && "${checked_of[$rel]}" > 0 && "${superseded_of[$rel]:-0}" == 0 && "${unexcepted_of[$rel]:-0}" == 0 )) && ! is_terminal_status "$st"; then
			advisory_out+=("ADVISORY $rel: all ${checked_of[$rel]} Success Criteria boxes checked while $st (closure is 'tasks close')")
		fi
		# Verdict drift rides the same advisory lane (body-space findings
		# stay advisory everywhere, so legacy plain-box boards keep lint
		# green unchanged): a terminal file carrying refuted verdicts
		# reports the disproven claims its closure recorded, and an
		# unverifiable verdict without a documented exception reports
		# the claim the gate refuses to treat as established (a terminal
		# file reached that state only through a --force override).
		if (( "${refuted_of[$rel]:-0}" > 0 )) && is_terminal_status "$st"; then
			advisory_out+=("ADVISORY $rel: Status $st with ${refuted_of[$rel]} refuted Success Criteria verdict(s)")
		fi
		if (( "${unexcepted_of[$rel]:-0}" > 0 )); then
			if is_terminal_status "$st"; then
				advisory_out+=("ADVISORY $rel: Status $st with ${unexcepted_of[$rel]} unverifiable Success Criteria verdict(s) without a documented exception")
			elif (( "${unchecked_of[$rel]}" == 0 && "${checked_of[$rel]}" > 0 )); then
				advisory_out+=("ADVISORY $rel: all ${checked_of[$rel]} Success Criteria boxes checked while $st, but ${unexcepted_of[$rel]} unverifiable verdict(s) lack documented exceptions (closure refuses)")
			fi
		fi
		# Archive hygiene: an archived file still carrying an open status is
		# work the board no longer shows in any active lane.
		if (( "${arch_of[$rel]}" == 1 )) && ! is_terminal_status "$st"; then
			advisory_out+=("ADVISORY $rel: archived while $st (archived tasks must be Completed or Cancelled)")
		fi
		while IFS=$'\t' read -r tag a b c; do
			[[ -n "$tag" ]] || continue
			sev=advisory
			case "$tag" in
				M) msg="missing required section '$a'"
					lint_class_hard "$rel" && sev=hard ;;
				H) msg="header $a not CLI-shaped: '$b' (expected $c)"
					lint_class_hard "$rel" && sev=hard ;;
				L) [[ -e "$tasks_dir/$REPORTS_DIR/${b#../reports/}" ]] && continue
					msg="dead report link (line $a): $b" ;;
				T) ((have_history)) || continue
					[[ -n "${cand_reach[$b]+x}" ]] && continue
					msg="recorded commit $b (line $a) is unreachable from any branch or remote"
					lint_class_hard "$rel" && sev=hard ;;
			esac
			if [[ "$sev" == hard ]]; then hard_out+=("HARD $rel: $msg"); else advisory_out+=("ADVISORY $rel: $msg"); fi
		done < <(printf '%s' "${findings_of[$rel]:-}" | grep -v '^$')
	done
	# Open task carrying an Owner without the atomic sidecar: the header
	# claims ownership the sidecar no longer backs.
	for rel in "${sorted_rels[@]}"; do
		st="${status_of[$rel]}"
		if ! is_terminal_status "$st" && (( "${arch_of[$rel]}" == 0 )) \
			&& [[ -n "${owner_of[$rel]}" ]] && [[ ! -e "$tasks_dir/$rel.claim" ]]; then
			hard_out+=("HARD $rel: header Owner '${owner_of[$rel]}' set without a claim sidecar")
		fi
	done

	# ---- pass 4: claim-sidecar and archive hygiene -------------------------
	local -a claims=()
	for subdir in "$CURRENT_DIR" "$ARCHIVE_DIR"; do
		[[ -d "$tasks_dir/$subdir" ]] || continue
		for file in "$tasks_dir/$subdir"/*.md.claim; do
			[[ -e "$file" ]] || continue
			claims+=("${file#"$tasks_dir/"}")
		done
	done
	for file in "$tasks_dir"/*.md.claim; do
		[[ -e "$file" ]] || continue
		claims+=("${file#"$tasks_dir/"}")
	done
	local -a sorted_claims=()
	if ((${#claims[@]} > 0)); then
		mapfile -t sorted_claims < <(printf '%s\n' "${claims[@]}" | LC_ALL=C sort)
	fi
	local claim_rel task_rel sidecar_owner
	for claim_rel in "${sorted_claims[@]}"; do
		task_rel="${claim_rel%.claim}"
		if [[ ! -f "$tasks_dir/$task_rel" ]]; then
			hard_out+=("HARD $claim_rel: claim sidecar with no task file")
			continue
		fi
		st="${status_of[$task_rel]}"
		if (( "${arch_of[$task_rel]}" == 1 )) || is_terminal_status "$st"; then
			advisory_out+=("ADVISORY $claim_rel: stale claim sidecar on $st task")
			continue
		fi
		sidecar_owner="$(head -n 1 "$tasks_dir/$claim_rel")"
		if [[ -z "${owner_of[$task_rel]}" ]]; then
			hard_out+=("HARD $claim_rel: claim sidecar present but header Owner is empty")
		elif [[ "${owner_of[$task_rel]}" != "$sidecar_owner" ]]; then
			hard_out+=("HARD $claim_rel: claim sidecar owner '$sidecar_owner' does not match header Owner '${owner_of[$task_rel]}'")
		fi
	done

	# ---- report -------------------------------------------------------------
	local hard_count=${#hard_out[@]} advisory_count=${#advisory_out[@]}
	local line adv_printed=0
	for line in "${hard_out[@]}"; do printf '%s\n' "$line"; done
	for line in "${advisory_out[@]}"; do
		if (( adv_printed < LINT_ADVISORY_CAP )); then
			printf '%s\n' "$line"
			adv_printed=$((adv_printed + 1))
		elif [[ -n "$verbose" ]]; then
			printf '%s\n' "$line"
			adv_printed=$((adv_printed + 1))
		elif (( adv_printed == LINT_ADVISORY_CAP )); then
			printf '... and %d more advisory findings (run tasks lint --verbose to list all)\n' \
				$((advisory_count - adv_printed))
			adv_printed=$((adv_printed + 1))
		fi
	done
	[[ -n "$skipped_reconcile" ]] && printf 'note: push-reconcile skipped: %s\n' "$skipped_reconcile"
	printf 'lint: %d hard, %d advisory across %d task files (%d claim sidecars)\n' \
		"$hard_count" "$advisory_count" "${#files[@]}" "${#sorted_claims[@]}"
	((hard_count == 0)) || exit 1
}

# The doctor's live-set test: a task is live when its file is non-archived
# and its status is not terminal. The doctor fires its problem codes only
# on this working set, so archived and legacy shapes stay grandfathered
# quiet and legacy-conformant boards pin at zero problems.
doctor_live() { # <status> <archbit>
	[[ "$2" == "0" ]] || return 1
	! is_terminal_status "$1"
}

# Bounded DFS for doctor_dependency_cycles: seek a simple path from cur
# back to target; on success DOCTOR_CYCLE carries the path members (the
# cycle through target, without the repeating target). State lives in the
# caller's locals (DOCTOR_WALK_PATH/ONPATH/DEPTH/SUCC/CYCLE), resolved
# through bash dynamic scoping; the only callers are
# doctor_dependency_cycles and this function itself.
doctor_cycle_walk() { # <target> <cur>
	local target="$1" cur="$2" s
	((DOCTOR_WALK_DEPTH < 1000)) || return 1
	for s in ${DOCTOR_WALK_SUCC[$cur]:-}; do
		if [[ "$s" == "$target" ]]; then
			DOCTOR_CYCLE=("${DOCTOR_WALK_PATH[@]}")
			return 0
		fi
		[[ -n "${DOCTOR_WALK_ONPATH[$s]+x}" ]] && continue
		DOCTOR_WALK_ONPATH["$s"]=1
		DOCTOR_WALK_PATH+=("$s")
		((DOCTOR_WALK_DEPTH += 1))
		if doctor_cycle_walk "$target" "$s"; then
			((DOCTOR_WALK_DEPTH -= 1))
			return 0
		fi
		((DOCTOR_WALK_DEPTH -= 1))
		unset "DOCTOR_WALK_ONPATH[$s]"
		unset "DOCTOR_WALK_PATH[$(( ${#DOCTOR_WALK_PATH[@]} - 1 ))]"
	done
	return 1
}

# Distinct dependency cycles over the doctor's ID-level successor map
# (assoc "id" -> space-joined successor IDs), printed one space-joined
# member line per cycle, rotated so the lexicographically smallest member
# leads (the canonical form the dedupe and the record emission key on).
# Kahn-style trimming first strips every node with no successor or
# predecessor chain into a cycle, so the bounded per-node DFS only walks
# the cycle-bearing core; a node on two distinct cycles yields the first
# cycle its sorted traversal reaches (any finding prompts a repair that
# dissolves the tangle, so one representative per node suffices). The
# trim is O(V+E); the DFS worst case is O(core * core) on board-sized
# graphs and depth-capped against pathological input.
doctor_dependency_cycles() { # <succ-array-name>
	local -n succ="$1"
	local -A pred=() live_in=() live_out=() DOCTOR_WALK_SUCC
	local n s p changed
	for n in "${!succ[@]}"; do
		DOCTOR_WALK_SUCC["$n"]="${succ[$n]:-}"
		[[ -n "${live_out[$n]+x}" ]] || { live_in["$n"]=0; live_out["$n"]=0; }
		for s in ${succ[$n]:-}; do
			[[ -n "${live_out[$s]+x}" ]] || { live_in["$s"]=0; live_out["$s"]=0; }
			pred["$s"]+="$n "
			(( live_out[$n] += 1 ))
		done
	done
	changed=1
	while ((changed)); do
		changed=0
		for n in "${!live_out[@]}"; do
			if (( live_out[$n] == 0 )); then
				changed=1
				for p in ${pred[$n]:-}; do
					[[ -n "${live_out[$p]+x}" ]] && : $(( live_out[$p] -= 1 ))
				done
				unset "live_in[$n]" "live_out[$n]"
				continue
			fi
			if (( live_in[$n] == 0 )); then
				changed=1
				for s in ${succ[$n]:-}; do
					[[ -n "${live_in[$s]+x}" ]] && : $(( live_in[$s] -= 1 ))
				done
				unset "live_in[$n]" "live_out[$n]"
			fi
		done
	done
	local -a core=()
	for n in "${!live_out[@]}"; do core+=("$n"); done
	((${#core[@]} > 0)) || return 0
	mapfile -t core < <(printf '%s\n' "${core[@]}" | LC_ALL=C sort)
	local -A DOCTOR_WALK_ONPATH cycle_seen
	local -a DOCTOR_WALK_PATH DOCTOR_CYCLE mem rot
	local DOCTOR_WALK_DEPTH min_i i key
	for n in "${core[@]}"; do
		DOCTOR_WALK_PATH=("$n")
		DOCTOR_WALK_ONPATH=()
		DOCTOR_WALK_ONPATH["$n"]=1
		DOCTOR_WALK_DEPTH=0
		DOCTOR_CYCLE=()
		doctor_cycle_walk "$n" "$n" || continue
		mem=("${DOCTOR_CYCLE[@]}")
		min_i=0
		for ((i = 1; i < ${#mem[@]}; i++)); do
			[[ "${mem[$i]}" < "${mem[$min_i]}" ]] && min_i=$i
		done
		rot=()
		for ((i = 0; i < ${#mem[@]}; i++)); do
			rot+=("${mem[$(( (min_i + i) % ${#mem[@]} ))]}")
		done
		key="$(IFS='+'; printf '%s' "${rot[*]}")"
		[[ -n "${cycle_seen[$key]+x}" ]] && continue
		cycle_seen["$key"]=1
		printf '%s\n' "${rot[*]}"
	done
}

# Read-only board doctor: the eight stable problem-code classes as pure
# diagnostics. Always exits 0; lint stays the enforcement arm. The classes
# the task protocol pins by name:
#
#   DUPLICATE_ID        a Task ID shared by 2+ board files where some member
#                       is live (dup groups wholly outside the live set are
#                       grandfathered)
#   FILE_NAMING         a live file whose basename misses the CLI naming
#                       convention (ID, optional stamp, lowercase slug
#                       segments, optional retry suffix)
#   STATUS_REASON       a non-archived Blocked/Cancelled task with no Status
#                       Reason (the header contract's coupling)
#   STALE_CLAIM         a claim sidecar with no task file, or on a live
#                       terminal-status task (archived-task sidecars are
#                       grandfathered)
#   MISSING_DEP         a dependency token on a dedicated surface (the
#                       closure gate's grammar) of a live In Progress or
#                       Blocked task that names no board file (Ready files
#                       declaring future children are grandfathered)
#   DEP_CYCLE           a dependency cycle with at least one live member
#                       (all-archived cycles are grandfathered)
#   DEAD_REPORT_LINK    a ../reports/ link on a live task whose target is
#                       missing (archived files are grandfathered)
#   DASHBOARD_DIVERGENCE dashboard.md missing or differing from the
#                       board_walk assembly (global check, no grandfathering)
#
# --all additionally evaluates the findings grandfathering suppresses and
# emits them as a separate GRANDFATHERED list with their own count (the
# --json envelope gains grandfathered_total plus a grandfathered records
# array); the default view, the totals, and the always-exit-0 contract are
# unchanged.
#
# Substrate reuse: lint_scan_files feeds status/archive/reason/dead-link
# data, closure_gate_scan feeds the dependency-surface tokens, board_walk
# plus assemble_rows feed the divergence check, so the doctor can never
# drift from the surfaces it diagnoses. Strictly read-only: no lock, no
# render, no header bump.
cmd_doctor() {
	local dir="" json=0 all=0
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "doctor: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--json) json=1; shift ;;
			--all) all=1; shift ;;
			*) diec "$CODE_USAGE" "doctor: unknown argument: $1" ;;
		esac
	done
	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"

	local -a problems=() # "code\tfile\tdetail" records, sorted before emission
	local -a gf_problems=() # the grandfathered equivalents, emitted only under --all
	local -a DOCTOR_CODES=(DUPLICATE_ID FILE_NAMING STATUS_REASON STALE_CLAIM MISSING_DEP DEP_CYCLE DEAD_REPORT_LINK DASHBOARD_DIVERGENCE)

	local -a files=()
	board_files "$tasks_dir" files
	local -a sorted_files=()
	((${#files[@]} > 0)) && mapfile -t sorted_files < <(printf '%s\n' "${files[@]}" | LC_ALL=C sort)

	# ---- pass 1: shared lint scan (status, archive bit, reason, link candidates)
	local -A status_of arch_of reason_of link_targets_of
	local rec tag rel a b c st arch
	if ((${#files[@]} > 0)); then
		local -a scan_recs=()
		mapfile -t scan_recs < <(lint_scan_files "$tasks_dir" "${files[@]}")
		for rec in "${scan_recs[@]}"; do
			IFS=$'\t' read -r tag rel a b c <<<"$rec"
			case "$tag" in
				S) status_of["$rel"]="$a"; arch_of["$rel"]="$b" ;;
				R) reason_of["$rel"]="$a" ;;
				L) link_targets_of["$rel"]+="$a"$'\t'"$b"$'\n' ;;
			esac
		done
	fi

	# ---- pass 2: naming + Task ID groups
	local -A id_rels_of # id -> space-joined board-relative files
	local base bid namere
	namere='^[A-Za-z]+(-[0-9]+)+(-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9](-[a-z0-9]+)*(-[0-9]+)?)?\.md$'
	for rel in "${sorted_files[@]}"; do
		base="${rel##*/}"
		bid="$(task_id_of_basename "$base")"
		if [[ ! "$base" =~ $namere ]]; then
			if doctor_live "${status_of[$rel]:-}" "${arch_of[$rel]:-0}"; then
				problems+=("FILE_NAMING"$'\t'"$rel"$'\t'"file name misses the CLI convention (ID-stamp-slug.md): $base")
			else
				gf_problems+=("FILE_NAMING"$'\t'"$rel"$'\t'"file name misses the CLI convention (ID-stamp-slug.md): $base")
			fi
		fi
		[[ -n "$bid" ]] && id_rels_of["$bid"]+="$rel "
	done

	# ---- pass 3: dependency tokens (dedicated surfaces), missing deps, edges
	local -A tokens_of succ_of
	local own tok
	for rel in "${sorted_files[@]}"; do
		local -a toks=()
		mapfile -t toks < <(dependency_tokens "$tasks_dir/$rel")
		((${#toks[@]} > 0)) && tokens_of["$rel"]="$(printf '%s\n' "${toks[@]}" | LC_ALL=C sort -u | tr '\n' ' ')"
		own="$(task_id_of_basename "${rel##*/}")"
		st="${status_of[$rel]:-}"; arch="${arch_of[$rel]:-0}"
		for tok in ${tokens_of[$rel]:-}; do
			[[ "$tok" == "$own" ]] && continue
			if [[ -z "${id_rels_of[$tok]+x}" ]]; then
				if [[ "$arch" == "0" && ( "$st" == "$STATUS_IN_PROGRESS" || "$st" == "$STATUS_BLOCKED" ) ]]; then
					problems+=("MISSING_DEP"$'\t'"$rel"$'\t'"dependency token '$tok' names no board file")
				else
					gf_problems+=("MISSING_DEP"$'\t'"$rel"$'\t'"dependency token '$tok' names no board file")
				fi
				continue
			fi
			[[ -n "$own" ]] && succ_of["$own"]+="$tok "
		done
	done

	# ---- pass 4: duplicate ID groups needing a live member
	local open_member
	local -a members=()
	for bid in "${!id_rels_of[@]}"; do
		read -r -a members <<<"${id_rels_of[$bid]}"
		(( ${#members[@]} >= 2 )) || continue
		open_member=""
		for rel in "${members[@]}"; do
			if doctor_live "${status_of[$rel]:-}" "${arch_of[$rel]:-0}"; then open_member="$rel"; break; fi
		done
		if [[ -n "$open_member" ]]; then
			problems+=("DUPLICATE_ID"$'\t'"$open_member"$'\t'"Task ID $bid shared by: ${id_rels_of[$bid]% }")
		else
			gf_problems+=("DUPLICATE_ID"$'\t'"${members[0]}"$'\t'"Task ID $bid shared by: ${id_rels_of[$bid]% }")
		fi
	done

	# ---- pass 5: status-reason coupling on live files
	for rel in "${sorted_files[@]}"; do
		st="${status_of[$rel]:-}"; arch="${arch_of[$rel]:-0}"
		if [[ "$st" == "$STATUS_BLOCKED" || "$st" == "$STATUS_CANCELLED" ]] \
			&& [[ -z "${reason_of[$rel]:-}" ]]; then
			if [[ "$arch" == "0" ]]; then
				problems+=("STATUS_REASON"$'\t'"$rel"$'\t'"Status $st requires a $STATUS_REASON_KEY (the header contract ties it to $STATUS_BLOCKED/$STATUS_CANCELLED)")
			else
				gf_problems+=("STATUS_REASON"$'\t'"$rel"$'\t'"Status $st requires a $STATUS_REASON_KEY (the header contract ties it to $STATUS_BLOCKED/$STATUS_CANCELLED)")
			fi
		fi
	done

	# ---- pass 6: dependency cycles needing a live member
	local cid found chain i arrow_s
	local -a cyc
	while read -r chain; do
		read -r -a cyc <<<"$chain"
		found=""
		for cid in "${cyc[@]}"; do
			for rel in ${id_rels_of[$cid]}; do
				if doctor_live "${status_of[$rel]:-}" "${arch_of[$rel]:-0}"; then found="$rel"; break 2; fi
			done
		done
		arrow_s="${cyc[0]}"
		for ((i = 1; i < ${#cyc[@]}; i++)); do arrow_s+=" -> ${cyc[$i]}"; done
		arrow_s+=" -> ${cyc[0]}"
		if [[ -n "$found" ]]; then
			problems+=("DEP_CYCLE"$'\t'"$found"$'\t'"dependency cycle: $arrow_s (open: $found)")
		else
			gf_problems+=("DEP_CYCLE"$'\t'"${id_rels_of[${cyc[0]}]%% *}"$'\t'"dependency cycle: $arrow_s")
		fi
	done < <(doctor_dependency_cycles succ_of)

	# ---- pass 7: dead report links on live files
	local ln tgt
	for rel in "${sorted_files[@]}"; do
		while IFS=$'\t' read -r ln tgt; do
			[[ -n "$ln" ]] || continue
			[[ -e "$tasks_dir/$REPORTS_DIR/${tgt#../reports/}" ]] && continue
			if doctor_live "${status_of[$rel]:-}" "${arch_of[$rel]:-0}"; then
				problems+=("DEAD_REPORT_LINK"$'\t'"$rel"$'\t'"dead report link (line $ln): $tgt")
			else
				gf_problems+=("DEAD_REPORT_LINK"$'\t'"$rel"$'\t'"dead report link (line $ln): $tgt")
			fi
		done < <(printf '%s' "${link_targets_of[$rel]:-}")
	done

	# ---- pass 8: claim-sidecar staleness (archived-task sidecars grandfathered)
	local -a claims=()
	local subdir file claim_rel task_rel
	for subdir in "$CURRENT_DIR" "$ARCHIVE_DIR"; do
		[[ -d "$tasks_dir/$subdir" ]] || continue
		for file in "$tasks_dir/$subdir"/*.md.claim; do
			[[ -e "$file" ]] || continue
			claims+=("${file#"$tasks_dir/"}")
		done
	done
	for file in "$tasks_dir"/*.md.claim; do
		[[ -e "$file" ]] || continue
		claims+=("${file#"$tasks_dir/"}")
	done
	local -a sorted_claims=()
	((${#claims[@]} > 0)) && mapfile -t sorted_claims < <(printf '%s\n' "${claims[@]}" | LC_ALL=C sort)
	for claim_rel in "${sorted_claims[@]}"; do
		task_rel="${claim_rel%.claim}"
		if [[ ! -f "$tasks_dir/$task_rel" ]]; then
			problems+=("STALE_CLAIM"$'\t'"$claim_rel"$'\t'"claim sidecar with no task file")
			continue
		fi
		arch="${arch_of[$task_rel]:-0}"
		if [[ "$arch" == "1" ]]; then
			gf_problems+=("STALE_CLAIM"$'\t'"$claim_rel"$'\t'"claim sidecar on archived task")
			continue
		fi
		st="${status_of[$task_rel]:-}"
		is_terminal_status "$st" \
			&& problems+=("STALE_CLAIM"$'\t'"$claim_rel"$'\t'"stale claim sidecar on $st task")
	done

	# ---- pass 9: dashboard divergence (global)
	local dash="$tasks_dir/$DASHBOARD_NAME"
	if ! (( ${#files[@]} == 0 )) || [[ -e "$dash" ]]; then
		local rows_file out_file
		rows_file="$(mktemp "${TMPDIR:-/tmp}/tasks-doctor.XXXXXX")"
		out_file="$(mktemp "${TMPDIR:-/tmp}/tasks-doctor.XXXXXX")"
		arm_tmp_cleanup_trap "$rows_file" "$out_file"
		if ((${#files[@]} > 0)); then
			assemble_rows "${files[@]}" >"$rows_file"
			LC_ALL=C sort -o "$rows_file" "$rows_file"
		fi
		board_walk "$rows_file" >"$out_file"
		if [[ ! -e "$dash" ]]; then
			problems+=("DASHBOARD_DIVERGENCE"$'\t'"dashboard.md"$'\t'"dashboard.md is missing (render would create it)")
		elif ! cmp -s "$out_file" "$dash"; then
			problems+=("DASHBOARD_DIVERGENCE"$'\t'"dashboard.md"$'\t'"dashboard.md differs from the assembled board")
		fi
		trap - EXIT
		rm -f "$rows_file" "$out_file"
	fi

	# ---- emission: sorted records, fixed-order counts, exit 0 always
	local -a sorted_problems=()
	((${#problems[@]} > 0)) && mapfile -t sorted_problems < <(printf '%s\n' "${problems[@]}" | LC_ALL=C sort -u)
	local -A code_count=()
	local code file detail p out
	for p in "${sorted_problems[@]+${sorted_problems[@]}}"; do
		code="${p%%$'\t'*}"
		code_count["$code"]=$(( ${code_count[$code]:-0} + 1 ))
	done
	local -a sorted_gf=()
	((all == 1)) && ((${#gf_problems[@]} > 0)) && mapfile -t sorted_gf < <(printf '%s\n' "${gf_problems[@]}" | LC_ALL=C sort -u)
	if ((json == 1)); then
		out="{\"schema_version\":$SCHEMA_VERSION,\"type\":\"doctor\",\"total\":${#sorted_problems[@]},\"counts\":{"
		for code in "${DOCTOR_CODES[@]}"; do
			out+="\"$code\":${code_count[$code]:-0},"
		done
		out="${out%,}},\"problems\":["
		for p in "${sorted_problems[@]+${sorted_problems[@]}}"; do
			code="${p%%$'\t'*}"
			detail="${p#*$'\t'}"
			file="${detail%%$'\t'*}"
			detail="${detail#*$'\t'}"
			out+="{\"code\":$(jqstr_bash "$code"),\"file\":$(jqstr_bash "$file"),\"detail\":$(jqstr_bash "$detail")},"
		done
		if ((all == 1)); then
			out="${out%,}],\"grandfathered_total\":${#sorted_gf[@]},\"grandfathered\":["
			for p in "${sorted_gf[@]+${sorted_gf[@]}}"; do
				code="${p%%$'\t'*}"
				detail="${p#*$'\t'}"
				file="${detail%%$'\t'*}"
				detail="${detail#*$'\t'}"
				out+="{\"code\":$(jqstr_bash "$code"),\"file\":$(jqstr_bash "$file"),\"detail\":$(jqstr_bash "$detail")},"
			done
			out="${out%,}]}"
		else
			out="${out%,}]}"
		fi
		printf '%s\n' "$out"
	else
		for p in "${sorted_problems[@]+${sorted_problems[@]}}"; do
			code="${p%%$'\t'*}"
			detail="${p#*$'\t'}"
			file="${detail%%$'\t'*}"
			detail="${detail#*$'\t'}"
			printf '%s %s: %s\n' "$code" "$file" "$detail"
		done
		if ((all == 1)); then
			for p in "${sorted_gf[@]+${sorted_gf[@]}}"; do
				code="${p%%$'\t'*}"
				detail="${p#*$'\t'}"
				file="${detail%%$'\t'*}"
				detail="${detail#*$'\t'}"
				printf 'GRANDFATHERED %s %s: %s\n' "$code" "$file" "$detail"
			done
			printf 'doctor: %d problem(s), %d grandfathered across %d task files\n' "${#sorted_problems[@]}" "${#sorted_gf[@]}" "${#files[@]}"
		else
			printf 'doctor: %d problem(s) across %d task files\n' "${#sorted_problems[@]}" "${#files[@]}"
		fi
	fi
}

# Read-only dependency-ready frontier and graph over the shared
# dependency-token scan (dependency_tokens, the closure gate's grammar).
# Derivation: a live, ID-bearing, declared-Ready task whose resolvable
# dependencies are all terminal (Completed/Cancelled by header status) is
# Runnable; the payload carries the declared status beside the derived
# runnable flag so the distinction stays visible. Policy, pinned by the
# battery's frontier suite:
#   - Unknown tokens on active work (In Progress/Blocked) fail closed:
#     the doctor fires MISSING_DEP and the task never reports runnable.
#   - Legacy unknown tokens on Ready/Triage files report in unknown_deps
#     but never block the derivation (the board's known unresolved tokens
#     live on Ready files).
#   - Archived dependencies resolve (terminality rides the header status,
#     so an archived Completed dep satisfies while an archived legacy
#     open-status file does not).
#   - Self-deps are ignored, pinning the closure gate's behavior.
#   - A dep naming a Task ID shared by several files requires every
#     member terminal (the dup group is one dependency node), and the
#     cycle flag keys on the ID, so an archived dup of a live cycle
#     member carries it too.
#   - Cycle membership comes from the doctor's ID-level successor map,
#     classified by its live rule (a cycle with at least one live member
#     fires; all-archived cycles stay inert). The cycle flag surfaces the
#     finding but never independently gates Runnable: an all-live cycle
#     is structurally unrunnable because every member's successor is
#     non-terminal, and a mixed cycle with a terminal member is exactly
#     the case where the member's own deps are satisfied; the doctor's
#     DEP_CYCLE stays the repair arm.
# Nodes are all board files (archived included, lane-derived like the
# list projection); edges run dependent -> dependency, mirroring the
# doctor's successor map. A file whose basename yields no Task ID keeps
# its graph data but never reports runnable: an unidentifiable task is
# not frontier material. The human view groups RUNNABLE rows ahead of
# OPEN rows (board byte order within each group), so the startable set
# reads without scanning the board. Strictly read-only: no lock, no
# render, no header bump.
cmd_frontier() {
	local dir="" json=0
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "frontier: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--json) json=1; shift ;;
			*) diec "$CODE_USAGE" "frontier: unknown argument: $1" ;;
		esac
	done

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"

	local -a files=()
	board_files "$tasks_dir" files
	if ((${#files[@]} == 0)); then
		((json == 1)) && printf '{"schema_version":%d,"type":"frontier","runnable":0,"total":0,"tasks":[],"edges":[]}\n' "$SCHEMA_VERSION"
		((json == 0)) && printf 'frontier: 0 runnable of 0 task(s), 0 done, 0 edge(s)\n'
		return 0
	fi

	local -a sorted_files=()
	mapfile -t sorted_files < <(printf '%s\n' "${files[@]}" | LC_ALL=C sort)

	# ---- pass 1: shared lint scan (status, archive bit)
	local -A status_of arch_of
	local -a scan_recs=()
	local rec tag rel a b c
	mapfile -t scan_recs < <(lint_scan_files "$tasks_dir" "${files[@]}")
	for rec in "${scan_recs[@]}"; do
		IFS=$'\t' read -r tag rel a b c <<<"$rec"
		case "$tag" in
			S) status_of["$rel"]="$a"; arch_of["$rel"]="$b" ;;
		esac
	done

	# ---- pass 2: ID map, token classification, and edges over the shared scan
	local -A id_rels_of unknown_of unmet_of
	local -a succ_edges=()
	local base bid own tok trel satisfied
	for rel in "${sorted_files[@]}"; do
		base="${rel##*/}"
		bid="$(task_id_of_basename "$base")"
		[[ -n "$bid" ]] && id_rels_of["$bid"]+="$rel "
	done
	for rel in "${sorted_files[@]}"; do
		own="$(task_id_of_basename "${rel##*/}")"
		local -a toks=()
		mapfile -t toks < <(dependency_tokens "$tasks_dir/$rel")
		((${#toks[@]} > 0)) || continue
		local -a utoks=()
		mapfile -t utoks < <(printf '%s\n' "${toks[@]}" | LC_ALL=C sort -u)
		for tok in "${utoks[@]}"; do
			[[ "$tok" == "$own" ]] && continue
			if [[ -z "${id_rels_of[$tok]+x}" ]]; then
				unknown_of["$rel"]+="$tok "
				continue
			fi
			[[ -n "$own" ]] && succ_edges+=("$own"$'\t'"$tok")
			satisfied=1
			for trel in ${id_rels_of[$tok]}; do
				is_terminal_status "${status_of[$trel]:-}" || { satisfied=0; break; }
			done
			((satisfied == 1)) || unmet_of["$rel"]+="$tok "
		done
	done

	# ---- pass 3: cycle membership over the doctor's successor map
	local -A succ_of=() fired_cycle_ids=()
	local -a cyc sorted_edges=()
	local e cid chain
	for e in "${succ_edges[@]+${succ_edges[@]}}"; do
		IFS=$'\t' read -r a b <<<"$e"
		succ_of["$a"]+="$b "
	done
	((${#succ_edges[@]} > 0)) && mapfile -t sorted_edges < <(printf '%s\n' "${succ_edges[@]}" | LC_ALL=C sort -u)
	while read -r chain; do
		read -r -a cyc <<<"$chain"
		local -a live_members=()
		for cid in "${cyc[@]}"; do
			for rel in ${id_rels_of[$cid]:-}; do
				if doctor_live "${status_of[$rel]:-}" "${arch_of[$rel]:-0}"; then
					live_members+=("$cid")
					break
				fi
			done
		done
		((${#live_members[@]} > 0)) || continue
		for cid in "${live_members[@]}"; do fired_cycle_ids["$cid"]=1; done
	done < <(doctor_dependency_cycles succ_of)

	# ---- pass 4: runnable derivation, lane mapping, rows
	local -a task_objs=() human_run=() human_open=() wparts uparts
	local st arch lane run notes wj uj runnable_count=0 done_count=0 obj w u tasks_json="" ejson="" hr ea eb cycle_flagged
	for rel in "${sorted_files[@]}"; do
		st="${status_of[$rel]:-}"
		arch="${arch_of[$rel]:-0}"
		own="$(task_id_of_basename "${rel##*/}")"
		if [[ "$arch" == "1" ]]; then
			lane="Archive"
		else
			case "$st" in
				"$STATUS_READY") lane="Ready" ;;
				"$STATUS_IN_PROGRESS") lane="In Progress" ;;
				"$STATUS_BLOCKED" | "$STATUS_CANCELLED") lane="Blocked/Cancelled" ;;
				"$STATUS_COMPLETED") lane="Completed" ;;
				*) lane="Triage" ;;
			esac
		fi
		run=0
		if [[ "$arch" == "0" && "$st" == "$STATUS_READY" && -n "$own" && -z "${unmet_of[$rel]:-}" ]]; then run=1; fi
		((run == 1)) && runnable_count=$((runnable_count + 1))
		if [[ "$arch" == "1" ]] || is_terminal_status "$st"; then done_count=$((done_count + 1)); fi
		wj="" uj="" notes=""
		[[ -n "${unmet_of[$rel]:-}" ]] && wj="${unmet_of[$rel]% }"
		[[ -n "${unknown_of[$rel]:-}" ]] && uj="${unknown_of[$rel]% }"
		cycle_flagged=""
		[[ -n "$own" ]] && cycle_flagged="${fired_cycle_ids[$own]+x}"
		if [[ -n "$wj" ]]; then notes="waiting: ${wj// /, }"; fi
		if [[ -n "$uj" ]]; then
			[[ -n "$notes" ]] && notes+="; "
			notes+="unknown: ${uj// /, }"
		fi
		if [[ -n "$cycle_flagged" ]]; then
			[[ -n "$notes" ]] && notes+="; "
			notes+="cycle"
		fi
		if ((run == 1)); then
			human_run+=("RUNNABLE"$'\t'"$rel"${notes:+$'\t'"($notes)"})
		elif [[ "$arch" != "1" ]] && ! is_terminal_status "$st"; then
			human_open+=("OPEN"$'\t'"$rel"${notes:+$'\t'"($notes)"})
		fi
		obj="{\"id\":$(jqstr_bash "$own"),\"file\":$(jqstr_bash "$rel"),\"status\":$(jqstr_bash "$st"),\"lane\":$(jqstr_bash "$lane")"
		obj+=",\"archived\":$([[ "$arch" == "1" ]] && printf true || printf false)"
		obj+=",\"runnable\":$([[ "$run" == "1" ]] && printf true || printf false)"
		obj+=",\"cycle\":$([[ -n "$cycle_flagged" ]] && printf true || printf false)"
		wparts=() uparts=()
		if [[ -n "$wj" ]]; then
			for w in $wj; do wparts+=("$(jqstr_bash "$w")"); done
		fi
		if [[ -n "$uj" ]]; then
			for u in $uj; do uparts+=("$(jqstr_bash "$u")"); done
		fi
		obj+=",\"waiting_on\":[$(IFS=,; printf '%s' "${wparts[*]:-}")]"
		obj+=",\"unknown_deps\":[$(IFS=,; printf '%s' "${uparts[*]:-}")]"
		task_objs+=("$obj}")
	done

	# ---- emission: the schema_version 1 payload or the focused human view
	for e in "${sorted_edges[@]+${sorted_edges[@]}}"; do
		IFS=$'\t' read -r ea eb <<<"$e"
		ejson+="{\"from\":$(jqstr_bash "$ea"),\"to\":$(jqstr_bash "$eb")},"
	done
	ejson="[${ejson%,}]"
	if ((json == 1)); then
		for obj in "${task_objs[@]}"; do tasks_json+="$obj,"; done
		tasks_json="${tasks_json%,}"
		printf '{"schema_version":%d,"type":"frontier","runnable":%d,"total":%d,"tasks":[%s],"edges":%s}\n' \
			"$SCHEMA_VERSION" "$runnable_count" "${#sorted_files[@]}" "$tasks_json" "$ejson"
	else
		for hr in "${human_run[@]+${human_run[@]}}"; do printf '%s\n' "$hr"; done
		for hr in "${human_open[@]+${human_open[@]}}"; do printf '%s\n' "$hr"; done
		printf 'frontier: %d runnable of %d task(s), %d done, %d edge(s)\n' \
			"$runnable_count" "${#sorted_files[@]}" "$done_count" "${#sorted_edges[@]}"
	fi
}

# Print the final N entries of a task's Work Log section, verbatim, from a
# snapshot supplied on stdin. Entries start at each "### " heading; the tail
# begins at the Nth-from-last heading and runs to the end of the section
# with trailing blank lines trimmed.
work_log_tail() {
	local n="$1"
	awk -v n="$n" '
		/^## Work Log/ { inwork = 1; next }
		inwork && /^## / { inwork = 0 }
		inwork {
			lines[NR] = $0
			if ($0 ~ /^### /) starts[++count] = NR
			lastline = NR
		}
		END {
			if (count == 0) exit 0
			first = (count > n) ? starts[count - n + 1] : starts[1]
			while (lastline > first && lines[lastline] == "") lastline--
			for (i = first; i <= lastline; i++) print lines[i]
		}
	'
}

# Print one section's canonical body from a task file: the exact span the
# edit write model defines (the first heading matching the name at level
# 2..6, body through the line before the next heading of the same or higher
# level, the structural blank line under the heading consumed, trailing
# blank lines trimmed), so read and write agree byte-for-byte and
# `tasks show --section | tasks edit --section` round-trips. Deeper nested
# headings are addressable by name exactly like edit's own --section; the
# level-1 document title is not a section. --json wraps the same canonical
# body in the schema_version 1 envelope instead of printing it as text.
# Strictly read-only; exit 1 with SECTION_NOT_FOUND when nothing matches.
show_section() {
	local file="$1" section="$2" rel="$3" json="$4"
	local out rc=0
	out="$(AWK_SECTION="$section" AWK_JSON_MODE="$json" AWK_FILE="$rel" AWK_SCHEMA_VERSION="$SCHEMA_VERSION" \
		awk "$AWK_HEADING_LEVEL$AWK_JSON_ESCAPE"'
			function emit_body(    i, s) {
				while (nbuf > 0 && buf[nbuf] == "") nbuf--
				if (ENVIRON["AWK_JSON_MODE"] == "1") {
					s = ""
					for (i = 1; i <= nbuf; i++) s = s (i > 1 ? "\n" : "") buf[i]
					printf "%s\n", ("{\"schema_version\":" ENVIRON["AWK_SCHEMA_VERSION"] ",\"type\":\"section\",\"file\":" jq(ENVIRON["AWK_FILE"]) ",\"heading\":" jq(section) ",\"level\":" sec_level ",\"body\":" jq(s) "}")
				} else {
					for (i = 1; i <= nbuf; i++) print buf[i]
				}
			}
			BEGIN {
				section = ENVIRON["AWK_SECTION"]
				found = 0; state = 0; nbuf = 0; fresh = 0; sec_level = 0
			}
			{
				if (state == 2) next
				level = heading_level($0)
				if (state == 0) {
					if (level >= 2 && HTEXT == section) {
						found = 1; sec_level = level; state = 1; fresh = 1
					}
					next
				}
				if (fresh) { fresh = 0; if ($0 == "") next }
				if (level && level <= sec_level) { emit_body(); state = 2; next }
				buf[++nbuf] = $0
			}
			END {
				if (state == 1) emit_body()
				exit found ? 0 : 1
			}
		' "$file")" || rc=$?
	((rc != 0)) && diec "$CODE_SECTION_NOT_FOUND" "show: no section '$section' in $(basename "$file")"
	[[ -n "$out" ]] && printf '%s\n' "$out"
	return 0
}

# Print the schema_version 1 JSON snapshot of one task file: every logical
# header field (template keys in canonical order, values verbatim apart
# from trailing-whitespace trim, absent fields as empty strings), every
# section body complete in file order (top-level units with nested headings
# carried verbatim inside the body, canonical trailing-blank trim matching
# the write model), and the Work Log additionally structured into entries
# by its CLI-stamped "### " anchors. One awk pass over the file: a
# concurrent mutation publishes via atomic mv, so the pass sees complete
# old-or-new content. Strictly read-only.
show_json() {
	local file="$1" rel="$2" arch=0
	[[ "$rel" == "$ARCHIVE_DIR"/* ]] && arch=1
	AWK_FILE="$rel" AWK_ARCHIVED="$arch" AWK_ID_KEY_WIDTH="$ID_KEY_SEGMENT_WIDTH" \
		AWK_HDR_ORDER="$(printf '%s\034' "Task" "${TEMPLATE_HEADER_FIELDS[@]}")" \
		AWK_SCHEMA_VERSION="$SCHEMA_VERSION" \
		awk "$AWK_HEADING_LEVEL$AWK_ROW_HELPERS$AWK_HEADER_FIELDS$AWK_JSON_ESCAPE"'
			function trimws(s) { sub(/[ \t\r]+$/, "", s); return s }
			function body_tail_trim(s) {
				while (s != "" && substr(s, length(s)) == "\n") s = substr(s, 1, length(s) - 1)
				return s
			}
			function push_unit(heading, lvl) {
				nunits++
				top = nunits
				SEC_H[nunits] = heading; SEC_LVL[nunits] = lvl
				SEC_B[nunits] = ""; SEC_FRESH[nunits] = 1
			}
			function append_body(line) {
				if (SEC_FRESH[top]) {
					SEC_FRESH[top] = 0
					if (line == "") return
				}
				SEC_B[top] = SEC_B[top] (SEC_B[top] == "" ? "" : "\n") line
			}
			function close_entry() {
				if (!in_entry) return
				E_B = body_tail_trim(E_B)
				nent++
				EN_STAMP[nent] = E_STAMP; EN_TITLE[nent] = E_TITLE; EN_BODY[nent] = E_B
				in_entry = 0
			}
			function open_entry(heading) {
				close_entry()
				in_entry = 1; E_STAMP = ""; E_TITLE = ""; E_B = ""; E_FRESH = 1
				if (match(heading, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]/)) {
					E_STAMP = substr(heading, 1, 16)
					if (substr(heading, 17, 2) == ": ") E_TITLE = substr(heading, 19)
				} else {
					E_TITLE = heading
				}
			}
			function append_entry_body(line) {
				if (E_FRESH) {
					E_FRESH = 0
					if (line == "") return
				}
				E_B = E_B (E_B == "" ? "" : "\n") line
			}
			BEGIN {
				nunits = 0; top = 0; nent = 0; inhdr = 1; in_entry = 0
				file = ENVIRON["AWK_FILE"]
				nhdr = split(ENVIRON["AWK_HDR_ORDER"], hdrkeys, "\034")
				idw = ENVIRON["AWK_ID_KEY_WIDTH"]
			}
			{
				if (inhdr) {
					if (heading_level($0) >= 2) { inhdr = 0; push_unit(HTEXT, heading_level($0)) }
					else hdr_feed($0)
					next
				}
				level = heading_level($0)
				inwork = (top > 0 && SEC_LVL[top] == 2 && SEC_H[top] == "Work Log")
				if (level >= 2) {
					popped = 0
					while (top > 0 && level <= SEC_LVL[top]) { top--; popped = 1 }
					if (popped || top == 0) { close_entry(); push_unit(HTEXT, level) }
					else {
						append_body($0)
						if (inwork && level == 3) open_entry(HTEXT)
						else if (inwork && in_entry) append_entry_body($0)
					}
					next
				}
				if (top == 0) next
				if (inwork && in_entry) append_entry_body($0)
				append_body($0)
			}
			END {
				close_entry()
				fb = file; sub(/.*\//, "", fb)
				out = "{\"schema_version\":" ENVIRON["AWK_SCHEMA_VERSION"] ",\"type\":\"task\",\"id\":" jq(taskid(fb))
				out = out ",\"file\":" jq(file) ",\"archived\":" (ENVIRON["AWK_ARCHIVED"] == "1" ? "true" : "false")
				out = out ",\"header\":{"
				for (k = 1; k <= nhdr; k++) {
					key = hdrkeys[k]
					if (key == "") continue
					v = (key == "Task") ? FLD["Title"] : ((key in FLD) ? FLD[key] : "")
					out = out ((k > 1) ? "," : "") jq(key) ":" jq(trimws(v))
				}
				out = out "}"
				out = out ",\"sections\":["
				for (i = 1; i <= nunits; i++) {
					out = out ((i > 1) ? "," : "") "{\"heading\":" jq(SEC_H[i]) ",\"level\":" SEC_LVL[i] ",\"body\":" jq(body_tail_trim(SEC_B[i])) "}"
				}
				out = out "]"
				out = out ",\"work_log\":{\"entries\":["
				for (i = 1; i <= nent; i++) {
					out = out ((i > 1) ? "," : "") "{\"stamp\":" jq(EN_STAMP[i]) ",\"title\":" jq(EN_TITLE[i]) ",\"body\":" jq(EN_BODY[i]) "}"
				}
				out = out "]}}"
				print out
			}
		' "$file"
}

cmd_show() {
	local dir="" tail="$DEFAULT_TAIL" tail_given=0 json=0 raw=0 section="" args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "show: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--tail) [[ $# -ge 2 && "$2" != --* ]] || die "show: --tail requires a value"; tail="$2"; tail_given=1; shift 2 ;;
			--tail=*) tail="${1#*=}"; tail_given=1; shift ;;
			--json) json=1; shift ;;
			--raw) raw=1; shift ;;
			--section) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "show: --section requires a value"; section="$2"; shift 2 ;;
			--section=*) section="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 1)) || diec "$CODE_USAGE" "show: usage: tasks show <taskfile> [--tail N] [--json] [--section HEADING] [--raw]"
	[[ "$tail" =~ ^[1-9][0-9]*$ ]] || diec "$CODE_USAGE" "show: --tail expects a positive integer, got: $tail"
	# One output mode per call: the human view (optionally tailed), the
	# versioned JSON snapshot, the raw whole-file hatch, or one section's
	# canonical body (--json narrows it to the envelope). --tail only shapes
	# the human Work Log tail; the JSON snapshot always carries the complete
	# history, so combining it with --tail would silently lie about scope.
	((json == 1 && tail_given == 1)) \
		&& diec "$CODE_USAGE" "show: --tail applies to the human view only; --json carries the complete history"
	((raw == 1 && json == 1)) \
		&& diec "$CODE_USAGE" "show: --raw and --json are exclusive output modes"
	((raw == 1 && tail_given == 1)) \
		&& diec "$CODE_USAGE" "show: --tail applies to the human view only; --raw prints the whole file"
	[[ -n "$section" && $raw == 1 ]] \
		&& diec "$CODE_USAGE" "show: --raw prints the whole file; --section alone prints one section's body"
	((tail_given == 1)) && [[ -n "$section" ]] \
		&& diec "$CODE_USAGE" "show: --tail applies to the human view only; --section prints one section's body"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	# Strictly read-only: no board lock, no render, no header bump. Task
	# mutations publish via atomic mv, so a lock-free reader sees complete
	# old-or-new content either way. The human view reads ONCE into a
	# snapshot and both the header and the tail are extracted from that
	# single image, so a concurrent mutation can never yield a torn composite
	# of an old header with a new tail; the JSON and raw views read through
	# the same single open (one awk pass, one cat).
	if ((raw == 1)); then
		cat "$file"
		return
	fi
	local rel file_r board_r
	file_r="$(readlink -f "$file")"
	board_r="$(readlink -f "$tasks_dir")"
	rel="${file_r#"$board_r"/}"
	if [[ -n "$section" ]]; then
		show_section "$file" "$section" "$rel" "$json"
		return
	fi
	if ((json == 1)); then
		show_json "$file" "$rel"
		return
	fi
	local snapshot
	snapshot="$(cat "$file")"
	header_of <<<"$snapshot"
	printf '\n## Work Log (last %s entries)\n\n' "$tail"
	work_log_tail "$tail" <<<"$snapshot"
}

# Read-only board listing in dashboard lane order: the same SORT_SEP record
# discipline the render rides (lane ordinal, then the lane's sort key, then
# the segment-numeric ID key) with the shared header reader feeding the
# logical fields, so the listing can never drift from the dashboard's row
# source. --json wraps the selected rows in the schema_version 1 envelope;
# the human view prints one tab-separated line per task. --lane filters to
# one dashboard lane, --limit/--offset page the filtered set in sort order
# (limit 0 and offset 0 mean unbounded). Strictly read-only.
cmd_list() {
	local dir="" json=0 lane="" limit=0 offset=0 args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "list: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--json) json=1; shift ;;
			--lane) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "list: --lane requires a value"; lane="$2"; shift 2 ;;
			--lane=*) lane="${1#*=}"; shift ;;
			--limit) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "list: --limit requires a value"; limit="$2"; shift 2 ;;
			--limit=*) limit="${1#*=}"; shift ;;
			--offset) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "list: --offset requires a value"; offset="$2"; shift 2 ;;
			--offset=*) offset="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 0)) || diec "$CODE_USAGE" "list: usage: tasks list [--json] [--lane NAME] [--limit N] [--offset N]"
	[[ "$limit" =~ ^[0-9]+$ ]] || diec "$CODE_USAGE" "list: --limit expects a non-negative integer, got: $limit"
	[[ "$offset" =~ ^[0-9]+$ ]] || diec "$CODE_USAGE" "list: --offset expects a non-negative integer, got: $offset"
	local -A lane_ord=([Triage]=1 [Ready]=2 ["In Progress"]=3 ["Blocked/Cancelled"]=4 [Completed]=5 [Archive]=6)
	[[ -z "$lane" || -n "${lane_ord[$lane]+x}" ]] \
		|| diec "$CODE_USAGE" "list: unknown lane: $lane (valid: Triage, Ready, In Progress, Blocked/Cancelled, Completed, Archive)"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"

	local -a files=()
	board_files "$tasks_dir" files
	if ((${#files[@]} == 0)); then
		((json == 1)) && printf '{"schema_version":%d,"type":"list","total":0,"count":0,"offset":%d,"limit":%d,"tasks":[]}\n' \
			"$SCHEMA_VERSION" "$offset" "$limit"
		((json == 0)) && printf 'no tasks\n'
		return 0
	fi

	local rows_file
	rows_file="$(mktemp "${TMPDIR:-/tmp}/tasks-list.XXXXXX")"
	arm_tmp_cleanup_trap "$rows_file"
	AWK_TASKS_DIR="$tasks_dir" AWK_ID_KEY_WIDTH="$ID_KEY_SEGMENT_WIDTH" \
		AWK_NA="$NA" AWK_DEFAULT_PRIORITY="$DEFAULT_PRIORITY" AWK_UNDATED="$UNDATED_SORT_KEY" \
		AWK_CURRENT_DIR="$CURRENT_DIR" AWK_ARCHIVE_DIR="$ARCHIVE_DIR" \
		AWK_READY="$STATUS_READY" AWK_IN_PROGRESS="$STATUS_IN_PROGRESS" \
		AWK_BLOCKED="$STATUS_BLOCKED" AWK_CANCELLED="$STATUS_CANCELLED" \
		AWK_COMPLETED="$STATUS_COMPLETED" \
		AWK_LIST_JSON="$json" AWK_SCHEMA_VERSION="$SCHEMA_VERSION" \
		awk "$AWK_ROW_HELPERS$AWK_HEADER_FIELDS$AWK_JSON_ESCAPE"'
			function trimws(s) { sub(/[ \t\r]+$/, "", s); return s }
			function emit_row(rel, fb, subdir, ord, lane, sortkey,    nb, id, status, created, claim, sc, obj) {
				id = taskid(fb)
				status = trimws(FLD["Status"])
				created = trimws(FLD["Created"])
				if (created == "") created = trimws(FLD["DecoCreated"])
				if (created == "") created = na
				claim = ""
				while ((getline sc < (td rel ".claim")) > 0) { claim = trimws(sc); break }
				close(td rel ".claim")
				if (jmode) {
					nb = fb; sub(/\.md$/, "", nb)
					obj = "{\"schema_version\":" schema ",\"type\":\"task_row\",\"id\":" jq(id)
					obj = obj ",\"name\":" jq((trimws(FLD["Title"]) == "" ? nb : trimws(FLD["Title"])))
					obj = obj ",\"file\":" jq(rel) ",\"subdir\":" jq(subdir) ",\"lane\":" jq(lane)
					obj = obj ",\"status\":" jq(status)
					obj = obj ",\"priority\":" jq((trimws(FLD["Priority"]) == "" ? dp : trimws(FLD["Priority"])))
					obj = obj ",\"progress\":" jq(trimws(FLD["Progress"]))
					obj = obj ",\"created\":" jq(created)
					obj = obj ",\"updated\":" jq(trimws(FLD["Updated"]))
					obj = obj ",\"completed\":" jq(trimws(FLD["Completed"]))
					obj = obj ",\"duration\":" jq(trimws(FLD["Duration"]))
					obj = obj ",\"owner\":" jq(trimws(FLD["Owner"]))
					obj = obj ",\"claim_owner\":" jq(claim) "}"
				} else {
					obj = id "\t" lane "\t" ((status == "") ? "-" : status) "\t" rel
				}
				print ord sep sortkey sep idkeyof(id) sep obj
			}
			BEGIN {
				sep = "\034"
				td = ENVIRON["AWK_TASKS_DIR"] "/"
				idw = ENVIRON["AWK_ID_KEY_WIDTH"]
				na = ENVIRON["AWK_NA"]; dp = ENVIRON["AWK_DEFAULT_PRIORITY"]
				undated = ENVIRON["AWK_UNDATED"]
				cd = ENVIRON["AWK_CURRENT_DIR"]; ad = ENVIRON["AWK_ARCHIVE_DIR"]
				st_ready = ENVIRON["AWK_READY"]; st_ip = ENVIRON["AWK_IN_PROGRESS"]
				st_blocked = ENVIRON["AWK_BLOCKED"]; st_cancelled = ENVIRON["AWK_CANCELLED"]
				st_completed = ENVIRON["AWK_COMPLETED"]
				jmode = ENVIRON["AWK_LIST_JSON"] == "1"
				schema = ENVIRON["AWK_SCHEMA_VERSION"]
				for (argi = 1; argi < ARGC; argi++) {
					file = ARGV[argi]
					fb = file; sub(/.*\//, "", fb)
					subdir = file; arch = 0
					if (index(subdir, cd "/") == 1) subdir = cd
					else if (index(subdir, ad "/") == 1) { subdir = ad; arch = 1 }
					hdr_reset()
					while ((getline line < (td file)) > 0) {
						if (line ~ /^## /) break
						hdr_feed(line)
					}
					close(td file)
					status = trimws(FLD["Status"])
					completed = trimws(FLD["Completed"])
					created = trimws(FLD["Created"])
					if (created == "") created = trimws(FLD["DecoCreated"])
					if (created == "") created = na
					if (arch) emit_row(file, fb, subdir, 6, "Archive", (completed == "" ? undated : completed))
					else if (status == st_ready) emit_row(file, fb, subdir, 2, "Ready", (created == na ? undated : created))
					else if (status == st_ip) emit_row(file, fb, subdir, 3, "In Progress", (created == na ? undated : created))
					else if (status == st_blocked || status == st_cancelled) emit_row(file, fb, subdir, 4, "Blocked/Cancelled", (created == na ? undated : created))
					else if (status == st_completed) emit_row(file, fb, subdir, 5, "Completed", (completed == "" ? undated : completed))
					else emit_row(file, fb, subdir, 1, "Triage", (created == na ? undated : created))
				}
				exit
			}
		' "${files[@]}" >"$rows_file"
	LC_ALL=C sort -o "$rows_file" "$rows_file"

	local -a selected=()
	local rec ordinal payload total=0
	while IFS= read -r rec; do
		ordinal="${rec%%"$SORT_SEP"*}"
		payload="${rec#*"$SORT_SEP"}"
		payload="${payload#*"$SORT_SEP"}"
		payload="${payload#*"$SORT_SEP"}"
		[[ -z "$lane" || "$ordinal" == "${lane_ord[$lane]}" ]] || continue
		((total += 1))
		((total > offset)) || continue
		((limit == 0 || total <= offset + limit)) || continue
		selected+=("$payload")
	done <"$rows_file"
	trap - EXIT
	rm -f "$rows_file"

	if ((json == 1)); then
		local joined="" p
		for p in "${selected[@]+${selected[@]}}"; do joined+="$p,"; done
		joined="${joined%,}"
		printf '{"schema_version":%d,"type":"list","total":%d,"count":%d,"offset":%d,"limit":%d,"tasks":[%s]}\n' \
			"$SCHEMA_VERSION" "$total" "${#selected[@]}" "$offset" "$limit" "$joined"
	else
		local p
		for p in "${selected[@]+${selected[@]}}"; do printf '%s\n' "$p"; done
	fi
}

# Read-only report index for one task: every deposit under
# reports/<taskfile>/ with its Work Log provenance (the depositing entry's
# stamp, attribution, and digest, matched by the entry's
# **Report:** [name](../reports/...) link; on-disk files no entry links
# carry linked:false and empty provenance). --json wraps the selected
# records in the schema_version 1 envelope; --include-body adds each
# report's complete content (--json only). --limit/--offset page the
# sequence-ordered set. Strictly read-only.
cmd_reports() {
	local dir="" json=0 incbody=0 limit=0 offset=0 args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "reports: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--json) json=1; shift ;;
			--include-body) incbody=1; shift ;;
			--limit) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "reports: --limit requires a value"; limit="$2"; shift 2 ;;
			--limit=*) limit="${1#*=}"; shift ;;
			--offset) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "reports: --offset requires a value"; offset="$2"; shift 2 ;;
			--offset=*) offset="${1#*=}"; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 1)) || diec "$CODE_USAGE" "reports: usage: tasks reports <taskfile> [--json] [--include-body] [--limit N] [--offset N]"
	((incbody == 1 && json == 0)) \
		&& diec "$CODE_USAGE" "reports: --include-body applies to --json only"
	[[ "$limit" =~ ^[0-9]+$ ]] || diec "$CODE_USAGE" "reports: --limit expects a non-negative integer, got: $limit"
	[[ "$offset" =~ ^[0-9]+$ ]] || diec "$CODE_USAGE" "reports: --offset expects a non-negative integer, got: $offset"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"
	local file; file="$(resolve_task_file "$tasks_dir" "${args[0]}")"

	local rel file_r board_r
	file_r="$(readlink -f "$file")"
	board_r="$(readlink -f "$tasks_dir")"
	rel="${file_r#"$board_r"/}"
	local base="${file##*/}"
	local report_dir="$tasks_dir/$REPORTS_DIR/$base"

	# Sequence-ordered report file list (seq extracted from the NN- prefix;
	# files without one sort after, in name order).
	local -a pairs=() rpt_rels=() rpt_paths=()
	local f fb seq
	for f in "$report_dir"/*.md; do
		[[ -e "$f" ]] || continue
		fb="${f##*/}"
		seq=999999
		[[ "$fb" =~ ^([0-9]+)- ]] && seq=$((10#${BASH_REMATCH[1]}))
		pairs+=("$(printf '%d\t%s' "$seq" "$fb")")
	done
	if ((${#pairs[@]} > 0)); then
		local -a sorted_pairs=()
		mapfile -t sorted_pairs < <(printf '%s\n' "${pairs[@]}" | LC_ALL=C sort -t "$(printf '\t')" -k1,1n -k2,2)
		for f in "${sorted_pairs[@]}"; do
			rpt_rels+=("$REPORTS_DIR/$base/${f#*$'\t'}")
			rpt_paths+=("$tasks_dir/$REPORTS_DIR/$base/${f#*$'\t'}")
		done
	fi

	# final-newline map: awk cannot see the file's last byte, so the bash
	# side records it per report path. tail -c 1 of a newline-terminated file
	# is stripped by command substitution, so an empty capture means the file
	# ends with its newline (the normal case) and a non-empty capture means
	# the last byte is content.
	local map_file
	map_file="$(mktemp "${TMPDIR:-/tmp}/tasks-reports.XXXXXX")"
	{
		local i
		for ((i = 0; i < ${#rpt_paths[@]}; i++)); do
			fnl=0
			[[ -s "${rpt_paths[$i]}" ]] && { path="$(tail -c 1 "${rpt_paths[$i]}" 2>/dev/null || true)"; [[ -z "$path" ]] && fnl=1; }
			printf '%s\t%d\n' "${rpt_rels[$i]}" "$fnl"
		done
	} >"$map_file"
	arm_tmp_cleanup_trap "$map_file"

	local -a recs=()
	if ((${#rpt_paths[@]} > 0)); then
		mapfile -t recs < <(AWK_TASKS_DIR="$tasks_dir" AWK_TASK_FILE="$file" AWK_MAP_FILE="$map_file" \
			AWK_ID_KEY_WIDTH="$ID_KEY_SEGMENT_WIDTH" \
			AWK_LIST_JSON="$json" AWK_INC_BODY="$incbody" AWK_SCHEMA_VERSION="$SCHEMA_VERSION" \
			awk "$AWK_HEADING_LEVEL$AWK_ROW_HELPERS$AWK_HEADER_FIELDS$AWK_JSON_ESCAPE"'
				function trimws(s) { sub(/[ \t\r]+$/, "", s); return s }
				function rel_of(path) { return (index(path, td) == 1) ? substr(path, length(td) + 1) : path }
				function emit_report(rel,    fb, sq, linked, obj) {
					fb = rel; sub(/.*\//, "", fb)
					sq = 0
					if (match(fb, /^[0-9]+/)) sq = substr(fb, RSTART, RLENGTH) + 0
					linked = (fb in PRV_SEEN) ? 1 : 0
					if (jmode) {
						obj = "{\"schema_version\":" schema ",\"type\":\"report_record\",\"seq\":" sq
						obj = obj ",\"name\":" jq(fb) ",\"file\":" jq(rel)
						obj = obj ",\"linked\":" ((linked) ? "true" : "false")
						obj = obj ",\"stamp\":" jq((linked ? PRV_STAMP[fb] : ""))
						obj = obj ",\"from\":" jq((linked ? PRV_FROM[fb] : ""))
						obj = obj ",\"digest\":" jq((linked ? PRV_DIGEST[fb] : ""))
						obj = obj ",\"final_newline\":" ((FNL[rel] == "1") ? "true" : "false")
						if (incbody) obj = obj ",\"body\":" jq(content)
						obj = obj "}"
					} else {
						obj = fb "\t" (((linked) && PRV_DIGEST[fb] != "") ? PRV_DIGEST[fb] : "-")
					}
					print sq sep obj
				}
				BEGIN {
					sep = "\034"
					td = ENVIRON["AWK_TASKS_DIR"] "/"
					idw = ENVIRON["AWK_ID_KEY_WIDTH"]
					tf = ENVIRON["AWK_TASK_FILE"]
					jmode = ENVIRON["AWK_LIST_JSON"] == "1"
					incbody = ENVIRON["AWK_INC_BODY"] == "1"
					schema = ENVIRON["AWK_SCHEMA_VERSION"]
					mapfile = ARGV[1]; taskfile = ARGV[2]
					while ((getline ml < mapfile) > 0) {
						split(ml, mp, "\t"); FNL[mp[1]] = mp[2]
					}
					close(mapfile)
					cur_stamp = ""; cur_from = ""; pending_base = ""
					while ((getline line < taskfile) > 0) {
						if (heading_level(line) == 2) {
							inwl = (HTEXT == "Work Log")
							if (inwl) { cur_stamp = ""; cur_from = ""; pending_base = "" }
							continue
						}
						if (!inwl) continue
						if (line ~ /^### /) {
							cur_stamp = ""; cur_from = ""; pending_base = ""
							h = substr(line, 5)
							if (match(h, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]/)) {
								cur_stamp = substr(h, 1, 16)
								rest = (substr(h, 17, 2) == ": ") ? substr(h, 19) : ""
								cur_from = rest; sub(/: .*$/, "", cur_from)
							}
						} else if (match(line, /^\*\*Report:\*\* \[/)) {
							rest = substr(line, RSTART + RLENGTH)
							name = rest; sub(/\]\(.*/, "", name)
							target = substr(rest, length(name) + 3)
							sub(/\).*/, "", target)
							base = target; sub(/.*\//, "", base)
							PRV_SEEN[base] = 1
							PRV_STAMP[base] = cur_stamp; PRV_FROM[base] = cur_from
							pending_base = base
						} else if (match(line, /^\*\*Digest:\*\*/)) {
							dg = substr(line, RSTART + RLENGTH)
							sub(/^[ \t]*/, "", dg)
							if (pending_base != "") PRV_DIGEST[pending_base] = dg
						}
					}
					close(taskfile)
					for (argi = 3; argi < ARGC; argi++) {
						rpath = ARGV[argi]
						content = ""
						while ((getline rline < rpath) > 0) content = content (content == "" ? "" : "\n") rline
						close(rpath)
						emit_report(rel_of(rpath))
					}
					exit
				}
			' "$map_file" "$file" "${rpt_paths[@]}")
	fi
	trap - EXIT
	rm -f "$map_file"

	local -a selected=()
	local rec sq payload total=0
	for rec in "${recs[@]+${recs[@]}}"; do
		sq="${rec%%"$SORT_SEP"*}"
		payload="${rec#*"$SORT_SEP"}"
		((total += 1))
		((total > offset)) || continue
		((limit == 0 || total <= offset + limit)) || continue
		selected+=("$payload")
	done
	if ((json == 1)); then
		local joined="" p
		for p in "${selected[@]+${selected[@]}}"; do joined+="$p,"; done
		joined="${joined%,}"
		printf '{"schema_version":%d,"type":"reports","file":%s,"id":%s,"total":%d,"count":%d,"offset":%d,"limit":%d,"reports":[%s]}\n' \
			"$SCHEMA_VERSION" "$(jqstr_bash "$rel")" "$(jqstr_bash "$(task_id_of_basename "$base")")" \
			"$total" "${#selected[@]}" "$offset" "$limit" "$joined"
	else
		local p
		for p in "${selected[@]+${selected[@]}}"; do printf '%s\n' "$p"; done
	fi
}

# Bash-side JSON string escaper for the envelope fields the commands build
# outside awk (task file path, Task ID, doctor record fields): it runs the
# same AWK_JSON_ESCAPE fragment every awk-side emitter uses, so the CLI has
# one escaping implementation and a bash-side reduced copy cannot drift
# from it (the previous copy escaped only backslash and quote, so a
# control character in a filename would have emitted invalid JSON).
jqstr_bash() {
	AWK_JSON_VALUE="$1" awk "$AWK_JSON_ESCAPE"'BEGIN { printf "%s", jq(ENVIRON["AWK_JSON_VALUE"]) }'
}

# Lossless JSONL export: one schema_version 1 record per exported file with
# its board-relative path, Task ID, complete raw content (JSON-escaped),
# and a final_newline flag (the one byte awk cannot see), so concatenating
# content plus the flag reconstructs every file byte-exactly. Task files
# from current/ and archive/ export by default; --include-reports adds the
# reports tree; the derived dashboard and the transient lock and claim
# sidecars are not board content and never export. --format jsonl is the
# only format today and the default. Strictly read-only.
cmd_export() {
	local dir="" format="jsonl" include_reports=0 args=()
	while (($#)); do
		case "$1" in
			--dir) [[ $# -ge 2 && "$2" != --* ]] || die "export: --dir requires a value"; dir="$2"; shift 2 ;;
			--dir=*) dir="${1#*=}"; shift ;;
			--format) [[ $# -ge 2 && "$2" != --* ]] || diec "$CODE_USAGE" "export: --format requires a value"; format="$2"; shift 2 ;;
			--format=*) format="${1#*=}"; shift ;;
			--include-reports) include_reports=1; shift ;;
			*) args+=("$1"); shift ;;
		esac
	done
	((${#args[@]} == 0)) || diec "$CODE_USAGE" "export: usage: tasks export [--format jsonl] [--include-reports]"
	[[ "$format" == "jsonl" ]] || diec "$CODE_USAGE" "export: unsupported format: $format (supported: jsonl)"

	local tasks_dir; resolve_tasks_dir "$dir"; tasks_dir="$RESOLVED_TASKS_DIR"
	warn_fallback_tasks_dir "$tasks_dir"
	require_tasks_dir "$tasks_dir"

	local -a files=() all_rels=() all_paths=()
	local f rel base
	board_files "$tasks_dir" files
	for f in "${files[@]+${files[@]}}"; do
		all_rels+=("$f")
		all_paths+=("$tasks_dir/$f")
	done
	if ((include_reports == 1)); then
		for f in "$tasks_dir/$REPORTS_DIR"/*/*.md; do
			[[ -e "$f" ]] || continue
			rel="${f#"$tasks_dir"/}"
			all_rels+=("$rel")
			all_paths+=("$f")
		done
	fi
	((${#all_rels[@]} > 0)) || return 0

	local map_file
	map_file="$(mktemp "${TMPDIR:-/tmp}/tasks-export.XXXXXX")"
	{
		local i fnl lastbyte
		for ((i = 0; i < ${#all_paths[@]}; i++)); do
			fnl=0
			[[ -s "${all_paths[$i]}" ]] && { lastbyte="$(tail -c 1 "${all_paths[$i]}" 2>/dev/null || true)"; [[ -z "$lastbyte" ]] && fnl=1; }
			printf '%s\t%d\n' "${all_rels[$i]}" "$fnl"
		done
	} >"$map_file"
	arm_tmp_cleanup_trap "$map_file"

	AWK_TASKS_DIR="$tasks_dir" AWK_ID_KEY_WIDTH="$ID_KEY_SEGMENT_WIDTH" \
		AWK_CURRENT_DIR="$CURRENT_DIR" AWK_ARCHIVE_DIR="$ARCHIVE_DIR" \
		AWK_REPORTS_DIR="$REPORTS_DIR" AWK_MAP_FILE="$map_file" \
		AWK_SCHEMA_VERSION="$SCHEMA_VERSION" \
		awk "$AWK_ROW_HELPERS$AWK_HEADER_FIELDS$AWK_JSON_ESCAPE"'
			function rel_of(path) { return (index(path, td) == 1) ? substr(path, length(td) + 1) : path }
			function type_of(rel) {
				if (index(rel, cd "/") == 1 || index(rel, ad "/") == 1) return "task"
				return "report"
			}
			function emit_record(rel, content,    fb, typ, id, ddir, obj) {
				typ = type_of(rel)
				fb = rel; sub(/.*\//, "", fb)
				id = ""
				if (typ == "task") {
					id = taskid(fb)
				} else {
					ddir = rel; sub("/" fb "$", "", ddir)
					fb = ddir; sub(/.*\//, "", fb)
					id = taskid(fb)
				}
				obj = "{\"schema_version\":" schema ",\"type\":\"" typ "\",\"file\":" jq(rel) ",\"id\":" jq(id)
				if (typ == "report") obj = obj ",\"dir\":" jq(ddir)
				obj = obj ",\"content\":" jq(content)
				obj = obj ",\"final_newline\":" ((FNL[rel] == "1") ? "true" : "false") "}"
				print obj
			}
			BEGIN {
				td = ENVIRON["AWK_TASKS_DIR"] "/"
				cd = ENVIRON["AWK_CURRENT_DIR"]; ad = ENVIRON["AWK_ARCHIVE_DIR"]
				schema = ENVIRON["AWK_SCHEMA_VERSION"]
				mapfile = ARGV[1]
				while ((getline ml < mapfile) > 0) {
					split(ml, mp, "\t"); FNL[mp[1]] = mp[2]
				}
				close(mapfile)
				for (argi = 2; argi < ARGC; argi++) {
					path = ARGV[argi]
					rel = rel_of(path)
					content = ""
					while ((getline line < path) > 0) content = content (content == "" ? "" : "\n") line
					close(path)
					emit_record(rel, content)
				}
				exit
			}
		' "$map_file" "${all_paths[@]}"
	trap - EXIT
	rm -f "$map_file"
}

main() {
	(($#)) || { usage; exit 2; }
	local cmd="$1"; shift
	case "$cmd" in
		init) cmd_init "$@" ;;
		render) cmd_render "$@" ;;
		new) cmd_new "$@" ;;
		set) cmd_set "$@" ;;
		claim) cmd_claim "$@" ;;
		release) cmd_release "$@" ;;
		archive) cmd_archive "$@" ;;
		close) cmd_close "$@" ;;
		stamp) cmd_stamp "$@" ;;
		report) cmd_report "$@" ;;
		log) cmd_log "$@" ;;
		edit) cmd_edit "$@" ;;
		lint) cmd_lint "$@" ;;
		doctor) cmd_doctor "$@" ;;
		frontier) cmd_frontier "$@" ;;
		show) cmd_show "$@" ;;
		list) cmd_list "$@" ;;
		reports) cmd_reports "$@" ;;
		export) cmd_export "$@" ;;
		help | -h | --help) usage ;;
		*) err "unknown command: $cmd"; usage; exit 2 ;;
	esac
}

main "$@"
