{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "thoai-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ThOAI Local GPU Server",
      "options": {
        "baseURL": "http://thoai-op:8080/v1"
      },
      "models": {
        "Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M": {
          "name": "Qwen2.5 Coder 7B (RTX 3050)",
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/rules/core.md",
    "~/.config/opencode/rules/coding-standards.md",
    "~/.config/opencode/rules/execution-standards.md",
    "~/.config/opencode/rules/qhaway-memory.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "qhaway": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.14",
        "--from",
        "qhaway==0.7.3",
        "qhaway",
        "serve",
        "--dir",
        "/home/khave/.config/opencode/qhaway-memory"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "doom_loop": "allow"
  },
  "experimental": {
    "subagent_depth": 2
  }
}
