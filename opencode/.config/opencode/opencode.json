{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "thoai-local": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "ThOAI Local GPU Server",
      "settings": {
        "baseURL": "http://thoai-op:8080/v1"
      },
      "models": {
        "Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M": {
          "name": "Qwen2.5 Coder 7B (RTX 3050)",
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/rules/core.md",
    "~/.config/opencode/rules/coding-standards.md",
    "~/.config/opencode/rules/execution-standards.md",
    "~/.config/opencode/rules/qhaway-memory.md"
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp"
        ],
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "qhaway": {
        "type": "local",
        "command": [
          "uvx",
          "--python",
          "3.14",
          "--from",
          "qhaway==0.7.3",
          "qhaway",
          "serve",
          "--dir",
          "/home/khave/.config/opencode/qhaway-memory"
        ],
        "disabled": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ],
  "experimental": {
    "todo": true,
    "subagent_depth": 2
  }
}
